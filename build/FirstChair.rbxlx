      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService — loads and saves player progress with DataStoreService.

	Fails gracefully: if Roblox's DataStores are unavailable (e.g. Studio without
	API access, or an outage) the player can still play; progress simply isn't
	saved, and we never overwrite good saved data with a blank profile.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local STORE_NAME = "FirstChair_Progress_v1"
local MAX_RETRIES = 3
local AUTOSAVE_SECONDS = 120
local MAX_SEEN_KEYS = 400

export type Best = { score: number, maxScore: number, grade: string, percent: number }
export type Data = {
	version: number,
	best: { [string]: Best },
	seen: { [string]: boolean },
	plays: number,
	wins: number,
	bonus: number, -- promotion points from daily bonuses
	streak: number, -- consecutive days with a win
	lastDaily: number, -- day index (os.time() / 86400) of the last daily bonus
}

type Profile = {
	data: Data,
	loaded: boolean,
	canSave: boolean,
	dirty: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[FirstChair] DataStore unavailable — progress will not save this session:", storeError)
	end
end

local function defaultData(): Data
	return { version = 1, best = {}, seen = {}, plays = 0, wins = 0, bonus = 0, streak = 0, lastDaily = 0 }
end

-- Never trust stored data blindly: rebuild a clean table from known fields.
local function sanitize(raw: any): Data
	local data = defaultData()
	if type(raw) ~= "table" then
		return data
	end
	if type(raw.best) == "table" then
		for caseId, best in raw.best do
			if
				type(caseId) == "string"
				and type(best) == "table"
				and type(best.score) == "number"
				and type(best.grade) == "string"
			then
				data.best[caseId] = {
					score = best.score,
					maxScore = if type(best.maxScore) == "number" then best.maxScore else best.score,
					grade = best.grade,
					percent = if type(best.percent) == "number" then best.percent else 0,
				}
			end
		end
	end
	if type(raw.seen) == "table" then
		local count = 0
		for key, value in raw.seen do
			if type(key) == "string" and value == true and count < MAX_SEEN_KEYS then
				data.seen[key] = true
				count += 1
			end
		end
	end
	for _, key in { "plays", "wins", "bonus", "streak", "lastDaily" } do
		if type(raw[key]) == "number" then
			data[key] = raw[key]
		end
	end
	return data
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T | string)
	local lastErr: any = nil
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		local message = tostring(result)
		if string.find(message, "StudioAccessToApisNotAllowed") or string.find(message, "403") then
			-- Studio without API access: retrying won't help.
			break
		end
		warn(
			("[FirstChair] %s failed (attempt %d/%d): %s"):format(
				label,
				attempt,
				MAX_RETRIES,
				tostring(result)
			)
		)
		task.wait(attempt * 1.5)
	end
	return false, tostring(lastErr)
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

function DataService.load(player: Player): Profile
	local profile: Profile = { data = defaultData(), loaded = false, canSave = false, dirty = false }
	profiles[player] = profile

	if not store then
		profile.loaded = true
		return profile
	end

	local ok, result = withRetries("Load " .. player.Name, function()
		return (store :: DataStore):GetAsync(keyFor(player))
	end)

	if ok then
		profile.data = sanitize(result)
		profile.canSave = true
	else
		-- Load failed: play on with a blank profile but DON'T save over real data.
		profile.canSave = false
	end
	profile.loaded = true
	return profile
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

function DataService.waitFor(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 15)
	while os.clock() < deadline do
		local profile = profiles[player]
		if profile and profile.loaded then
			return profile
		end
		if not player.Parent then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.isSaving(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

function DataService.markDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
	end
end

function DataService.save(player: Player): boolean
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	local snapshot = table.clone(profile.data)
	local ok = withRetries("Save " .. player.Name, function()
		return (store :: DataStore):UpdateAsync(keyFor(player), function(old)
			-- Merge: keep the better grade per case so a stale server can't regress progress.
			local merged = sanitize(snapshot)
			local previous = sanitize(old)
			for caseId, best in previous.best do
				local mine = merged.best[caseId]
				if not mine or best.score > mine.score then
					merged.best[caseId] = best
				end
			end
			for key in previous.seen do
				merged.seen[key] = true
			end
			for _, key in { "plays", "wins", "bonus", "streak", "lastDaily" } do
				merged[key] = math.max(merged[key], previous[key])
			end
			return merged
		end)
	end)
	if ok then
		profile.dirty = false
	end
	return ok
end

function DataService.release(player: Player)
	local profile = profiles[player]
	if profile and profile.dirty then
		DataService.save(player)
	end
	profiles[player] = nil
end

function DataService.start()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for player, profile in profiles do
			if profile.dirty then
				pending += 1
				task.spawn(function()
					DataService.save(player)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, profile in profiles do
				if profile.dirty and profile.canSave then
					task.spawn(DataService.save, player)
				end
			end
		end
	end)
end

DataService.storeAvailable = function(): boolean
	return store ~= nil
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">LobbyService</string>
          <string name="Source"><![CDATA[--[[
	LobbyService — everything social: leaderstats and career titles over heads, the
	Top Associates leaderboard (OrderedDataStore + the board in the lobby), badges,
	and the server-wide "X just won a case" announcements.
	Every external call is wrapped so an outage never breaks the game.
]]

local BadgeService = game:GetService("BadgeService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local CaseCatalog = require(Shared.CaseCatalog)

local LobbyService = {}

local LEADERBOARD_STORE = "FirstChair_Points_v1"

local orderedStore: OrderedDataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(LEADERBOARD_STORE)
	end)
	if ok then
		orderedStore = result
	else
		warn("[FirstChair] Leaderboard store unavailable:", result)
	end
end

local nameCache: { [number]: string } = {}
local board: { { name: string, points: number, userId: number } } = {}

----------------------------------------------------------------- leaderstats + attributes
function LobbyService.setupPlayer(player: Player, summary)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local title = Instance.new("StringValue")
		title.Name = "Title"
		title.Parent = stats
		local points = Instance.new("IntValue")
		points.Name = "Points"
		points.Parent = stats
		stats.Parent = player
	end
	LobbyService.refreshPlayer(player, summary)
	nameCache[player.UserId] = player.DisplayName
end

function LobbyService.refreshPlayer(player: Player, summary)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Title") :: StringValue).Value = summary.title;
		(stats:FindFirstChild("Points") :: IntValue).Value = summary.points
	end
	-- Attributes replicate to every client: nametags read these.
	player:SetAttribute("Title", summary.title)
	player:SetAttribute("Points", summary.points)
	player:SetAttribute("Streak", summary.streak or 0)
end

----------------------------------------------------------------- leaderboard
local function nameFor(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = if ok then name else "Associate"
	nameCache[userId] = resolved
	return resolved
end

local function renderBoard()
	local world = workspace:FindFirstChild("FirstChairWorld")
	local part = world and world:FindFirstChild("LeaderboardBoard", true)
	local gui = part and part:FindFirstChildOfClass("SurfaceGui")
	local list = gui and gui:FindFirstChild("List") :: TextLabel?
	if not list then
		return
	end
	if #board == 0 then
		list.Text = "Win a case to make the board."
		return
	end
	local lines = {}
	for i, entry in board do
		table.insert(lines, ("%d.  %s   —   %d pts"):format(i, entry.name, entry.points))
	end
	list.Text = table.concat(lines, "\n")
end

function LobbyService.refreshBoard()
	if not orderedStore then
		return
	end
	local ok, pages = pcall(function()
		return (orderedStore :: OrderedDataStore):GetSortedAsync(false, Config.LeaderboardSize)
	end)
	if not ok then
		warn("[FirstChair] Leaderboard read failed:", pages)
		return
	end
	local fresh = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(string.match(item.key, "%d+"))
		if userId then
			table.insert(fresh, { userId = userId, name = nameFor(userId), points = item.value })
		end
	end
	board = fresh
	renderBoard()
	Net.event("Leaderboard"):FireAllClients(board)
end

function LobbyService.recordPoints(player: Player, points: number)
	if not orderedStore or points <= 0 then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			(orderedStore :: OrderedDataStore):SetAsync("player_" .. player.UserId, points)
		end)
		if not ok then
			warn("[FirstChair] Leaderboard write failed:", err)
		end
	end)
end

----------------------------------------------------------------- badges + announcements
function LobbyService.awardBadge(player: Player, key: string)
	local id = Config.Badges[key]
	if not id or id == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, id) then
				BadgeService:AwardBadge(player.UserId, id)
			end
		end)
	end)
end

function LobbyService.broadcast(text: string, kind: string?)
	Net.event("Broadcast"):FireAllClients({ text = text, kind = kind or "info" })
end

-- Called by CaseService when a case is completed.
function LobbyService.onCaseWon(player: Player, caseId: string, outcome, summary)
	LobbyService.refreshPlayer(player, summary)
	LobbyService.recordPoints(player, summary.points)

	if caseId == "case1" then
		LobbyService.awardBadge(player, "firstVerdict")
	end
	if outcome.grade == "S" then
		LobbyService.awardBadge(player, "cleanSweep")
	end
	local all = true
	for _, id in CaseCatalog.order do
		if not summary.cases[id].best then
			all = false
		end
	end
	if all then
		LobbyService.awardBadge(player, "firstChair")
	end

	if Config.BroadcastVerdicts then
		local info = CaseCatalog.get(caseId)
		LobbyService.broadcast(
			("%s just won %s  ·  Grade %s"):format(
				player.DisplayName,
				info and info.title or caseId,
				outcome.grade
			),
			"success"
		)
	end
end

function LobbyService.start()
	Net.event("Leaderboard") -- ensure it exists
	Players.PlayerAdded:Connect(function(player)
		task.delay(2, function()
			if player.Parent and #board > 0 then
				Net.event("Leaderboard"):FireClient(player, board)
			end
		end)
	end)
	task.spawn(function()
		while true do
			LobbyService.refreshBoard()
			task.wait(Config.LeaderboardRefreshSeconds)
		end
	end)
end

return LobbyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World — builds the whole environment at server start.
	Everything is generated from code (no external asset packs) and kept lean
	for phones and iPads: ~1,000 anchored parts, a dozen non-shadow lights.
]]

local Lighting = game:GetService("Lighting")

local Palette = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Palette)
local Builder = require(script.Builder)
local Office = require(script.Office)
local Courtroom = require(script.Courtroom)

local World = {}

-- Bump when the builders change so stale baked worlds are rebuilt at runtime.
World.VERSION = 1

local function skyline(root: Instance)
	-- Northbridge at golden hour, seen through the office's back windows.
	local folder = Builder.folder(root, "Skyline")
	local towers = {
		{ -110, 60, 24, 130 },
		{ -78, 92, 18, 170 },
		{ -50, 70, 26, 110 },
		{ -20, 110, 20, 190 },
		{ 8, 80, 30, 140 },
		{ 40, 120, 22, 210 },
		{ 70, 75, 26, 120 },
		{ 100, 95, 20, 165 },
		{ -95, 150, 30, 150 },
		{ -35, 160, 34, 200 },
		{ 25, 170, 28, 175 },
		{ 85, 155, 30, 140 },
	}
	for i, t in towers do
		local x, z, w, h = t[1], -t[2], t[3], t[4]
		local tone = if i % 3 == 0 then Palette.Stone elseif i % 3 == 1 then Palette.NavySoft else Palette.Navy
		local bottom = -120
		Builder.trim(
			folder,
			Vector3.new(w, h, w),
			CFrame.new(x, bottom + h / 2, z),
			tone,
			Enum.Material.Concrete
		)
		-- a couple of lit window bands per tower (cheap neon strips)
		for band = 1, 2 do
			Builder.glow(
				folder,
				Vector3.new(w * 0.8, 0.8, 0.2),
				CFrame.new(x, bottom + h - band * 9, z + w / 2 + 0.11),
				Palette.WarmLight
			)
		end
		Builder.trim(
			folder,
			Vector3.new(w + 1, 2, w + 1),
			CFrame.new(x, bottom + h + 1, z),
			Palette.BrassDark,
			Enum.Material.Metal
		)
	end
end

local function atmosphere()
	local function ensure(className: string, name: string): Instance
		local existing = Lighting:FindFirstChild(name)
		if existing then
			return existing
		end
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
		return inst
	end

	local atmo = ensure("Atmosphere", "FirstChairAtmosphere") :: Atmosphere
	atmo.Density = 0.32
	atmo.Offset = 0.15
	atmo.Color = Color3.fromRGB(214, 190, 160)
	atmo.Decay = Color3.fromRGB(120, 100, 90)
	atmo.Glare = 0.2
	atmo.Haze = 1.4

	local grade = ensure("ColorCorrectionEffect", "FirstChairGrade") :: ColorCorrectionEffect
	grade.Brightness = 0.02
	grade.Contrast = 0.08
	grade.Saturation = -0.06
	grade.TintColor = Color3.fromRGB(255, 246, 234)

	local bloom = ensure("BloomEffect", "FirstChairBloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 22
	bloom.Threshold = 1.6

	-- Runtime-safe lighting values (Technology is set in default.project.json).
	Lighting.Ambient = Color3.fromRGB(92, 80, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 128, 118)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 16.6
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.4
end

function World.build()
	local existing = workspace:FindFirstChild("FirstChairWorld")
	if existing and existing:GetAttribute("Baked") == World.VERSION then
		-- Already baked into the place file by scripts/bake.luau: just set the mood.
		atmosphere()
		print("[FirstChair] Using baked world")
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "FirstChairWorld"

	Builder.partCount = 0
	Office.build(root)
	Courtroom.build(root)
	skyline(root)
	atmosphere()

	root.Parent = workspace
	print(("[FirstChair] World built: %d parts"):format(Builder.partCount))
	return root
end

return World
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--[[
	Builder — small helpers for building tidy, efficient architecture from parts.

	Rules that keep the world cheap on mobile:
	  * everything is Anchored
	  * decorative parts don't collide, touch or cast shadows
	  * only a handful of real lights, all without shadows
]]

local Palette = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Palette)

local Builder = {}

Builder.Palette = Palette
Builder.partCount = 0

export type Opts = {
	material: Enum.Material?,
	collide: boolean?,
	shadow: boolean?,
	transparency: number?,
	reflectance: number?,
	shape: Enum.PartType?,
	name: string?,
}

local M = Enum.Material

function Builder.part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): Part
	local o: Opts = opts or {}
	local p = Instance.new("Part")
	p.Name = o.name or "Part"
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = o.material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = o.collide == true
	p.CanTouch = false
	p.CanQuery = o.collide == true
	p.CastShadow = o.shadow == true
	p.Transparency = o.transparency or 0
	p.Reflectance = o.reflectance or 0
	if o.shape then
		p.Shape = o.shape
	end
	p.Parent = parent
	Builder.partCount += 1
	return p
end

-- Solid architecture (floors, walls): collides and casts shadows.
function Builder.solid(
	parent: Instance,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	return Builder.part(parent, size, cf, color, { material = material, collide = true, shadow = true })
end

-- Decorative detail: no collision, no shadow.
function Builder.trim(
	parent: Instance,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	return Builder.part(parent, size, cf, color, { material = material })
end

function Builder.cylinder(
	parent: Instance,
	length: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	-- Roblox cylinders run along the part's X axis; callers pass cf already oriented.
	return Builder.part(parent, Vector3.new(length, diameter, diameter), cf, color, {
		material = material,
		shape = Enum.PartType.Cylinder,
	})
end

-- Vertical cylinder standing on `base` (a floor-level position).
function Builder.post(
	parent: Instance,
	height: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	return Builder.cylinder(
		parent,
		height,
		diameter,
		cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
end

function Builder.ball(
	parent: Instance,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	return Builder.part(parent, Vector3.new(diameter, diameter, diameter), cf, color, {
		material = material,
		shape = Enum.PartType.Ball,
	})
end

function Builder.glass(parent: Instance, size: Vector3, cf: CFrame): Part
	return Builder.part(parent, size, cf, Palette.Glass, {
		material = M.Glass,
		transparency = 0.72,
		reflectance = 0.08,
		collide = true,
	})
end

-- A glowing strip (fake light fixture — costs nothing).
function Builder.glow(parent: Instance, size: Vector3, cf: CFrame, color: Color3?): Part
	return Builder.part(parent, size, cf, color or Palette.WarmLight, { material = M.Neon })
end

function Builder.light(
	parent: BasePart,
	kind: "Point" | "Surface" | "Spot",
	brightness: number,
	range: number,
	color: Color3?,
	face: Enum.NormalId?
)
	local light: Light
	if kind == "Surface" then
		local s = Instance.new("SurfaceLight")
		s.Face = face or Enum.NormalId.Bottom
		s.Angle = 110
		light = s
	elseif kind == "Spot" then
		local s = Instance.new("SpotLight")
		s.Face = face or Enum.NormalId.Bottom
		s.Angle = 70
		light = s
	else
		light = Instance.new("PointLight")
	end
	light.Brightness = brightness
	light.Color = color or Palette.WarmLight
	light.Shadows = false;
	(light :: any).Range = range
	light.Parent = parent
	return light
end

-- Text painted onto a face of a part (signage, plaques, case boards).
function Builder.label(
	parent: BasePart,
	face: Enum.NormalId,
	text: string,
	opts: {
		font: Font?,
		color: Color3?,
		ppu: number?,
		size: number?,
		bold: boolean?,
		align: Enum.TextXAlignment?,
	}?
): SurfaceGui
	local o = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.ppu or 40
	gui.LightInfluence = 0.6
	gui.MaxDistance = 140
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = o.color or Palette.Brass
	label.FontFace = o.font
		or Font.new(
			"rbxasset://fonts/families/Merriweather.json",
			if o.bold then Enum.FontWeight.Bold else Enum.FontWeight.Regular
		)
	label.TextScaled = o.size == nil
	if o.size then
		label.TextSize = o.size
	end
	label.TextWrapped = true
	label.TextXAlignment = o.align or Enum.TextXAlignment.Center
	label.Parent = gui
	return gui
end

function Builder.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

--[[ Reusable furniture ]]

-- A simple, elegant chair. `cf` is floor-level, facing the seat's front.
function Builder.chair(parent: Instance, cf: CFrame, upholstery: Color3?, wood: Color3?)
	local w = wood or Palette.Espresso
	local u = upholstery or Palette.Leather
	Builder.trim(parent, Vector3.new(2, 0.5, 2), cf * CFrame.new(0, 1.7, 0), u, M.Leather)
	Builder.trim(parent, Vector3.new(2, 2.2, 0.35), cf * CFrame.new(0, 3.0, 0.85), u, M.Leather)
	for _, x in { -0.8, 0.8 } do
		for _, z in { -0.8, 0.8 } do
			Builder.trim(parent, Vector3.new(0.22, 1.5, 0.22), cf * CFrame.new(x, 0.75, z), w, M.Wood)
		end
	end
end

-- Rectangular table with a contrasting top and inset legs.
function Builder.table(
	parent: Instance,
	cf: CFrame,
	size: Vector3,
	top: Color3?,
	legs: Color3?,
	topMaterial: Enum.Material?
)
	local h = size.Y
	Builder.solid(
		parent,
		Vector3.new(size.X, 0.35, size.Z),
		cf * CFrame.new(0, h - 0.175, 0),
		top or Palette.Walnut,
		topMaterial or M.Wood
	)
	Builder.trim(
		parent,
		Vector3.new(size.X - 0.6, 0.45, size.Z - 0.6),
		cf * CFrame.new(0, h - 0.55, 0),
		legs or Palette.Espresso,
		M.Wood
	)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Builder.trim(
				parent,
				Vector3.new(0.4, h - 0.35, 0.4),
				cf * CFrame.new(x * (size.X / 2 - 0.6), (h - 0.35) / 2, z * (size.Z / 2 - 0.6)),
				legs or Palette.Espresso,
				M.Wood
			)
		end
	end
end

-- Potted plant: brass-rimmed planter with a layered canopy.
function Builder.plant(parent: Instance, cf: CFrame, scale: number?)
	local s = scale or 1
	Builder.post(parent, 2.2 * s, 2.2 * s, cf, Palette.Espresso, M.Slate)
	Builder.post(parent, 0.15, 2.35 * s, cf * CFrame.new(0, 2.2 * s, 0), Palette.Brass, M.Metal)
	Builder.ball(parent, 2.8 * s, cf * CFrame.new(0, 3.6 * s, 0), Palette.Leaf, M.Grass)
	Builder.ball(parent, 2.1 * s, cf * CFrame.new(0.6 * s, 4.7 * s, 0.3 * s), Palette.Sage, M.Grass)
	Builder.ball(parent, 1.7 * s, cf * CFrame.new(-0.6 * s, 4.9 * s, -0.4 * s), Palette.Leaf, M.Grass)
end

-- Brass wall sconce with a soft glow and a cheap point light.
function Builder.sconce(parent: Instance, cf: CFrame, withLight: boolean?)
	Builder.trim(parent, Vector3.new(0.6, 1.2, 0.2), cf, Palette.Brass, M.Metal)
	local shade = Builder.trim(
		parent,
		Vector3.new(0.9, 0.8, 0.7),
		cf * CFrame.new(0, 0.6, -0.4),
		Palette.Cream,
		M.Fabric
	)
	if withLight then
		Builder.light(shade, "Point", 0.8, 12, Palette.WarmLight)
	end
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Cast</string>
            <string name="Source"><![CDATA[--[[
	Cast — builds one template model per character into ReplicatedStorage.
	Clients clone these locally, so every player gets a private "stage" and
	two players in different cases never see each other's actors.

	Characters are standard R15 rigs (from a HumanoidDescription) with body colours
	as clothing, plus a few welded parts for hair, collar and tie. No asset IDs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Characters = require(ReplicatedStorage:WaitForChild("Shared").Characters)

local Cast = {}

Cast.FOLDER = "FirstChairCast"

local function weld(part: BasePart, to: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
end

local function accessoryPart(
	model: Model,
	attachTo: BasePart,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	mesh: boolean?
)
	local p = Instance.new("Part")
	p.Name = "Detail"
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = attachTo.CFrame * offset
	if mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = model
	weld(p, attachTo)
	return p
end

local function addHair(model: Model, head: BasePart, style: string, color: Color3)
	if style == "none" then
		return
	end
	local s = head.Size
	-- head front is -Z
	if style == "crop" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.06, s.Y * 0.42, s.Z * 1.08),
			CFrame.new(0, s.Y * 0.34, 0.03),
			color,
			true
		)
	elseif style == "short" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.1, s.Y * 0.55, s.Z * 1.12),
			CFrame.new(0, s.Y * 0.3, 0.05),
			color,
			true
		)
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.04, s.Y * 0.5, s.Z * 0.4),
			CFrame.new(0, s.Y * 0.05, s.Z * 0.38),
			color,
			true
		)
	elseif style == "slick" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.08, s.Y * 0.5, s.Z * 1.15),
			CFrame.new(0, s.Y * 0.33, 0.1) * CFrame.Angles(math.rad(-6), 0, 0),
			color,
			true
		)
	elseif style == "bob" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.14, s.Y * 0.6, s.Z * 1.14),
			CFrame.new(0, s.Y * 0.28, 0.04),
			color,
			true
		)
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.2, s.Y * 0.85, s.Z * 0.75),
			CFrame.new(0, -s.Y * 0.05, s.Z * 0.22),
			color,
			true
		)
	elseif style == "long" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.14, s.Y * 0.6, s.Z * 1.14),
			CFrame.new(0, s.Y * 0.28, 0.04),
			color,
			true
		)
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.12, s.Y * 1.5, s.Z * 0.5),
			CFrame.new(0, -s.Y * 0.3, s.Z * 0.42),
			color,
			true
		)
	elseif style == "bun" then
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 1.1, s.Y * 0.55, s.Z * 1.12),
			CFrame.new(0, s.Y * 0.3, 0.04),
			color,
			true
		)
		accessoryPart(
			model,
			head,
			Vector3.new(s.X * 0.55, s.X * 0.55, s.X * 0.55),
			CFrame.new(0, s.Y * 0.42, s.Z * 0.55),
			color,
			true
		)
	end
end

local function dress(model: Model, look)
	local head = model:FindFirstChild("Head") :: BasePart?
	local torso: BasePart? = (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")) :: any
	if head then
		addHair(model, head, look.hairStyle, look.hair)
		if not head:FindFirstChildOfClass("Decal") then
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = head
		end
	end
	if torso then
		local t = torso.Size
		if look.collar then
			accessoryPart(
				model,
				torso,
				Vector3.new(t.X * 0.34, t.Y * 0.42, 0.08),
				CFrame.new(0, t.Y * 0.28, -t.Z / 2 - 0.02),
				look.collar
			)
		end
		if look.tie then
			accessoryPart(
				model,
				torso,
				Vector3.new(t.X * 0.1, t.Y * 0.62, 0.06),
				CFrame.new(0, t.Y * 0.1, -t.Z / 2 - 0.07),
				look.tie
			)
		end
	end
end

local function fromDescription(look): Model?
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = look.skin
	desc.TorsoColor = look.top
	desc.LeftArmColor = look.top
	desc.RightArmColor = look.top
	desc.LeftLegColor = look.bottom
	desc.RightLegColor = look.bottom
	desc.HeightScale = look.scale or 1
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		return result
	end
	warn("[FirstChair] Could not build R15 rig, using a simple figure:", result)
	return nil
end

-- Fallback figure if rig creation is unavailable: still readable on camera.
local function simpleFigure(look): Model
	local model = Instance.new("Model")
	local function block(name: string, size: Vector3, cf: CFrame, color: Color3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), look.top)
	root.Transparency = 1
	block("LowerBody", Vector3.new(1.8, 2, 0.9), CFrame.new(0, 1, 0), look.bottom)
	block("UpperTorso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), look.top)
	block("LeftArm", Vector3.new(0.8, 2, 0.8), CFrame.new(-1.4, 3, 0), look.top)
	block("RightArm", Vector3.new(0.8, 2, 0.8), CFrame.new(1.4, 3, 0), look.top)
	local head = block("Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 4.6, 0), look.skin)
	head.Shape = Enum.PartType.Ball
	model.PrimaryPart = root
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= root then
			weld(part, root)
			part.Anchored = false
		end
	end
	return model
end

function Cast.build()
	local folder = ReplicatedStorage:FindFirstChild(Cast.FOLDER)
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = Cast.FOLDER

	for id, character in Characters do
		local model = fromDescription(character.look) or simpleFigure(character.look)
		model.Name = id
		dress(model, character.look)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			humanoid.BreakJointsOnDeath = false
			humanoid.RequiresNeck = false
		end
		-- scripts inside generated rigs (e.g. Animate) aren't needed for actors
		for _, d in model:GetDescendants() do
			if d:IsA("BaseScript") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
			end
		end
		model:SetAttribute("DisplayName", character.name)
		model.Parent = folder
	end

	folder.Parent = ReplicatedStorage
	return folder
end

return Cast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Courtroom</string>
            <string name="Source"><![CDATA[--[[
	Courtroom — Northbridge Civil Court, Room 4.
	Interior: x -30..30, z -46..42, height 28. The bench is at the -z end.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StageLayout = require(Shared.StageLayout)
local B = require(script.Parent.Builder)

local C = B.Palette
local M = Enum.Material

local Courtroom = {}

local HALF_W = 30
local FRONT_Z, BACK_Z = -46, 42
local H = 28
local WAINSCOT = 8
local WINDOWS = { -30, -16, -2, 12, 26 } -- z centres of the tall side windows
local WINDOW_W = 6

function Courtroom.build(root: Instance)
	local O = StageLayout.Origins.court
	local function at(x: number, y: number, z: number): CFrame
		return O * CFrame.new(x, y, z)
	end

	local model = B.folder(root, "Courtroom")
	local shell = B.folder(model, "Shell")
	local decor = B.folder(model, "Decor")
	local depth = BACK_Z - FRONT_Z
	local midZ = (BACK_Z + FRONT_Z) / 2

	----------------------------------------------------------------- floor + ceiling
	B.solid(shell, Vector3.new(HALF_W * 2 + 2, 1, depth + 2), at(0, -0.5, midZ), C.Walnut, M.WoodPlanks)
	-- lighter gallery floor and a navy aisle runner
	B.trim(
		decor,
		Vector3.new(HALF_W * 2, 0.06, BACK_Z + 6),
		at(0, 0.03, (BACK_Z - 6) / 2),
		C.Oak,
		M.WoodPlanks
	)
	B.trim(decor, Vector3.new(5, 0.1, BACK_Z + 6), at(0, 0.05, (BACK_Z - 6) / 2), C.Navy, M.Fabric)
	B.trim(decor, Vector3.new(5.6, 0.08, BACK_Z + 6), at(0, 0.04, (BACK_Z - 6) / 2), C.Brass, M.Metal)
	-- the well: an inlaid border
	B.trim(decor, Vector3.new(40, 0.06, 0.6), at(0, 0.04, -8), C.Espresso, M.Wood)

	B.solid(shell, Vector3.new(HALF_W * 2 + 2, 1, depth + 2), at(0, H + 0.5, midZ), C.Plaster, M.Plaster)
	-- coffered ceiling: cross beams + two long beams
	for z = FRONT_Z + 10, BACK_Z - 4, 12 do
		B.trim(decor, Vector3.new(HALF_W * 2, 1.4, 1.2), at(0, H - 0.7, z), C.Walnut, M.Wood)
	end
	for _, x in { -10, 10 } do
		B.trim(decor, Vector3.new(1.2, 1.4, depth), at(x, H - 0.7, midZ), C.Walnut, M.Wood)
	end
	-- recessed glow panels between beams over the centre
	for z = -6, BACK_Z - 10, 12 do
		B.glow(decor, Vector3.new(16, 0.1, 8), at(0, H - 0.08, z), C.Ivory)
	end

	----------------------------------------------------------------- side walls with tall windows
	for _, side in { -1, 1 } do
		local x = side * (HALF_W + 0.5)
		-- lower wall + walnut wainscot
		B.solid(
			shell,
			Vector3.new(1, WAINSCOT + 2, depth + 2),
			at(x, (WAINSCOT + 2) / 2, midZ),
			C.Plaster,
			M.Plaster
		)
		B.trim(
			decor,
			Vector3.new(0.4, WAINSCOT, depth),
			at(x - side * 0.7, WAINSCOT / 2, midZ),
			C.Walnut,
			M.Wood
		)
		B.trim(
			decor,
			Vector3.new(0.6, 0.35, depth),
			at(x - side * 0.85, WAINSCOT + 0.1, midZ),
			C.Brass,
			M.Metal
		)
		-- raised panels on the wainscot
		for z = FRONT_Z + 4, BACK_Z - 4, 6 do
			B.trim(
				decor,
				Vector3.new(0.2, WAINSCOT - 3, 4.4),
				at(x - side * 0.95, WAINSCOT / 2, z),
				C.WalnutLight,
				M.Wood
			)
		end
		-- header above the windows
		B.solid(
			shell,
			Vector3.new(1, H - 24, depth + 2),
			at(x, 24 + (H - 24) / 2, midZ),
			C.Plaster,
			M.Plaster
		)
		B.trim(decor, Vector3.new(0.8, 1, depth), at(x - side * 0.9, H - 0.5, midZ), C.Espresso, M.Wood) -- crown
		-- piers between windows + glass + sills
		local edges = { FRONT_Z - 1 }
		for _, wz in WINDOWS do
			table.insert(edges, wz - WINDOW_W / 2)
			table.insert(edges, wz + WINDOW_W / 2)
		end
		table.insert(edges, BACK_Z + 1)
		for i = 1, #edges, 2 do
			local z0, z1 = edges[i], edges[i + 1]
			B.solid(
				shell,
				Vector3.new(1, 24 - (WAINSCOT + 2), z1 - z0),
				at(x, (WAINSCOT + 2 + 24) / 2, (z0 + z1) / 2),
				C.Plaster,
				M.Plaster
			)
		end
		for _, wz in WINDOWS do
			B.glass(
				shell,
				Vector3.new(0.3, 24 - (WAINSCOT + 2), WINDOW_W),
				at(x, (WAINSCOT + 2 + 24) / 2, wz)
			)
			B.trim(
				decor,
				Vector3.new(1.4, 0.4, WINDOW_W + 0.6),
				at(x - side * 0.3, WAINSCOT + 2, wz),
				C.Walnut,
				M.Wood
			)
			B.trim(
				decor,
				Vector3.new(0.5, 24 - (WAINSCOT + 2), 0.25),
				at(x - side * 0.1, (WAINSCOT + 2 + 24) / 2, wz),
				C.Brass,
				M.Metal
			)
			B.trim(decor, Vector3.new(0.5, 0.25, WINDOW_W), at(x - side * 0.1, 19, wz), C.Brass, M.Metal)
			-- walnut pilaster beside each window
			B.trim(
				decor,
				Vector3.new(0.8, H - WAINSCOT - 1, 1.2),
				at(x - side * 0.9, (H + WAINSCOT) / 2, wz + WINDOW_W / 2 + 2),
				C.Walnut,
				M.Wood
			)
		end
	end

	----------------------------------------------------------------- back (entrance) wall
	local backWallZ = BACK_Z + 0.5
	B.solid(shell, Vector3.new(HALF_W * 2 + 2, H, 1), at(0, H / 2, backWallZ), C.Plaster, M.Plaster)
	B.trim(decor, Vector3.new(HALF_W * 2, WAINSCOT, 0.4), at(0, WAINSCOT / 2, BACK_Z - 0.2), C.Walnut, M.Wood)
	B.trim(decor, Vector3.new(HALF_W * 2, 0.35, 0.6), at(0, WAINSCOT + 0.1, BACK_Z - 0.3), C.Brass, M.Metal)
	-- double doors
	B.trim(decor, Vector3.new(8, 12, 0.5), at(0, 6, BACK_Z - 0.45), C.Espresso, M.Wood)
	for _, dx in { -2, 2 } do
		B.trim(decor, Vector3.new(3.6, 11.4, 0.3), at(dx, 5.8, BACK_Z - 0.75), C.Walnut, M.Wood)
		B.trim(decor, Vector3.new(0.15, 2, 0.2), at(dx * 0.15, 5.5, BACK_Z - 1), C.Brass, M.Metal)
	end
	-- clock above the doors
	B.cylinder(
		decor,
		0.3,
		3.2,
		at(0, 17, BACK_Z - 0.3) * CFrame.Angles(0, math.rad(90), 0),
		C.Ivory,
		M.SmoothPlastic
	)
	B.cylinder(
		decor,
		0.25,
		3.6,
		at(0, 17, BACK_Z - 0.2) * CFrame.Angles(0, math.rad(90), 0),
		C.Brass,
		M.Metal
	)
	B.trim(decor, Vector3.new(0.15, 1.1, 0.05), at(0, 17.4, BACK_Z - 0.5), C.Espresso, M.SmoothPlastic)
	B.trim(decor, Vector3.new(0.8, 0.15, 0.05), at(-0.35, 17, BACK_Z - 0.5), C.Espresso, M.SmoothPlastic)

	----------------------------------------------------------------- front (bench) wall
	local frontWallZ = FRONT_Z - 0.5
	B.solid(shell, Vector3.new(HALF_W * 2 + 2, H, 1), at(0, H / 2, frontWallZ), C.Walnut, M.Wood)
	-- fluted walnut pilasters
	for x = -27, 27, 6 do
		if math.abs(x) > 9 then
			B.trim(decor, Vector3.new(1.4, H - 2, 0.6), at(x, (H - 2) / 2, FRONT_Z + 0.3), C.Espresso, M.Wood)
			B.trim(decor, Vector3.new(1.8, 0.6, 0.9), at(x, H - 2.3, FRONT_Z + 0.4), C.Brass, M.Metal)
		end
	end
	-- navy dossal panel framed in brass, with the city seal
	B.trim(decor, Vector3.new(16, 18, 0.4), at(0, 13, FRONT_Z + 0.3), C.Navy, M.Fabric)
	for _, sx in { -8.1, 8.1 } do
		B.trim(decor, Vector3.new(0.4, 18.4, 0.6), at(sx, 13, FRONT_Z + 0.35), C.Brass, M.Metal)
	end
	B.trim(decor, Vector3.new(16.6, 0.4, 0.6), at(0, 22.2, FRONT_Z + 0.35), C.Brass, M.Metal)
	B.trim(decor, Vector3.new(18, 1.4, 1.2), at(0, 23.2, FRONT_Z + 0.6), C.Walnut, M.Wood) -- pediment
	local sealZ = FRONT_Z + 0.6
	B.cylinder(decor, 0.3, 7.6, at(0, 15.5, sealZ) * CFrame.Angles(0, math.rad(90), 0), C.Brass, M.Metal)
	B.cylinder(
		decor,
		0.35,
		6.4,
		at(0, 15.5, sealZ + 0.05) * CFrame.Angles(0, math.rad(90), 0),
		C.NavyDeep,
		M.SmoothPlastic
	)
	local sealText =
		B.part(decor, Vector3.new(5.2, 5.2, 0.05), at(0, 15.5, sealZ + 0.26), C.Navy, { transparency = 1 })
	B.label(
		sealText,
		Enum.NormalId.Back,
		"NORTHBRIDGE\nCIVIL COURT",
		{ color = C.Gold, bold = true, ppu = 50 }
	)
	local motto =
		B.part(decor, Vector3.new(12, 1, 0.05), at(0, 9.6, FRONT_Z + 0.55), C.Navy, { transparency = 1 })
	B.label(motto, Enum.NormalId.Back, "TRUTH  ·  EVIDENCE  ·  FAIRNESS", {
		color = C.Gold,
		font = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold),
	})

	----------------------------------------------------------------- judge's bench
	local bench = B.folder(model, "Bench")
	local platformH = 4
	B.solid(bench, Vector3.new(24, platformH, 11), at(0, platformH / 2, FRONT_Z + 5.5), C.Espresso, M.Wood)
	-- step down to the clerk level
	B.solid(bench, Vector3.new(26, 1, 2), at(0, 0.5, FRONT_Z + 11.6), C.Walnut, M.Wood)
	-- bench front: walnut with lighter raised panels and brass rails
	local benchFrontZ = -35
	local benchTop = platformH + 3
	B.solid(bench, Vector3.new(18, benchTop, 1.4), at(0, benchTop / 2, benchFrontZ), C.Walnut, M.Wood)
	for _, sx in { -9.4, 9.4 } do
		B.solid(bench, Vector3.new(1, benchTop, 4), at(sx, benchTop / 2, benchFrontZ - 1.3), C.Walnut, M.Wood)
	end
	for i = -1, 1 do
		B.trim(
			bench,
			Vector3.new(4.6, benchTop - 2.6, 0.2),
			at(i * 5.6, benchTop / 2 - 0.2, benchFrontZ + 0.75),
			C.WalnutLight,
			M.Wood
		)
		B.trim(
			bench,
			Vector3.new(4.2, 0.12, 0.25),
			at(i * 5.6, benchTop - 1.6, benchFrontZ + 0.8),
			C.Brass,
			M.Metal
		)
	end
	B.trim(bench, Vector3.new(19.2, 0.45, 3.4), at(0, benchTop + 0.22, benchFrontZ - 0.9), C.Espresso, M.Wood)
	B.trim(bench, Vector3.new(19.4, 0.15, 0.25), at(0, benchTop + 0.05, benchFrontZ + 0.72), C.Brass, M.Metal)
	B.trim(bench, Vector3.new(18.4, 0.3, 0.3), at(0, 0.15, benchFrontZ + 0.75), C.Brass, M.Metal)
	local nameplate =
		B.trim(bench, Vector3.new(4, 0.6, 0.25), at(0, benchTop - 0.7, benchFrontZ + 0.82), C.Brass, M.Metal)
	B.label(nameplate, Enum.NormalId.Back, "JUDGE ROWAN", { color = C.NavyDeep, bold = true, ppu = 60 })
	-- tall leather chair framing the judge
	local chairZ = -41.4
	B.trim(bench, Vector3.new(4.2, 7.8, 0.9), at(0, platformH + 4.4, chairZ), C.Navy, M.Leather)
	B.trim(bench, Vector3.new(4.6, 0.5, 1.1), at(0, platformH + 8.4, chairZ), C.Brass, M.Metal)
	-- gavel + block, papers, banker's lamp
	B.cylinder(bench, 0.25, 1.1, at(-3, benchTop + 0.55, benchFrontZ - 1.2), C.Espresso, M.Wood)
	B.trim(
		bench,
		Vector3.new(1.4, 0.35, 0.35),
		at(-2.4, benchTop + 0.65, benchFrontZ - 1.6) * CFrame.Angles(0, math.rad(30), 0),
		C.Espresso,
		M.Wood
	)
	B.trim(
		bench,
		Vector3.new(1.8, 0.05, 2.3),
		at(3, benchTop + 0.47, benchFrontZ - 1.2) * CFrame.Angles(0, math.rad(-8), 0),
		C.Ivory,
		M.SmoothPlastic
	)
	B.post(bench, 1, 0.12, at(-6, benchTop + 0.45, benchFrontZ - 1.4), C.Brass, M.Metal)
	local lampHead =
		B.trim(bench, Vector3.new(1.8, 0.45, 0.7), at(-6, benchTop + 1.5, benchFrontZ - 1.3), C.Navy, M.Glass)
	B.light(lampHead, "Spot", 0.8, 8, C.WarmLight, Enum.NormalId.Bottom)
	-- plants either side of the bench
	B.plant(decor, at(-13.5, 0, -42), 1.2)
	B.plant(decor, at(13.5, 0, -42), 1.2)

	-- clerk's desk (left, lower)
	B.solid(bench, Vector3.new(7, 3.6, 3), at(-12.5, 1.8, -31), C.Walnut, M.Wood)
	B.trim(bench, Vector3.new(7.4, 0.3, 3.4), at(-12.5, 3.75, -31), C.Espresso, M.Wood)
	B.trim(bench, Vector3.new(7.1, 0.2, 0.2), at(-12.5, 3.3, -29.45), C.Brass, M.Metal)
	B.trim(
		bench,
		Vector3.new(1.6, 1.1, 0.12),
		at(-11.5, 4.5, -31.6) * CFrame.Angles(math.rad(-10), 0, 0),
		C.Charcoal,
		M.SmoothPlastic
	)

	----------------------------------------------------------------- witness stand
	local stand = B.folder(model, "WitnessStand")
	local wcf = StageLayout.Spots.court_witness.cf * CFrame.new(0, -1.5, 0) -- floor-level frame
	B.solid(stand, Vector3.new(6, 1.5, 6), wcf * CFrame.new(0, 0.75, 0.5), C.Espresso, M.Wood)
	B.solid(stand, Vector3.new(6, 3.4, 0.5), wcf * CFrame.new(0, 1.5 + 1.7, -2.3), C.Walnut, M.Wood)
	for _, sx in { -2.75, 2.75 } do
		B.solid(stand, Vector3.new(0.5, 3.4, 4.5), wcf * CFrame.new(sx, 1.5 + 1.7, -0.3), C.Walnut, M.Wood)
		B.trim(stand, Vector3.new(0.7, 0.25, 4.7), wcf * CFrame.new(sx, 5.0, -0.3), C.Brass, M.Metal)
	end
	B.trim(stand, Vector3.new(6.2, 0.25, 0.7), wcf * CFrame.new(0, 5.0, -2.3), C.Brass, M.Metal)
	B.trim(stand, Vector3.new(4.2, 2.2, 0.2), wcf * CFrame.new(0, 3.2, -2.6), C.WalnutLight, M.Wood)
	-- microphone
	B.trim(
		stand,
		Vector3.new(0.1, 1.4, 0.1),
		wcf * CFrame.new(0.9, 5.7, -2.1) * CFrame.Angles(math.rad(-25), 0, 0),
		C.Charcoal,
		M.Metal
	)
	B.ball(stand, 0.35, wcf * CFrame.new(0.9, 6.35, -1.8), C.Charcoal, M.Metal)

	----------------------------------------------------------------- counsel tables
	local tables = B.folder(model, "CounselTables")
	for _, side in { -1, 1 } do
		local cx = side * 9
		B.table(tables, at(cx, 0, -16), Vector3.new(12, 3, 4), C.Walnut, C.Espresso, M.Wood)
		-- modesty panel facing the bench
		B.trim(tables, Vector3.new(11, 2.2, 0.2), at(cx, 1.6, -17.7), C.Walnut, M.Wood)
		B.trim(tables, Vector3.new(11, 0.12, 0.25), at(cx, 2.5, -17.8), C.Brass, M.Metal)
		-- papers and folders
		B.trim(
			tables,
			Vector3.new(1.6, 0.12, 2.1),
			at(cx - 3, 3.07, -15.4) * CFrame.Angles(0, math.rad(side * 6), 0),
			C.Navy,
			M.Fabric
		)
		B.trim(
			tables,
			Vector3.new(1.5, 0.05, 2),
			at(cx + 0.5, 3.04, -15.2) * CFrame.Angles(0, math.rad(-side * 4), 0),
			C.Ivory,
			M.SmoothPlastic
		)
		B.trim(
			tables,
			Vector3.new(1.6, 0.18, 2.1),
			at(cx + 3.4, 3.1, -15.6),
			if side < 0 then C.Burgundy else C.Charcoal,
			M.Fabric
		)
		B.post(tables, 0.9, 0.5, at(cx - 4.6, 3.0, -16.6), C.Glass, M.Glass)
		-- chairs behind the counsel (pulled back so actors stand clear)
		for _, dx in { -3.6, 0, 3.6 } do
			B.chair(tables, at(cx + dx, 0, -9.6), C.Leather)
		end
	end

	----------------------------------------------------------------- the bar (railing)
	local bar = B.folder(model, "Bar")
	local barZ = -6
	for _, side in { -1, 1 } do
		local len = HALF_W - 3
		local cx = side * (3 + len / 2)
		B.trim(bar, Vector3.new(len, 3, 0.5), at(cx, 1.5, barZ), C.Walnut, M.Wood)
		B.trim(bar, Vector3.new(len, 0.35, 0.9), at(cx, 3.15, barZ), C.Espresso, M.Wood)
		B.trim(bar, Vector3.new(len, 0.12, 0.95), at(cx, 3.36, barZ), C.Brass, M.Metal)
		for i = 0, math.floor(len / 3) - 1 do
			B.trim(
				bar,
				Vector3.new(2.2, 1.8, 0.1),
				at(side * (4.6 + i * 3), 1.6, barZ - 0.3),
				C.WalnutLight,
				M.Wood
			)
		end
		B.post(bar, 4, 0.8, at(side * 3, 0, barZ), C.Espresso, M.Wood)
		B.ball(bar, 0.9, at(side * 3, 4.2, barZ), C.Brass, M.Metal)
	end

	----------------------------------------------------------------- gallery pews
	local gallery = B.folder(model, "Gallery")
	for row = 0, 5 do
		local z = 0 + row * 5.5
		for _, side in { -1, 1 } do
			local cx = side * 15
			local len = 21
			B.trim(gallery, Vector3.new(len, 0.5, 2.2), at(cx, 1.8, z), C.Walnut, M.Wood)
			B.trim(gallery, Vector3.new(len, 2.8, 0.4), at(cx, 3.2, z + 1.2), C.Walnut, M.Wood)
			B.trim(gallery, Vector3.new(len, 0.25, 0.6), at(cx, 4.65, z + 1.2), C.Espresso, M.Wood)
			B.trim(gallery, Vector3.new(len - 0.4, 0.15, 1.8), at(cx, 2.1, z - 0.1), C.Navy, M.Fabric)
			for _, ex in { -len / 2, len / 2 } do
				B.trim(gallery, Vector3.new(0.4, 4.2, 2.8), at(cx + ex, 2.1, z + 0.3), C.Espresso, M.Wood)
			end
		end
	end

	----------------------------------------------------------------- law library shelves (left of the well)
	local shelves = B.folder(model, "Library")
	local shelfX = -HALF_W + 1.2
	B.trim(shelves, Vector3.new(1.6, 9, 12), at(shelfX, 4.5, -24), C.Espresso, M.Wood)
	local bookColors = { C.Navy, C.Burgundy, C.Leather, C.Sage, C.NavySoft, C.BrassDark }
	for level = 0, 3 do
		B.trim(
			shelves,
			Vector3.new(1.8, 0.25, 12),
			at(shelfX + 0.1, 0.9 + level * 2.1, -24),
			C.Walnut,
			M.Wood
		)
		for b = 0, 2 do
			local color = bookColors[((level + b) % #bookColors) + 1]
			B.trim(
				shelves,
				Vector3.new(1.2, 1.5, 3.4),
				at(shelfX + 0.3, 1.8 + level * 2.1, -28.2 + b * 4.1),
				color,
				M.Fabric
			)
		end
	end
	B.trim(shelves, Vector3.new(1.6, 9, 12), at(-shelfX, 4.5, -24), C.Espresso, M.Wood)
	for level = 0, 3 do
		B.trim(
			shelves,
			Vector3.new(1.8, 0.25, 12),
			at(-shelfX - 0.1, 0.9 + level * 2.1, -24),
			C.Walnut,
			M.Wood
		)
		for b = 0, 2 do
			local color = bookColors[((level + b + 2) % #bookColors) + 1]
			B.trim(
				shelves,
				Vector3.new(1.2, 1.5, 3.4),
				at(-shelfX - 0.3, 1.8 + level * 2.1, -28.2 + b * 4.1),
				color,
				M.Fabric
			)
		end
	end

	----------------------------------------------------------------- lighting
	-- three brass pendants down the gallery
	for _, z in { 4, 16, 28 } do
		B.trim(decor, Vector3.new(0.1, 7, 0.1), at(0, H - 3.5, z), C.Brass, M.Metal)
		local shade =
			B.cylinder(decor, 0.6, 4, at(0, H - 7.3, z) * CFrame.Angles(0, 0, math.rad(90)), C.Brass, M.Metal)
		B.cylinder(
			decor,
			0.15,
			3.4,
			at(0, H - 7.65, z) * CFrame.Angles(0, 0, math.rad(90)),
			C.WarmLight,
			M.Neon
		)
		B.light(shade, "Point", 1.1, 26, C.WarmLight)
	end
	-- the well: two broad ceiling washes
	for _, z in { -32, -18 } do
		local panel = B.glow(decor, Vector3.new(14, 0.1, 6), at(0, H - 0.1, z), C.Ivory)
		B.light(panel, "Surface", 1.4, 30, C.WarmLight, Enum.NormalId.Bottom)
	end
	-- sconces between the side windows (glow only)
	for _, side in { -1, 1 } do
		for _, wz in WINDOWS do
			B.sconce(
				decor,
				at(side * (HALF_W - 1.2), 13, wz - WINDOW_W / 2 - 1.5)
					* CFrame.Angles(0, math.rad(side * 90), 0),
				false
			)
		end
	end

	return model
end

return Courtroom
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Office</string>
            <string name="Source"><![CDATA[--[[
	Office — the Valence Legal lobby: reception, lounge with the case board,
	and glass-walled Conference Room B. Interior: x -32..32, z -22..22, h 16.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StageLayout = require(Shared.StageLayout)
local CaseCatalog = require(Shared.CaseCatalog)
local B = require(script.Parent.Builder)

local C = B.Palette
local M = Enum.Material

local Office = {}

local W, D, H = 64, 44, 16 -- interior width (x), depth (z), height

function Office.build(root: Instance)
	local O = StageLayout.Origins.office
	local function at(x: number, y: number, z: number): CFrame
		return O * CFrame.new(x, y, z)
	end
	local function rot(x: number, y: number, z: number, yaw: number): CFrame
		return O * CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw), 0)
	end

	local model = B.folder(root, "Office")
	local shell = B.folder(model, "Shell")
	local decor = B.folder(model, "Decor")

	----------------------------------------------------------------- floor
	B.solid(shell, Vector3.new(W + 2, 1, D + 2), at(0, -0.5, 0), C.Stone, M.Marble)
	-- walnut inlay frame around the central lobby
	for _, z in { -6, 18 } do
		B.trim(decor, Vector3.new(22, 0.06, 0.5), at(0, 0.03, z), C.Walnut, M.Wood)
	end
	for _, x in { -11, 11 } do
		B.trim(decor, Vector3.new(0.5, 0.06, 24), at(x, 0.03, 6), C.Walnut, M.Wood)
	end
	-- navy runner from the doors to reception
	B.trim(decor, Vector3.new(6, 0.08, 26), at(0, 0.04, 8), C.Navy, M.Fabric)
	B.trim(decor, Vector3.new(6.6, 0.06, 26.6), at(0, 0.03, 8), C.Brass, M.Metal)

	----------------------------------------------------------------- ceiling
	B.solid(shell, Vector3.new(W + 2, 1, D + 2), at(0, H + 0.5, 0), C.Plaster, M.Plaster)
	-- central coffer with warm cove lighting
	local cofferY = H - 0.6
	for _, z in { -6, 18 } do
		B.trim(decor, Vector3.new(24, 1.2, 1), at(0, cofferY, z), C.Walnut, M.Wood)
		B.glow(decor, Vector3.new(22, 0.15, 0.3), at(0, cofferY - 0.3, z + (z < 0 and 0.7 or -0.7)))
	end
	for _, x in { -12, 12 } do
		B.trim(decor, Vector3.new(1, 1.2, 25), at(x, cofferY, 6), C.Walnut, M.Wood)
		B.glow(decor, Vector3.new(0.3, 0.15, 22), at(x + (x < 0 and 0.7 or -0.7), cofferY - 0.3, 6))
	end

	----------------------------------------------------------------- walls
	local function wainscot(size: Vector3, cf: CFrame)
		B.trim(decor, size, cf, C.Walnut, M.Wood)
		B.trim(
			decor,
			Vector3.new(size.X + 0.1, 0.25, size.Z + 0.1),
			cf * CFrame.new(0, size.Y / 2 + 0.1, 0),
			C.Brass,
			M.Metal
		)
	end

	-- Left wall (x = -32) and right wall (x = 32)
	for _, side in { -1, 1 } do
		local x = side * (W / 2 + 0.5)
		B.solid(shell, Vector3.new(1, H, D + 2), at(x, H / 2, 0), C.Plaster, M.Plaster)
		wainscot(Vector3.new(0.3, 4, D), at(x - side * 0.65, 2, 0))
		B.trim(decor, Vector3.new(0.6, 0.8, D), at(x - side * 0.8, H - 0.4, 0), C.Espresso, M.Wood) -- crown
	end

	-- Front wall (z = 22) with glass entrance doors in the middle
	local frontZ = D / 2 + 0.5
	for _, side in { -1, 1 } do
		local segW = W / 2 - 5
		local cx = side * (5 + segW / 2)
		B.solid(shell, Vector3.new(segW, H, 1), at(cx, H / 2, frontZ), C.Plaster, M.Plaster)
		wainscot(Vector3.new(segW, 4, 0.3), at(cx, 2, frontZ - 0.65))
		B.trim(decor, Vector3.new(segW, 0.8, 0.6), at(cx, H - 0.4, frontZ - 0.8), C.Espresso, M.Wood)
	end
	B.solid(shell, Vector3.new(10, H - 11, 1), at(0, 11 + (H - 11) / 2, frontZ), C.Plaster, M.Plaster)
	B.trim(decor, Vector3.new(10.4, 0.5, 1.2), at(0, 11, frontZ), C.Brass, M.Metal)
	for _, side in { -1, 1 } do
		B.glass(decor, Vector3.new(4.9, 11, 0.25), at(side * 2.5, 5.5, frontZ))
		B.trim(decor, Vector3.new(0.3, 11, 0.5), at(side * 5, 5.5, frontZ), C.Brass, M.Metal)
		B.trim(decor, Vector3.new(0.15, 3.5, 0.15), at(side * 0.6, 4.5, frontZ - 0.35), C.Brass, M.Metal)
	end
	B.trim(decor, Vector3.new(0.3, 11, 0.5), at(0, 5.5, frontZ), C.Brass, M.Metal)

	-- Back wall (z = -22): windows left and right, feature wall in the middle
	local backZ = -D / 2 - 0.5
	B.solid(shell, Vector3.new(28, H, 1), at(0, H / 2, backZ), C.Plaster, M.Plaster)
	for _, side in { -1, 1 } do
		local cx = side * 23
		-- sill, header and end pieces around a big window (x 14..30 / -30..-14)
		B.solid(shell, Vector3.new(18, 3, 1), at(cx, 1.5, backZ), C.Plaster, M.Plaster)
		B.solid(shell, Vector3.new(18, 3, 1), at(cx, H - 1.5, backZ), C.Plaster, M.Plaster)
		B.solid(shell, Vector3.new(2, H, 1), at(side * 31, H / 2, backZ), C.Plaster, M.Plaster)
		local gx = side * 22 -- glass spans x 14..30 (or -30..-14)
		B.glass(shell, Vector3.new(16, H - 6, 0.3), at(gx, H / 2, backZ))
		B.trim(decor, Vector3.new(16.4, 0.4, 1.4), at(gx, 3.1, backZ + 0.2), C.Walnut, M.Wood) -- sill
		for i = 0, 4 do
			B.trim(
				decor,
				Vector3.new(0.25, H - 6, 0.4),
				at(gx - 8 + i * 4, H / 2, backZ + 0.1),
				C.Brass,
				M.Metal
			)
		end
		B.trim(decor, Vector3.new(16, 0.25, 0.4), at(gx, 9.5, backZ + 0.1), C.Brass, M.Metal)
	end

	----------------------------------------------------------------- reception
	local rec = B.folder(model, "Reception")
	-- navy feature wall with walnut slats either side
	B.trim(rec, Vector3.new(22, 12, 0.6), at(0, 8, backZ + 0.8), C.Navy, M.SmoothPlastic)
	B.trim(rec, Vector3.new(22.6, 0.3, 0.8), at(0, 14.15, backZ + 0.9), C.Brass, M.Metal)
	B.trim(rec, Vector3.new(22.6, 0.3, 0.8), at(0, 1.85, backZ + 0.9), C.Brass, M.Metal)
	for side = -1, 1, 2 do
		for i = 0, 2 do
			B.trim(
				rec,
				Vector3.new(0.5, H - 0.5, 0.6),
				at(side * (11.8 + i * 0.75), H / 2, backZ + 0.8),
				C.Walnut,
				M.Wood
			)
		end
	end
	-- monogram: a brass "V" over the name
	local vTop = 11.4
	for _, side in { -1, 1 } do
		B.trim(
			rec,
			Vector3.new(0.35, 3.2, 0.2),
			at(side * 0.55, vTop, backZ + 1.2) * CFrame.Angles(0, 0, math.rad(side * 18)),
			C.Brass,
			M.Metal
		)
	end
	local sign =
		B.part(rec, Vector3.new(16, 2.2, 0.1), at(0, 8.3, backZ + 1.15), C.Navy, { transparency = 1 })
	B.label(sign, Enum.NormalId.Back, "VALENCE  LEGAL", { bold = true, color = C.Gold })
	local tagline =
		B.part(rec, Vector3.new(12, 0.8, 0.1), at(0, 6.7, backZ + 1.15), C.Navy, { transparency = 1 })
	B.label(tagline, Enum.NormalId.Back, "ATTORNEYS AT LAW  ·  NORTHBRIDGE  ·  EST. 1984", {
		color = C.Cream,
		font = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Medium),
	})

	-- counter: walnut body, vertical fluting, ivory marble top, brass kick
	local counterZ = -10
	B.solid(rec, Vector3.new(16, 3.6, 3), at(0, 1.8, counterZ), C.Walnut, M.Wood)
	for i = -7, 7, 2 do
		B.trim(rec, Vector3.new(0.35, 3.0, 0.15), at(i, 1.9, counterZ + 1.55), C.Espresso, M.Wood)
	end
	B.trim(rec, Vector3.new(16.2, 0.3, 3.2), at(0, 0.15, counterZ), C.Brass, M.Metal)
	B.trim(rec, Vector3.new(16.8, 0.3, 3.6), at(0, 3.75, counterZ), C.Ivory, M.Marble)
	for _, x in { -8.2, 8.2 } do
		B.trim(rec, Vector3.new(0.4, 3.6, 3.2), at(x, 1.8, counterZ), C.Espresso, M.Wood)
	end
	-- counter dressing
	B.trim(
		rec,
		Vector3.new(2.2, 1.4, 0.15),
		at(3.2, 4.8, counterZ - 0.6) * CFrame.Angles(math.rad(-8), 0, 0),
		C.Charcoal,
		M.SmoothPlastic
	)
	B.trim(rec, Vector3.new(0.3, 0.6, 0.3), at(3.2, 4.2, counterZ - 0.45), C.Charcoal, M.SmoothPlastic)
	B.post(rec, 0.9, 0.7, at(-5, 3.9, counterZ + 0.4), C.Ivory, M.Glass)
	B.ball(rec, 1.2, at(-5, 5.2, counterZ + 0.4), C.Burgundy, M.Fabric)
	B.ball(rec, 0.8, at(-4.6, 5.6, counterZ + 0.6), C.Cream, M.Fabric)
	B.trim(rec, Vector3.new(1.6, 0.2, 1.1), at(-1, 4.0, counterZ + 0.5), C.Navy, M.Leather) -- guest book
	B.trim(rec, Vector3.new(0.05, 0.05, 0.9), at(-0.6, 4.13, counterZ + 0.5), C.Brass, M.Metal)

	-- three brass pendants above the counter
	for _, x in { -5, 0, 5 } do
		B.trim(rec, Vector3.new(0.08, 4, 0.08), at(x, H - 2, counterZ), C.Brass, M.Metal)
		local shade = B.post(rec, 0.9, 1.6, at(x, H - 5, counterZ), C.Brass, M.Metal)
		B.glow(rec, Vector3.new(1.2, 0.1, 1.2), at(x, H - 5.05, counterZ))
		if x == 0 then
			B.light(shade, "Point", 1.4, 22, C.WarmLight)
		end
	end
	B.chair(rec, rot(-1.5, 0, -14.6, 180), C.Navy)

	----------------------------------------------------------------- lounge + case board (left)
	local lounge = B.folder(model, "Lounge")
	B.trim(lounge, Vector3.new(13, 0.08, 15), at(-23, 0.04, 4), C.Navy, M.Fabric)
	B.trim(lounge, Vector3.new(13.6, 0.06, 15.6), at(-23, 0.03, 4), C.Cream, M.Fabric)

	-- sofa against the left wall, facing +x
	local sofa = rot(-28.6, 0, 4, -90)
	B.trim(lounge, Vector3.new(9, 1.6, 3.2), sofa * CFrame.new(0, 0.8, 0), C.NavySoft, M.Fabric)
	B.trim(lounge, Vector3.new(9, 2.6, 0.8), sofa * CFrame.new(0, 2.3, 1.2), C.NavySoft, M.Fabric)
	for _, sx in { -4.8, 4.8 } do
		B.trim(lounge, Vector3.new(0.7, 2.4, 3.4), sofa * CFrame.new(sx, 1.2, 0), C.NavySoft, M.Fabric)
	end
	for _, sx in { -2.2, 2.2 } do
		B.trim(lounge, Vector3.new(4.2, 0.5, 2.6), sofa * CFrame.new(sx, 1.85, -0.1), C.Navy, M.Fabric)
	end
	B.trim(
		lounge,
		Vector3.new(1.3, 1.1, 0.4),
		sofa * CFrame.new(-3, 2.6, 0.7) * CFrame.Angles(math.rad(-15), 0, math.rad(8)),
		C.Brass,
		M.Fabric
	)
	B.trim(
		lounge,
		Vector3.new(1.3, 1.1, 0.4),
		sofa * CFrame.new(3, 2.6, 0.7) * CFrame.Angles(math.rad(-15), 0, math.rad(-8)),
		C.Cream,
		M.Fabric
	)

	-- armchairs facing the sofa
	for _, z in { 0.5, 7.5 } do
		local chair = rot(-17.5, 0, z, 90)
		B.trim(lounge, Vector3.new(3, 1.5, 3), chair * CFrame.new(0, 0.75, 0), C.Leather, M.Leather)
		B.trim(lounge, Vector3.new(3, 2.4, 0.6), chair * CFrame.new(0, 2.2, 1.2), C.Leather, M.Leather)
		for _, ax in { -1.5, 1.5 } do
			B.trim(lounge, Vector3.new(0.5, 2.1, 3), chair * CFrame.new(ax, 1.05, 0), C.Leather, M.Leather)
		end
	end

	-- coffee table: walnut base, marble top, a stack of books
	B.trim(lounge, Vector3.new(3, 1.2, 5), at(-23, 0.6, 4), C.Espresso, M.Wood)
	B.trim(lounge, Vector3.new(3.6, 0.25, 5.8), at(-23, 1.33, 4), C.Ivory, M.Marble)
	B.trim(lounge, Vector3.new(1.4, 0.3, 1.9), at(-23, 1.6, 2.6), C.Navy, M.Fabric)
	B.trim(
		lounge,
		Vector3.new(1.2, 0.25, 1.7),
		at(-23, 1.88, 2.6) * CFrame.Angles(0, math.rad(12), 0),
		C.Burgundy,
		M.Fabric
	)
	B.post(lounge, 0.5, 0.6, at(-23, 1.45, 5.6), C.Brass, M.Metal)

	-- floor lamp
	B.post(lounge, 0.2, 1.4, at(-29.5, 0, -4), C.Brass, M.Metal)
	B.post(lounge, 7, 0.15, at(-29.5, 0, -4), C.Brass, M.Metal)
	local lampShade = B.post(lounge, 1.4, 1.8, at(-29.5, 7, -4), C.Cream, M.Fabric)
	B.light(lampShade, "Point", 1, 16, C.WarmLight)

	-- the case board: three framed matters on the left wall
	local boardX = -W / 2 + 0.3
	local plate = B.part(
		lounge,
		Vector3.new(0.1, 1.2, 10),
		rot(boardX + 0.2, 14.2, 4, 0),
		C.Ivory,
		{ transparency = 1 }
	)
	B.label(plate, Enum.NormalId.Right, "ACTIVE MATTERS", { color = C.Brass, bold = true })
	for i, caseId in CaseCatalog.order do
		local info = CaseCatalog.cases[caseId]
		local z = 4 + (i - 2) * 5.6
		local frameCF = rot(boardX + 0.2, 9.5, z, 0)
		B.trim(lounge, Vector3.new(0.3, 5.4, 4.6), frameCF, C.Walnut, M.Wood)
		B.trim(lounge, Vector3.new(0.32, 5.0, 4.2), frameCF * CFrame.new(0.02, 0, 0), C.Brass, M.Metal)
		local card = B.trim(
			lounge,
			Vector3.new(0.34, 4.6, 3.8),
			frameCF * CFrame.new(0.04, 0, 0),
			C.Ivory,
			M.SmoothPlastic
		)
		B.label(card, Enum.NormalId.Right, ("CASE %02d\n\n%s"):format(i, info.title), {
			color = C.Navy,
			bold = true,
			ppu = 60,
		})
	end
	local picture = B.trim(lounge, Vector3.new(0.6, 0.3, 15), rot(boardX + 0.6, 12.8, 4, 0), C.Brass, M.Metal)
	B.light(picture, "Surface", 1.2, 10, C.WarmLight, Enum.NormalId.Bottom)
	-- walking players tap this to open the case files
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CaseFilesPrompt"
	prompt.ActionText = "Open case files"
	prompt.ObjectText = "Active Matters"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = plate

	-- Top Associates leaderboard on the right wall, filled in by LobbyService
	local lb = B.folder(model, "Leaderboard")
	B.trim(lb, Vector3.new(0.4, 9.4, 12.4), rot(W / 2 - 0.45, 8.5, 10, 0), C.Walnut, M.Wood)
	B.trim(lb, Vector3.new(0.42, 9.0, 12.0), rot(W / 2 - 0.5, 8.5, 10, 0), C.Brass, M.Metal)
	local lbBoard =
		B.trim(lb, Vector3.new(0.44, 8.6, 11.6), rot(W / 2 - 0.55, 8.5, 10, 0), C.NavyDeep, M.SmoothPlastic)
	lbBoard.Name = "LeaderboardBoard"
	local lbGui = Instance.new("SurfaceGui")
	lbGui.Face = Enum.NormalId.Left
	lbGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	lbGui.PixelsPerStud = 40
	lbGui.LightInfluence = 0.5
	lbGui.MaxDistance = 120
	lbGui.Parent = lbBoard
	local lbTitle = Instance.new("TextLabel")
	lbTitle.Name = "Title"
	lbTitle.BackgroundTransparency = 1
	lbTitle.Size = UDim2.new(1, 0, 0.16, 0)
	lbTitle.Text = "TOP ASSOCIATES"
	lbTitle.TextColor3 = C.Gold
	lbTitle.FontFace = Font.new("rbxasset://fonts/families/Merriweather.json", Enum.FontWeight.Bold)
	lbTitle.TextScaled = true
	lbTitle.Parent = lbGui
	local lbList = Instance.new("TextLabel")
	lbList.Name = "List"
	lbList.BackgroundTransparency = 1
	lbList.Position = UDim2.new(0.06, 0, 0.2, 0)
	lbList.Size = UDim2.new(0.88, 0, 0.76, 0)
	lbList.Text = "Win a case to make the board."
	lbList.TextColor3 = C.Ivory
	lbList.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Medium)
	lbList.TextSize = 22
	lbList.TextWrapped = true
	lbList.TextXAlignment = Enum.TextXAlignment.Left
	lbList.TextYAlignment = Enum.TextYAlignment.Top
	lbList.Parent = lbGui
	local lbLight = B.trim(lb, Vector3.new(0.6, 0.3, 12), rot(W / 2 - 0.8, 13.5, 10, 0), C.Brass, M.Metal)
	B.light(lbLight, "Surface", 1.0, 9, C.WarmLight, Enum.NormalId.Bottom)

	----------------------------------------------------------------- Conference Room B (right, glass)
	local conf = B.folder(model, "ConferenceRoom")
	-- glass wall along x = 12 (z -22..-2)
	local gx = 12
	for i = 0, 3 do
		B.glass(conf, Vector3.new(0.25, H, 5), at(gx, H / 2, -19.5 + i * 5))
		B.trim(conf, Vector3.new(0.4, H, 0.3), at(gx, H / 2, -22 + i * 5), C.Brass, M.Metal)
	end
	B.trim(conf, Vector3.new(0.4, H, 0.3), at(gx, H / 2, -2), C.Brass, M.Metal)
	-- glass wall along z = -2 (x 12..32), with an open doorway at x 13..17
	B.glass(conf, Vector3.new(4, H - 10, 0.25), at(15, 10 + (H - 10) / 2, -2))
	for i = 0, 2 do
		B.glass(conf, Vector3.new(5, H, 0.25), at(19.5 + i * 5, H / 2, -2))
		B.trim(conf, Vector3.new(0.3, H, 0.4), at(17 + i * 5, H / 2, -2), C.Brass, M.Metal)
	end
	B.trim(conf, Vector3.new(20, 0.4, 0.5), at(22, 0.2, -2), C.Espresso, M.Wood)
	B.trim(conf, Vector3.new(0.5, 0.4, 20), at(gx, 0.2, -12), C.Espresso, M.Wood)
	B.trim(conf, Vector3.new(20, 0.3, 0.45), at(22, 10, -2), C.Brass, M.Metal)
	local confSign =
		B.part(conf, Vector3.new(4, 0.9, 0.05), at(22, 7.2, -1.85), C.Ivory, { transparency = 1 })
	B.label(confSign, Enum.NormalId.Back, "CONFERENCE  B", { color = C.Brass, bold = true })
	local confSignOut =
		B.part(conf, Vector3.new(4, 0.9, 0.05), at(22, 7.2, -2.15), C.Ivory, { transparency = 1 })
	B.label(confSignOut, Enum.NormalId.Front, "CONFERENCE  B", { color = C.Brass, bold = true })

	-- carpet, table, chairs
	B.trim(conf, Vector3.new(18, 0.08, 18), at(22, 0.04, -12), C.Cream, M.Fabric)
	B.table(conf, at(22, 0, -12), Vector3.new(11, 3, 5), C.Walnut, C.Espresso, M.Wood)
	B.trim(conf, Vector3.new(10, 0.05, 0.25), at(22, 3.03, -12), C.Brass, M.Metal) -- inlay
	B.chair(conf, rot(18.4, 0, -7.4, 0), C.Leather)
	B.chair(conf, rot(25.6, 0, -7.4, 0), C.Leather)
	B.chair(conf, rot(25.6, 0, -16.6, 180), C.Leather)
	B.chair(conf, rot(14.2, 0, -12, 90), C.Leather)
	-- table dressing: case files, a carafe
	B.trim(
		conf,
		Vector3.new(1.6, 0.15, 2.1),
		at(21, 3.1, -10.6) * CFrame.Angles(0, math.rad(-6), 0),
		C.Navy,
		M.Fabric
	)
	B.trim(
		conf,
		Vector3.new(1.5, 0.05, 2),
		at(21, 3.2, -10.6) * CFrame.Angles(0, math.rad(-6), 0),
		C.Ivory,
		M.SmoothPlastic
	)
	B.trim(
		conf,
		Vector3.new(1.6, 0.15, 2.1),
		at(24.5, 3.1, -13.2) * CFrame.Angles(0, math.rad(10), 0),
		C.Burgundy,
		M.Fabric
	)
	B.post(conf, 1.2, 0.7, at(18.5, 3.17, -12.8), C.Glass, M.Glass)

	-- pendant over the table
	B.trim(conf, Vector3.new(0.08, 4.5, 0.08), at(19, H - 2.25, -12), C.Brass, M.Metal)
	B.trim(conf, Vector3.new(0.08, 4.5, 0.08), at(25, H - 2.25, -12), C.Brass, M.Metal)
	local bar = B.trim(conf, Vector3.new(8, 0.5, 0.8), at(22, H - 4.75, -12), C.Brass, M.Metal)
	B.glow(conf, Vector3.new(7.6, 0.1, 0.5), at(22, H - 5.05, -12))
	B.light(bar, "Surface", 1.6, 14, C.WarmLight, Enum.NormalId.Bottom)

	-- credenza under the window and art on the right wall
	B.trim(conf, Vector3.new(12, 3, 2), at(22, 1.5, -20.5), C.Walnut, M.Wood)
	B.trim(conf, Vector3.new(12.4, 0.2, 2.2), at(22, 3.1, -20.5), C.Ivory, M.Marble)
	for i = 0, 2 do
		B.trim(conf, Vector3.new(0.1, 2.2, 0.05), at(18 + i * 4, 1.5, -19.47), C.Brass, M.Metal)
	end
	B.trim(conf, Vector3.new(0.3, 1.6, 2.2), at(18.5, 4, -20.5), C.Navy, M.Fabric)
	B.trim(conf, Vector3.new(0.3, 1.4, 2.0), at(18.85, 3.9, -20.5), C.Burgundy, M.Fabric)
	B.trim(conf, Vector3.new(0.3, 1.7, 2.1), at(19.2, 4.05, -20.5), C.Cream, M.Fabric)
	B.plant(conf, at(29.5, 0, -19.5), 0.8)
	local art = B.trim(conf, Vector3.new(0.3, 6, 9), at(W / 2 - 0.2, 8, -12), C.Navy, M.Fabric)
	B.trim(conf, Vector3.new(0.35, 6.4, 9.4), at(W / 2 - 0.15, 8, -12), C.Brass, M.Metal)
	B.trim(conf, Vector3.new(0.4, 3.5, 2.2), at(W / 2 - 0.3, 8.6, -14), C.Brass, M.Metal)
	B.trim(conf, Vector3.new(0.4, 1.8, 4.6), at(W / 2 - 0.3, 7, -10.6), C.Cream, M.SmoothPlastic)
	B.trim(conf, Vector3.new(0.42, 0.25, 6.5), at(W / 2 - 0.32, 9.5, -12), C.Ivory, M.SmoothPlastic)
	art.Name = "Art"

	----------------------------------------------------------------- greenery + entry dressing
	B.plant(decor, at(-29.5, 0, 19), 1.1)
	B.plant(decor, at(-8.5, 0, 19.5), 0.9)
	B.plant(decor, at(8.5, 0, 19.5), 0.9)
	B.plant(decor, at(29, 0, 19), 1.1)
	B.plant(decor, at(-13.5, 0, -19.5), 1.0)
	B.plant(decor, at(13.8, 0, 1.2), 0.8)

	-- bench seating by the entrance (right)
	B.trim(decor, Vector3.new(8, 1.6, 2.4), at(22, 0.8, 18), C.Espresso, M.Wood)
	B.trim(decor, Vector3.new(7.6, 0.4, 2.2), at(22, 1.8, 18), C.Cream, M.Leather)
	-- wall clock above the doors
	local clock = B.cylinder(
		decor,
		0.3,
		2.4,
		at(0, 13.5, frontZ - 0.7) * CFrame.Angles(0, math.rad(90), 0),
		C.Ivory,
		M.SmoothPlastic
	)
	B.cylinder(
		decor,
		0.25,
		2.7,
		at(0, 13.5, frontZ - 0.6) * CFrame.Angles(0, math.rad(90), 0),
		C.Brass,
		M.Metal
	)
	B.trim(decor, Vector3.new(0.12, 0.8, 0.05), at(0, 13.8, frontZ - 0.88), C.Espresso, M.SmoothPlastic)
	B.trim(decor, Vector3.new(0.6, 0.12, 0.05), at(0.25, 13.5, frontZ - 0.88), C.Espresso, M.SmoothPlastic)
	clock.Name = "Clock"

	----------------------------------------------------------------- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(4, 1, 4)
	spawn.CFrame = O * CFrame.new(StageLayout.SpawnOffset) * CFrame.new(0, -0.45, 0)
	spawn.Transparency = 1
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = model

	return model
end

return Office
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="29">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="30">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">14</float>
      <float name="CameraMinZoomDistance">4</float>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">14</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	FIRST CHAIR — client entry point.
	Sets up camera, stage, music and interface, then loops:
	title screen -> (lobby) -> case -> results -> ...
]]

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local CaseCatalog = require(Shared.CaseCatalog)

local Controllers = script.Controllers
local UI = script.UI
local Audio = require(Controllers.Audio)
local CameraDirector = require(Controllers.CameraDirector)
local Music = require(Controllers.Music)
local Stage = require(Controllers.Stage)
local CaseRunner = require(Controllers.CaseRunner)

local Kit = require(UI.Kit)
local Root = require(UI.Root)
local Feedback = require(UI.Feedback)
local Evidence = require(UI.Evidence)
local MainMenu = require(UI.MainMenu)
local LobbyHud = require(UI.LobbyHud)
local Transition = require(UI.Transition)

-- A focused, story-first screen: hide Roblox's default HUD pieces we don't use.
local function hideCoreUi()
	for _, kind in
		{
			Enum.CoreGuiType.PlayerList,
			Enum.CoreGuiType.Backpack,
			Enum.CoreGuiType.Health,
			Enum.CoreGuiType.EmotesMenu,
		}
	do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(kind, false)
		end)
	end
end

-- Chat is for the lobby and the title screen; a case is a private story.
local function setChat(on: boolean)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, on)
	end)
end

hideCoreUi()
Root.init()
Audio.init()
Music.init()
CameraDirector.init()
Stage.init()
Kit.setClickSound(function()
	Audio.play("click")
end)
Evidence.setSounds(function()
	Audio.play("page")
end, function()
	Audio.play("confirm")
end)

Net.event("Notice").OnClientEvent:Connect(function(notice)
	if type(notice) == "table" and type(notice.text) == "string" then
		Feedback.toast(notice.text, notice.kind or "info", 4)
	end
end)
Net.event("Broadcast").OnClientEvent:Connect(function(notice)
	if type(notice) == "table" and type(notice.text) == "string" then
		Feedback.toast(notice.text, notice.kind or "info", 3.5)
	end
end)

local function getProfile()
	for attempt = 1, 5 do
		local ok, profile = pcall(function()
			return Net.fn("GetProfile"):InvokeServer()
		end)
		if ok and type(profile) == "table" then
			return profile
		end
		task.wait(attempt)
	end
	-- Offline fallback so the menu still renders.
	local cases = {}
	for i, id in CaseCatalog.order do
		cases[id] = { unlocked = i == 1 }
	end
	return { saving = false, points = 0, title = "Junior Associate", streak = 0, cases = cases }
end

-- Run one case on its own thread so "Quit" can stop it cleanly.
local function playCase(caseId: string): string
	return Kit.await(function(resolve)
		CaseRunner.finished = resolve
		task.spawn(function()
			resolve(CaseRunner.run(caseId))
		end)
		return nil
	end)
end

local function showMenuScene()
	Stage.setLobbyMode(false)
	Stage.clear()
	Stage.placePlayer("office_entry")
	CameraDirector.loop("office_menu", "office_menu_end", 16)
	Music.play("menu")
	setChat(true)
end

-- Walk around Valence Legal with everyone else on the server.
local function lobby(profile): string
	Transition.fadeOut(0.25)
	Root.clearCaseUi()
	Stage.setLobbyMode(true)
	CameraDirector.free()
	Music.play("menu")
	setChat(true)
	Transition.fadeIn(0.35)
	local result = LobbyHud.run(profile, function(onTrigger)
		return ProximityPromptService.PromptTriggered:Connect(function(prompt)
			if prompt.Name == "CaseFilesPrompt" then
				onTrigger()
			end
		end)
	end)
	Transition.fadeOut(0.25)
	Stage.setLobbyMode(false)
	return result
end

local nextCase: string? = nil
local startOnSelect = false
while true do
	local caseId = nextCase
	nextCase = nil
	if not caseId then
		local profile = getProfile()
		local pick = MainMenu.run(profile, {
			onShow = showMenuScene,
			musicEnabled = Music.isEnabled,
			onToggleMusic = Music.toggle,
			startOnSelect = startOnSelect,
		})
		startOnSelect = false
		if pick == "__lobby" then
			startOnSelect = lobby(profile) == "cases"
			Transition.fadeIn(0.35)
			continue
		end
		caseId = pick
	end
	setChat(false)
	local outcome = playCase(caseId :: string)
	if outcome == "replay" then
		nextCase = caseId
	elseif outcome == "next" then
		local index = CaseCatalog.indexOf(caseId :: string)
		nextCase = index and CaseCatalog.order[index + 1] or nil
	end
	Transition.fadeOut(0.25)
	Root.clearCaseUi()
	if not nextCase then
		showMenuScene()
	end
	Transition.fadeIn(0.35)
end
]]></string>
        </Properties>
        <Item class="Folder" referent="34">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--[[
	Audio — short UI sounds. Uses sounds that ship inside the Roblox client
	(rbxasset://sounds/...), so nothing needs uploading. To use richer sounds,
	replace any SoundId below with an asset from the Creator Store, e.g.
	"rbxassetid://1234567890". Missing sounds fail silently.
]]

local SoundService = game:GetService("SoundService")

local Audio = {}

local DEFS = {
	click = { id = "rbxasset://sounds/clickfast.wav", volume = 0.35, speed = 1.1 },
	page = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, speed = 0.8 },
	confirm = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.35, speed = 1.0 },
	gain = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, speed = 1.25 },
	wrong = { id = "rbxasset://sounds/button.wav", volume = 0.5, speed = 0.55 },
	objection = { id = "rbxasset://sounds/swoosh.wav", volume = 0.7, speed = 0.8 },
	gavel = { id = "rbxasset://sounds/button.wav", volume = 0.9, speed = 0.35 },
	unlock = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.45, speed = 0.75 },
	whoosh = { id = "rbxasset://sounds/swoosh.wav", volume = 0.3, speed = 1.2 },
}

-- Optional background music: paste a Creator Store audio ID here (e.g. "rbxassetid://...").
Audio.MUSIC_ID = ""

local sounds: { [string]: Sound } = {}
local music: Sound? = nil

function Audio.init()
	local folder = Instance.new("Folder")
	folder.Name = "FirstChairSounds"
	for name, def in DEFS do
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = def.id
		s.Volume = def.volume
		s.PlaybackSpeed = def.speed
		s.Parent = folder
		sounds[name] = s
	end
	folder.Parent = SoundService

	if Audio.MUSIC_ID ~= "" then
		local m = Instance.new("Sound")
		m.Name = "Music"
		m.SoundId = Audio.MUSIC_ID
		m.Looped = true
		m.Volume = 0.18
		m.Parent = folder
		music = m
		m:Play()
	end
end

function Audio.play(name: string)
	local s = sounds[name]
	if s then
		pcall(function()
			SoundService:PlayLocalSound(s)
		end)
	end
end

function Audio.setMusicVolume(volume: number)
	if music then
		music.Volume = volume
	end
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">CameraDirector</string>
              <string name="Source"><![CDATA[--[[
	CameraDirector — cinematic, script-driven camera. The player never has to
	steer the camera: every scene, speaker and decision has a framed shot.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local StageLayout = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").StageLayout)

local CameraDirector = {}

local camera: Camera = workspace.CurrentCamera
local currentTween: Tween? = nil
local fovTween: Tween? = nil
local driftTween: Tween? = nil
local loopToken = 0
local lastTarget: CFrame? = nil

local function cam(): Camera
	camera = workspace.CurrentCamera
	return camera
end

local function scriptable(): Camera
	local c = cam()
	if c.CameraType ~= Enum.CameraType.Scriptable then
		c.CameraType = Enum.CameraType.Scriptable
	end
	return c
end

local function stopAll()
	for _, t in { currentTween, fovTween, driftTween } do
		if t then
			t:Cancel()
		end
	end
	currentTween, fovTween, driftTween = nil, nil, nil
end

-- Hand the camera back to the player (lobby): Roblox's own follow camera.
function CameraDirector.free()
	loopToken += 1
	stopAll()
	lastTarget = nil
	local c = cam()
	local character = game:GetService("Players").LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	c.CameraType = Enum.CameraType.Custom
	if humanoid then
		c.CameraSubject = humanoid
	end
	c.FieldOfView = 70
end

function CameraDirector.init()
	scriptable()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		cam()
		if lastTarget then
			scriptable().CFrame = lastTarget
		end
	end)
end

-- Instantly place the camera.
function CameraDirector.cut(cf: CFrame, fov: number?)
	loopToken += 1
	stopAll()
	local c = scriptable()
	c.CFrame = cf
	if fov then
		c.FieldOfView = fov
	end
	lastTarget = cf
end

-- Smoothly move the camera, then add a slow, subtle push-in (feels alive).
function CameraDirector.move(cf: CFrame, fov: number?, time: number?, drift: boolean?)
	loopToken += 1
	stopAll()
	local c = scriptable()
	local duration = time or 0.7
	if duration <= 0 then
		CameraDirector.cut(cf, fov)
	else
		local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		local move = TweenService:Create(c, info, { CFrame = cf })
		move:Play()
		currentTween = move
		if fov then
			local zoom = TweenService:Create(c, info, { FieldOfView = fov })
			zoom:Play()
			fovTween = zoom
		end
	end
	lastTarget = cf
	if drift ~= false then
		local token = loopToken
		task.delay(duration, function()
			if token ~= loopToken then
				return
			end
			local pushed = cf * CFrame.new(0, 0, -0.6)
			local push = TweenService:Create(
				cam(),
				TweenInfo.new(9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ CFrame = pushed }
			)
			push:Play()
			driftTween = push
		end)
	end
end

function CameraDirector.shot(name: string, time: number?)
	local shot = StageLayout.Shots[name]
	if not shot then
		warn("[FirstChair] Unknown shot:", name)
		return
	end
	CameraDirector.move(shot.cf, shot.fov, time)
end

--[[
	Frame a character's face. `head` is the actor's Head part; `side` picks the
	shoulder (+1 right / -1 left) for a natural three-quarter angle.
]]
function CameraDirector.closeup(head: BasePart, facing: CFrame, side: number?, time: number?)
	local look = facing.LookVector
	local right = facing.RightVector
	local headPos = head.Position
	local eye = headPos + look * 6.2 + right * ((side or 1) * 1.9) + Vector3.new(0, 0.35, 0)
	local target = headPos - Vector3.new(0, 0.35, 0) + right * ((side or 1) * 0.15)
	CameraDirector.move(CFrame.lookAt(eye, target), 36, time or 0.6)
end

-- A short shake for dramatic beats (objections, verdicts).
function CameraDirector.shake(intensity: number?, duration: number?)
	local power = intensity or 0.6
	local length = duration or 0.35
	local c = cam()
	if driftTween then
		driftTween:Cancel()
		driftTween = nil
	end
	local base = lastTarget or c.CFrame
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t >= length then
			conn:Disconnect()
			c.CFrame = base
			return
		end
		local falloff = 1 - t / length
		local rx = (math.random() - 0.5) * math.rad(power) * falloff
		local ry = (math.random() - 0.5) * math.rad(power) * falloff
		c.CFrame = base * CFrame.Angles(rx, ry, 0)
	end)
	local fov = c.FieldOfView
	TweenService:Create(c, TweenInfo.new(0.08), { FieldOfView = fov - 4 }):Play()
	task.delay(0.1, function()
		TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Back), { FieldOfView = fov }):Play()
	end)
end

-- Slow ping-pong between two shots (main menu backdrop).
function CameraDirector.loop(a: string, b: string, seconds: number)
	CameraDirector.cut(StageLayout.Shots[a].cf, StageLayout.Shots[a].fov)
	loopToken += 1
	local token = loopToken
	task.spawn(function()
		local targets = { b, a }
		local i = 1
		while token == loopToken do
			local shot = StageLayout.Shots[targets[i]]
			local glide = TweenService:Create(
				cam(),
				TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ CFrame = shot.cf }
			)
			currentTween = glide
			glide:Play()
			glide.Completed:Wait()
			i = i % 2 + 1
		end
	end)
end

return CameraDirector
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">CaseRunner</string>
              <string name="Source"><![CDATA[--[[
	CaseRunner — plays a case from the server's (answer-free) script.

	For every step it shows the right interface, sends the player's answer to the
	server, and reacts to the server's verdict. The client never decides whether
	an answer is right, what the score is, or what gets unlocked.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local StageLayout = require(Shared.StageLayout)

local Controllers = script.Parent
local UI = Controllers.Parent.UI
local Audio = require(Controllers.Audio)
local CameraDirector = require(Controllers.CameraDirector)
local Music = require(Controllers.Music)
local Stage = require(Controllers.Stage)

local Root = require(UI.Root)
local Transition = require(UI.Transition)
local Feedback = require(UI.Feedback)
local Dialogue = require(UI.Dialogue)
local Choice = require(UI.Choice)
local Evidence = require(UI.Evidence)
local Testimony = require(UI.Testimony)
local Interview = require(UI.Interview)
local Hud = require(UI.Hud)
local PauseMenu = require(UI.PauseMenu)
local Results = require(UI.Results)

local CaseRunner = {}

type Def = Evidence.Def

-- Per-run state
local case = nil
local defs: { [string]: Def } = {}
local inventory: { string } = {}
local seen: { [string]: boolean } = {}
local completedBefore = false
local lastSpeaker: string? = nil
local runToken = 0

local function invoke(name: string, ...: any): any
	local remote = Net.fn(name)
	for attempt = 1, 3 do
		local ok, result = pcall(remote.InvokeServer, remote, ...)
		if ok then
			return result
		end
		warn("[FirstChair] " .. name .. " failed:", result)
		Feedback.toast("Connection hiccup — retrying…", "warning")
		task.wait(attempt)
	end
	return nil
end

local function inventoryDefs(): { Def }
	local list = {}
	for _, id in inventory do
		if defs[id] then
			table.insert(list, defs[id])
		end
	end
	return list
end

local function addEvidence(def: Def, quiet: boolean?)
	defs[def.id] = def
	if not table.find(inventory, def.id) then
		table.insert(inventory, def.id)
		if not quiet then
			Audio.play("gain")
			Feedback.evidenceGained(def.name, if def.kind == "combined" then "NEW COMBINED EVIDENCE" else nil)
		end
	end
	Hud.setEvidenceCount(#inventory)
end

----------------------------------------------------------------- camera helpers
local function focus(speaker: string, force: boolean?)
	if speaker == "narrator" then
		return
	end
	if speaker == lastSpeaker and not force then
		return
	end
	local head, facing, side = Stage.focus(speaker)
	if head and facing then
		lastSpeaker = speaker
		CameraDirector.closeup(head, facing, side)
	end
end

local function playLines(lines, skippable: boolean?)
	return Dialogue.play(lines, {
		skippable = skippable,
		nameOf = Stage.displayName,
		onLine = function(line)
			if line.shot then
				lastSpeaker = nil
				CameraDirector.shot(line.shot)
			else
				focus(line[1])
			end
		end,
	})
end

----------------------------------------------------------------- step handlers
local handlers = {}

function handlers.scene(step)
	Transition.fadeOut(0.28)
	Music.play(step.location)
	Stage.setScene(step)
	lastSpeaker = nil
	local shot = StageLayout.Shots[step.shot]
	if shot then
		CameraDirector.cut(shot.cf, shot.fov)
		-- a gentle settle so every scene opens with movement
		CameraDirector.move(shot.cf * CFrame.new(0, 0, -1.2), shot.fov, 2.4)
	end
	task.wait(0.1)
	Transition.fadeIn(0.4)
	if step.title then
		Transition.locationCard(StageLayout.LocationTitles[step.location] or "", step.title)
		task.wait(0.6)
	end
	return nil
end

function handlers.dialogue(step)
	playLines(step.lines, seen[step.id] or completedBefore)
	return nil
end

function handlers.interview(step)
	local skippable = seen[step.id] or completedBefore
	Interview.run(step, function(lines)
		playLines(lines, skippable)
	end, function()
		focus(step.with, true)
	end)
	return nil
end

function handlers.evidence_review(step)
	local list = {}
	for _, id in step.items do
		if defs[id] then
			table.insert(list, defs[id])
		end
	end
	Evidence.review(list, step.prompt)
	return nil
end

function handlers.gain(_step)
	return nil
end

function handlers.choice(step)
	if step.speaker then
		focus(step.speaker, true)
	end
	local name = step.speaker and (Stage.displayName(step.speaker))
	return Choice.ask(step.prompt, step.options, name)
end

function handlers.present(step)
	if step.speaker then
		focus(step.speaker, true)
	end
	local picked = Evidence.pick(inventoryDefs(), {
		title = "Present Evidence",
		prompt = step.prompt,
		count = 1,
		confirmText = "Present",
	})
	return picked and picked[1]
end

function handlers.combine(step)
	local picked = Evidence.pick(inventoryDefs(), {
		title = "Combine Evidence",
		prompt = step.prompt,
		count = 2,
		confirmText = "Combine",
	})
	return picked
end

function handlers.order(step)
	local list = {}
	for _, id in step.items do
		if defs[id] then
			table.insert(list, defs[id])
		end
	end
	return Evidence.order(list, step.prompt)
end

local testimonyPosition: { [string]: number } = {}
function handlers.testimony(step)
	local answer, position = Testimony.run(step, {
		start = testimonyPosition[step.id],
		onShow = function()
			focus(step.witness)
		end,
		press = function(i)
			local press = step.statements[i].press
			if press then
				playLines(press)
			end
			focus(step.witness, true)
		end,
		present = function(i)
			local picked = Evidence.pick(inventoryDefs(), {
				title = "Present Evidence",
				prompt = "Against: “" .. step.statements[i].text .. "”",
				count = 1,
				confirmText = "Present",
				cancellable = true,
			})
			focus(step.witness, true)
			return picked and picked[1]
		end,
	})
	testimonyPosition[step.id] = position
	return answer
end

function handlers.verdict(step)
	Feedback.verdict(step.title, step.subtitle, function()
		Audio.play("gavel")
		CameraDirector.shake(0.4, 0.3)
	end)
	return nil
end

function handlers.complete(_step)
	return nil
end

----------------------------------------------------------------- reactions
local function onCorrect(step, result)
	if step.type == "testimony" or step.type == "present" then
		Audio.play("objection")
		Stage.gesture("player")
		focus("player", true)
		CameraDirector.shake(0.8, 0.35)
		Feedback.objection(
			"OBJECTION!",
			if step.type == "present" then "The evidence speaks." else "Contradiction found."
		)
	elseif step.type == "combine" then
		Audio.play("confirm")
		Feedback.toast("Evidence combined", "success")
	elseif step.type == "order" then
		Audio.play("objection")
		CameraDirector.shake(0.6, 0.3)
		Feedback.objection("THE TIMELINE", "Every minute accounted for.")
	elseif step.type == "choice" then
		Audio.play("confirm")
		if result.feedback then
			Feedback.toast(result.feedback, "success", 3)
		end
	end
	if result.granted then
		for _, def in result.granted do
			addEvidence(def)
		end
	end
end

local function onWrong(step, result)
	Audio.play("wrong")
	if not result.noPenalty then
		Feedback.toast("Not quite — try again", "danger", 1.6)
	end
	CameraDirector.shake(0.25, 0.2)
	local coach = result.coach or "mara"
	if not Stage.has(coach) then
		coach = "narrator"
	end
	lastSpeaker = nil
	playLines({ { coach, result.feedback } })
	if step.type == "testimony" then
		focus(step.witness, true)
	end
end

----------------------------------------------------------------- main loop
function CaseRunner.run(caseId: string): string
	runToken += 1
	local myToken = runToken
	Root.clearCaseUi()

	local start = invoke("StartCase", caseId)
	if not start or not start.ok then
		Feedback.toast(
			if start and start.reason == "locked"
				then "That case is still locked."
				else "Couldn't open the case. Try again.",
			"danger"
		)
		return "menu"
	end

	case = start.case
	defs = {}
	for id, def in case.evidence do
		defs[id] = def
	end
	inventory = {}
	seen = {}
	for _, id in start.seen do
		seen[id] = true
	end
	completedBefore = start.completedBefore == true
	lastSpeaker = nil
	testimonyPosition = {}

	local outcome: string? = nil
	local caseThread = coroutine.running()

	Hud.show(("Case %d  ·  %s"):format(case.number, case.title), {
		onCaseFile = function()
			Evidence.caseFile(inventoryDefs())
		end,
		onPause = function()
			local choice = PauseMenu.show(case.title, { enabled = Music.isEnabled, toggle = Music.toggle })
			if choice == "restart" or choice == "menu" then
				local quitTo = if choice == "restart" then "replay" else "menu"
				outcome = quitTo
				runToken += 1
				Root.clearCaseUi()
				Hud.hide()
				Stage.clear()
				pcall(task.cancel, caseThread)
				task.spawn(invoke, "AbandonCase")
				-- the cancelled thread can't return, so finish on its behalf
				CaseRunner.finished(quitTo)
			end
		end,
	})
	Hud.setEvidenceCount(0)

	local index = 1
	while index <= #case.steps do
		if myToken ~= runToken then
			return outcome or "menu"
		end
		local step = case.steps[index]
		if step.objective then
			Hud.setObjective(step.objective)
		end
		local handler = handlers[step.type]
		local answer = if handler then handler(step) else nil
		if myToken ~= runToken then
			return outcome or "menu"
		end

		local result = invoke("Submit", case.id, index, answer)
		if myToken ~= runToken then
			return outcome or "menu"
		end
		if not result then
			Feedback.toast("Lost connection to the court. Returning to menu.", "danger", 4)
			Hud.hide()
			return "menu"
		end
		if not result.ok then
			if result.reason == "out_of_sync" and result.step then
				index = result.step
			elseif result.reason == "busy" then
				task.wait(0.5)
			else
				-- invalid input: just let the player try the step again
				Feedback.toast("Let's try that again.", "warning")
			end
			continue
		end

		if result.correct == false then
			onWrong(step, result)
			continue
		end

		onCorrect(step, result)

		if result.finished then
			Hud.hide()
			Stage.clear()
			Music.play("results")
			local choice = Results.show(result.results, case.title, {
				gavel = function()
					Audio.play("gavel")
				end,
				unlock = function()
					Audio.play("unlock")
				end,
			})
			return choice
		end
		index = result.next
	end
	Hud.hide()
	return "menu"
end

-- Set by the main script: called when a case is quit from the pause menu.
CaseRunner.finished = function(_outcome: string) end

return CaseRunner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Music</string>
              <string name="Source"><![CDATA[--[[
	Music — one looping track per place in the story, cross-faded as scenes change.
	Track asset IDs come from shared/Config.luau; an empty slot just stays silent.
]]

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config)

local Music = {}

local sounds: { [string]: Sound } = {}
local current: string? = nil
local enabled = true

local function fade(sound: Sound, volume: number, seconds: number, thenStop: boolean?)
	local tween =
		TweenService:Create(sound, TweenInfo.new(seconds, Enum.EasingStyle.Sine), { Volume = volume })
	tween:Play()
	if thenStop then
		tween.Completed:Connect(function()
			if sound.Volume <= 0.001 then
				sound:Stop()
			end
		end)
	end
end

function Music.init()
	local f = Instance.new("Folder")
	f.Name = "FirstChairMusic"
	for key, id in Config.Music do
		if type(id) == "string" and id ~= "" then
			local s = Instance.new("Sound")
			s.Name = key
			s.SoundId = id
			s.Looped = key ~= "results"
			s.Volume = 0
			s.Parent = f
			sounds[key] = s
		end
	end
	f.Parent = SoundService
end

function Music.has(key: string): boolean
	return sounds[key] ~= nil
end

-- Cross-fade to a track. Unknown or silent keys fade the current track out.
function Music.play(key: string)
	if current == key then
		return
	end
	local previous = current and sounds[current]
	current = key
	if previous then
		fade(previous, 0, 0.9, true)
	end
	local next = sounds[key]
	if next then
		if not next.IsPlaying then
			next.TimePosition = 0
			next:Play()
		end
		fade(next, if enabled then Config.MusicVolume else 0, 1.4)
	end
end

function Music.stop()
	local playing = current and sounds[current]
	current = nil
	if playing then
		fade(playing, 0, 0.6, true)
	end
end

function Music.setEnabled(on: boolean)
	enabled = on
	local playing = current and sounds[current]
	if playing then
		fade(playing, if on then Config.MusicVolume else 0, 0.4)
	end
end

function Music.isEnabled(): boolean
	return enabled
end

function Music.toggle(): boolean
	Music.setEnabled(not enabled)
	return enabled
end

return Music
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Stage</string>
              <string name="Source"><![CDATA[--[[
	Stage — the player's private set, plus the shared social lobby.

	Case mode: local copies of the cast stand on their marks, the player's avatar is
	parked at its mark, and other players are hidden so a shared server still feels
	like a personal story.

	Lobby mode: the avatar can walk, nearby players are drawn (nearest first, up to a
	budget that keeps iPads smooth in big servers) with their career title over their
	head, and the case board can be tapped to start playing.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StageLayout = require(Shared.StageLayout)
local Characters = require(Shared.Characters)
local Config = require(Shared.Config)

local Stage = {}

local player = Players.LocalPlayer
local IDLE_ANIMATION = "rbxassetid://507766388" -- Roblox's default R15 idle
local POINT_ANIMATION = "rbxassetid://507770453" -- Roblox's default R15 "point" emote

local folder: Folder? = nil
local actors: { [string]: { model: Model, spot: StageLayout.Spot, tracks: { [string]: AnimationTrack } } } =
	{}
local playerSpot: StageLayout.Spot? = nil
local lobbyMode = false
local controls: any = nil

local function stageFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "LocalStage"
	f.Parent = workspace
	folder = f
	return f
end

local function rootOffset(model: Model): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if humanoid and root and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function loadTrack(model: Model, id: string, looped: boolean): AnimationTrack?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local ok, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		return (animator :: Animator):LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = looped
		return track
	end
	return nil
end

local function templates(): Folder?
	return ReplicatedStorage:WaitForChild("FirstChairCast", 20) :: Folder?
end

----------------------------------------------------------------- actors
function Stage.clear()
	for _, actor in actors do
		actor.model:Destroy()
	end
	table.clear(actors)
end

local function spawnActor(characterId: string, spotName: string)
	local spot = StageLayout.Spots[spotName]
	local source = templates()
	local template = source and source:FindFirstChild(characterId) :: Model?
	if not spot or not template then
		warn("[FirstChair] Missing actor or spot:", characterId, spotName)
		return
	end
	local model = template:Clone()
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = true
		model.PrimaryPart = root
	end
	model:PivotTo(spot.cf * CFrame.new(0, rootOffset(model), 0))
	model.Parent = stageFolder()
	local tracks = {}
	local idle = loadTrack(model, IDLE_ANIMATION, true)
	if idle then
		idle:Play(0.2, 1, 0.9 + math.random() * 0.2)
		tracks.idle = idle
	end
	actors[characterId] = { model = model, spot = spot, tracks = tracks }
end

----------------------------------------------------------------- own avatar
local function ownHumanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local scripts = player:WaitForChild("PlayerScripts", 10)
		local module = scripts and scripts:WaitForChild("PlayerModule", 10) :: ModuleScript?
		return module and (require(module) :: any):GetControls()
	end)
	if ok and result then
		controls = result
	end
	return controls
end

local function setWalking(enabled: boolean)
	local humanoid = ownHumanoid()
	if humanoid then
		humanoid.WalkSpeed = if enabled then Config.Lobby.walkSpeed else 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = not enabled
	end
	local c = getControls()
	if c then
		if enabled then
			c:Enable()
		else
			c:Disable()
		end
	end
end

function Stage.placePlayer(spotName: string?)
	if not spotName then
		return
	end
	local spot = StageLayout.Spots[spotName]
	if not spot then
		return
	end
	playerSpot = spot
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root then
		return
	end
	root.Anchored = true
	character:PivotTo(spot.cf * CFrame.new(0, rootOffset(character), 0))
end

-- Apply a scene step: { location, cast = { [spot] = characterId }, player = spot }
function Stage.setScene(step)
	Stage.clear()
	for spotName, characterId in step.cast or {} do
		spawnActor(characterId, spotName)
	end
	Stage.placePlayer(step.player)
end

-- Head + facing for a speaker id ("player" or a character id).
function Stage.focus(speaker: string): (BasePart?, CFrame?, number?)
	if speaker == "player" then
		local character = player.Character
		local head = character and character:FindFirstChild("Head") :: BasePart?
		if head and playerSpot then
			return head, playerSpot.cf, playerSpot.side
		end
		return nil
	end
	local actor = actors[speaker]
	if not actor then
		return nil
	end
	local head = actor.model:FindFirstChild("Head") :: BasePart?
	return head, actor.spot.cf, actor.spot.side
end

function Stage.has(speaker: string): boolean
	return speaker == "player" or actors[speaker] ~= nil
end

-- A small gesture for emphasis (used on objections).
function Stage.gesture(speaker: string)
	local model: Model? = nil
	if speaker == "player" then
		model = player.Character
	elseif actors[speaker] then
		model = actors[speaker].model
	end
	if not model then
		return
	end
	local track = loadTrack(model, POINT_ANIMATION, false)
	if track then
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.1)
	end
end

function Stage.displayName(speaker: string): (string, string)
	if speaker == "player" then
		return player.DisplayName, "Associate, Valence Legal"
	end
	local character = Characters[speaker]
	if character then
		return character.name, character.role
	end
	return speaker, ""
end

----------------------------------------------------------------- other players
local others: { [Player]: { character: Model?, tag: BillboardGui?, shown: boolean } } = {}

local function setCharacterVisible(character: Model, visible: boolean)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if visible then 0 else 1
		elseif d:IsA("Decal") then
			d.Transparency = if visible then 0 else 1
		end
	end
end

local function makeTag(other: Player, character: Model): BillboardGui?
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CareerTag"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(200, 44)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 24)
	name.Text = other.DisplayName
	name.TextColor3 = Color3.fromRGB(246, 241, 231)
	name.TextStrokeTransparency = 0.5
	name.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold)
	name.TextSize = 18
	name.Parent = gui
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(0, 24)
	title.Size = UDim2.new(1, 0, 0, 18)
	title.Text = tostring(other:GetAttribute("Title") or "Junior Associate")
	title.TextColor3 = Color3.fromRGB(205, 172, 112)
	title.TextStrokeTransparency = 0.5
	title.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
	title.TextSize = 13
	title.Parent = gui
	other:GetAttributeChangedSignal("Title"):Connect(function()
		title.Text = tostring(other:GetAttribute("Title") or "")
	end)
	gui.Parent = head
	return gui
end

local function trackOther(other: Player, character: Model)
	local entry = others[other] or { shown = false }
	entry.character = character
	entry.shown = false
	others[other] = entry
	setCharacterVisible(character, false)
	character.DescendantAdded:Connect(function(d)
		if not entry.shown then
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			elseif d:IsA("Decal") then
				d.Transparency = 1
			end
		end
	end)
	if entry.tag then
		entry.tag:Destroy()
		entry.tag = nil
	end
end

-- Show the nearest N other players (lobby) or none (case). Runs twice a second.
local function updateVisibility()
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local ranked = {}
	for other, entry in others do
		local root = entry.character and entry.character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if entry.character and entry.character.Parent and root then
			local distance = if myRoot then (root.Position - myRoot.Position).Magnitude else math.huge
			table.insert(ranked, { other = other, entry = entry, distance = distance })
		end
	end
	table.sort(ranked, function(a, b)
		return a.distance < b.distance
	end)
	for index, item in ranked do
		local show = lobbyMode and index <= Config.Lobby.visiblePlayers
		if show ~= item.entry.shown then
			item.entry.shown = show
			setCharacterVisible(item.entry.character :: Model, show)
			if show and not item.entry.tag then
				item.entry.tag = makeTag(item.other, item.entry.character :: Model)
			elseif not show and item.entry.tag then
				item.entry.tag:Destroy()
				item.entry.tag = nil
			end
		end
	end
end

----------------------------------------------------------------- modes
-- Lobby: walk around the office and see other associates. Case: private, parked, hidden.
function Stage.setLobbyMode(enabled: boolean)
	lobbyMode = enabled
	setWalking(enabled)
	updateVisibility()
end

function Stage.isLobby(): boolean
	return lobbyMode
end

function Stage.init()
	local function watch(other: Player)
		if other == player then
			return
		end
		if other.Character then
			trackOther(other, other.Character)
		end
		other.CharacterAdded:Connect(function(character)
			trackOther(other, character)
		end)
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(other)
		local entry = others[other]
		if entry and entry.tag then
			entry.tag:Destroy()
		end
		others[other] = nil
	end)

	-- Our own avatar: parked unless the lobby says otherwise.
	local function lockSelf(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		setWalking(lobbyMode)
	end
	if player.Character then
		task.spawn(lockSelf, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		lockSelf(character)
		if playerSpot and not lobbyMode then
			task.wait(0.2)
			for name, spot in StageLayout.Spots do
				if spot == playerSpot then
					Stage.placePlayer(name)
					break
				end
			end
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.5 then
			accumulator = 0
			updateVisibility()
		end
	end)
end

return Stage
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="40">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Choice</string>
              <string name="Source"><![CDATA[--[[
	Choice — a decision card: a short prompt and 2–4 large answer cards.
	Choice.ask(prompt, options, speakerName?) -> chosen index
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Choice = {}

local C = Theme.Colors
local LETTERS = { "A", "B", "C", "D", "E" }

function Choice.ask(prompt: string, options: { { text: string } }, speaker: string?): number
	return Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "Choice",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.modal,
		})
		local scrim = Kit.scrim(layer, 1)
		Kit.tween(scrim, 0.3, { BackgroundTransparency = 0.5 })

		local card = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 24),
			Size = UDim2.new(0, 640, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = layer,
		})
		Kit.padding(22, 26).Parent = card
		Kit.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center).Parent = card
		local scale = Kit.new("UIScale", { Scale = 0.96, Parent = card })

		if speaker then
			Kit.text({
				Text = string.upper(speaker),
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Tiny,
				TextColor3 = C.Accent,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = 1,
				Parent = card,
			})
		end
		Kit.text({
			Text = prompt,
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Heading,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = card,
		})
		Kit.new("Frame", {
			BackgroundColor3 = C.AccentDeep,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 80, 0, 1),
			LayoutOrder = 3,
			Parent = card,
		})

		local chosen = false
		for i, option in options do
			local button = Kit.button({
				text = "",
				style = "paper",
				size = UDim2.new(1, 0, 0, 0),
				layoutOrder = 10 + i,
				parent = card,
				onClick = function()
					if chosen then
						return
					end
					chosen = true
					Kit.tween(scrim, 0.2, { BackgroundTransparency = 1 })
					local t = Kit.tween(scale, 0.18, { Scale = 0.96 })
					Kit.tween(card, 0.18, { BackgroundTransparency = 1 })
					t.Completed:Connect(function()
						layer:Destroy()
						resolve(i)
					end)
				end,
			})
			button.AutomaticSize = Enum.AutomaticSize.Y
			Kit.new("UISizeConstraint", { MinSize = Vector2.new(0, Theme.TouchHeight), Parent = button })
			Kit.padding(12, 16, 12, 60).Parent = button
			local badge = Kit.new("Frame", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, -46, 0.5, 0),
				Size = UDim2.new(0, 30, 0, 30),
				Parent = button,
			})
			Kit.corner(UDim.new(1, 0)).Parent = badge
			Kit.text({
				Text = LETTERS[i] or tostring(i),
				FontFace = Theme.Fonts.BodyBold,
				TextSize = Theme.Text.Small,
				TextColor3 = C.Accent,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = badge,
			})
			Kit.text({
				Text = option.text,
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Body - 1,
				TextColor3 = C.Ink,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = button,
			})
		end

		Kit.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.tween(card, 0.3, { Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Quart)
		return nil
	end)
end

return Choice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Dialogue</string>
              <string name="Source"><![CDATA[--[[
	Dialogue — the cinematic subtitle panel.

	Dialogue.play(lines, { skippable, onLine }) yields until the conversation ends.
	Tap anywhere (or press Space/Enter) to finish the current line, tap again to
	advance. "Skip" appears for conversations the player has already seen.
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Dialogue = {}

local C = Theme.Colors
local CHARS_PER_SECOND = 58

export type Line = { any }
export type Options = {
	skippable: boolean?,
	onLine: ((Line, number) -> ())?,
	nameOf: (string) -> (string, string),
}

function Dialogue.play(lines: { Line }, opts: Options): string
	return Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "DialogueLayer",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.dialogue,
		})
		-- Tap anywhere on the scene to advance.
		local catcher = Kit.new("TextButton", {
			Name = "TapCatcher",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = layer,
		})
		-- Soft gradient so text is readable over any scene.
		local shade = Kit.new("Frame", {
			BackgroundColor3 = C.Scrim,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 260),
			BackgroundTransparency = 0,
			Parent = layer,
		})
		Kit.new("UIGradient", {
			Rotation = -90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = shade,
		})

		local panel = Kit.new("TextButton", {
			Name = "Panel",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = Theme.PanelTransparency,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -16 + 30),
			Size = UDim2.new(1, -48, 0, 150),
			Parent = layer,
		})
		Kit.corner().Parent = panel
		Kit.stroke(C.AccentDeep, 1, 0.5).Parent = panel
		Kit.new("UISizeConstraint", { MaxSize = Vector2.new(900, 150), Parent = panel })

		local nameTab = Kit.new("Frame", {
			Name = "NameTab",
			BackgroundColor3 = C.AccentDeep,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 22, 0, -17),
			Size = UDim2.new(0, 0, 0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = panel,
		})
		Kit.corner(Theme.RadiusSmall).Parent = nameTab
		Kit.padding(0, 14).Parent = nameTab
		Kit.list(
			Enum.FillDirection.Horizontal,
			10,
			Enum.HorizontalAlignment.Left,
			Enum.VerticalAlignment.Center
		).Parent =
			nameTab
		local nameLabel = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.BodyBold,
			TextSize = Theme.Text.Small + 2,
			TextColor3 = C.Panel,
			TextWrapped = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			LayoutOrder = 1,
			Parent = nameTab,
		})
		local roleLabel = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.Body,
			TextSize = Theme.Text.Tiny + 1,
			TextColor3 = C.Panel,
			TextTransparency = 0.25,
			TextWrapped = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			LayoutOrder = 2,
			Parent = nameTab,
		})

		local body = Kit.text({
			Name = "Body",
			Text = "",
			FontFace = Theme.Fonts.Body,
			TextSize = Theme.Text.Body + 1,
			LineHeight = 1.15,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 26, 0, 30),
			Size = UDim2.new(1, -52, 1, -50),
			Parent = panel,
		})

		local prompt = Kit.text({
			Text = "TAP  ›",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -18, 1, -10),
			Size = UDim2.new(0, 80, 0, 16),
			Visible = false,
			Parent = panel,
		})

		local finished = false
		local function finish(how: string)
			if finished then
				return
			end
			finished = true
			local t =
				Kit.tween(panel, 0.18, { Position = UDim2.new(0.5, 0, 1, 20), BackgroundTransparency = 1 })
			Kit.tween(shade, 0.18, { BackgroundTransparency = 1 })
			t.Completed:Connect(function()
				layer:Destroy()
				resolve(how)
			end)
		end

		if opts.skippable then
			Kit.button({
				text = "SKIP  »",
				style = "ghost",
				textSize = Theme.Text.Tiny + 1,
				size = UDim2.new(0, 96, 0, 34),
				anchor = Vector2.new(1, 0),
				position = UDim2.new(1, -16, 0, -17),
				parent = panel,
				onClick = function()
					finish("skipped")
				end,
			})
		end

		local index = 0
		local typing = false
		local typeConn: RBXScriptConnection? = nil
		local total = 0

		local function completeLine()
			if typeConn then
				typeConn:Disconnect()
				typeConn = nil
			end
			typing = false
			body.MaxVisibleGraphemes = -1
			prompt.Visible = true
		end

		local function showLine(i: number)
			local line = lines[i]
			local speaker, text = line[1], line[2]
			if opts.onLine then
				task.spawn(opts.onLine, line, i)
			end
			if speaker == "narrator" then
				nameTab.Visible = false
				body.FontFace = Theme.Fonts.SerifItalic
				body.TextColor3 = C.Accent
				body.TextXAlignment = Enum.TextXAlignment.Center
			else
				local name, role = opts.nameOf(speaker)
				nameTab.Visible = true
				nameLabel.Text = string.upper(name)
				roleLabel.Text = role
				roleLabel.Visible = role ~= ""
				nameTab.BackgroundColor3 = if speaker == "player" then C.Paper else C.AccentDeep
				local aside = string.sub(text, 1, 1) == "("
				body.FontFace = if aside then Theme.Fonts.SerifItalic else Theme.Fonts.Body
				body.TextColor3 = if aside then C.TextDim else C.Text
				body.TextXAlignment = Enum.TextXAlignment.Left
			end
			body.Text = text
			total = utf8.len(text) or #text
			body.MaxVisibleGraphemes = 0
			prompt.Visible = false
			typing = true
			local start = os.clock()
			typeConn = RunService.Heartbeat:Connect(function()
				local shown = math.floor((os.clock() - start) * CHARS_PER_SECOND)
				if shown >= total then
					completeLine()
				else
					body.MaxVisibleGraphemes = shown
				end
			end)
		end

		local function advance()
			if finished then
				return
			end
			if typing then
				completeLine()
				return
			end
			index += 1
			if index > #lines then
				finish("done")
			else
				showLine(index)
			end
		end

		catcher.Activated:Connect(advance)
		panel.Activated:Connect(advance)
		local keyConn = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end
			if
				input.KeyCode == Enum.KeyCode.Space
				or input.KeyCode == Enum.KeyCode.Return
				or input.KeyCode == Enum.KeyCode.ButtonA
			then
				advance()
			end
		end)
		layer.Destroying:Connect(function()
			keyConn:Disconnect()
			if typeConn then
				typeConn:Disconnect()
			end
		end)

		Kit.tween(panel, 0.25, { Position = UDim2.new(0.5, 0, 1, -16) }, Enum.EasingStyle.Quart)
		advance()
		return nil
	end)
end

return Dialogue
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Evidence</string>
              <string name="Source"><![CDATA[--[[
	Evidence — everything to do with exhibits:
	  Evidence.review(defs)                 inspect every item, then continue
	  Evidence.pick(inventory, opts)        choose 1 (present) or 2 (combine) items
	  Evidence.inspect(def, actions?)       full-screen exhibit view
	  Evidence.caseFile(inventory)          browse everything you hold
	Each exhibit gets a small illustration drawn in UI (no image assets needed).
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Evidence = {}

local C = Theme.Colors
local P = Theme.Palette

export type Def = {
	id: string,
	name: string,
	kind: string,
	summary: string,
	details: { string },
	keyDetail: string?,
}

local KIND_LABEL = {
	document = "DOCUMENT",
	photo = "FOOTAGE",
	data = "DIGITAL RECORD",
	statement = "STATEMENT",
	combined = "COMBINED EVIDENCE",
}

local sounds: { page: () -> (), confirm: () -> () } = {
	page = function() end,
	confirm = function() end,
}
function Evidence.setSounds(page: () -> (), confirm: () -> ())
	sounds.page = page
	sounds.confirm = confirm
end

----------------------------------------------------------------- illustrations
local function bar(
	parent: Instance,
	x: number,
	y: number,
	w: number,
	h: number,
	color: Color3,
	transparency: number?
)
	return Kit.new("Frame", {
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		Parent = parent,
	})
end

-- Draws a little exhibit illustration filling `parent`.
function Evidence.art(kind: string, parent: GuiObject)
	if kind == "photo" then
		local screen = bar(parent, 0.06, 0.08, 0.88, 0.84, P.Charcoal)
		Kit.corner(UDim.new(0, 4)).Parent = screen
		local g = bar(screen, 0, 0.55, 1, 0.45, P.NavySoft, 0.3)
		g.ZIndex = screen.ZIndex
		bar(screen, 0.12, 0.3, 0.18, 0.45, P.Walnut) -- a doorway
		bar(screen, 0.55, 0.42, 0.3, 0.16, P.Stone, 0.4) -- counter
		local dot = bar(screen, 0.07, 0.08, 0.06, 0.08, P.Danger)
		Kit.corner(UDim.new(1, 0)).Parent = dot
		Kit.text({
			Text = "REC",
			FontFace = Theme.Fonts.Mono,
			TextSize = 10,
			TextColor3 = P.Ivory,
			Position = UDim2.fromScale(0.15, 0.04),
			Size = UDim2.fromScale(0.4, 0.16),
			Parent = screen,
		})
		Kit.text({
			Text = "18:00:00",
			FontFace = Theme.Fonts.Mono,
			TextSize = 10,
			TextColor3 = P.Ivory,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.fromScale(0.45, 0.82),
			Size = UDim2.fromScale(0.5, 0.14),
			Parent = screen,
		})
	elseif kind == "data" then
		local screen = bar(parent, 0.06, 0.08, 0.88, 0.84, P.NavyDeep)
		Kit.corner(UDim.new(0, 4)).Parent = screen
		Kit.stroke(P.NavySoft, 1, 0).Parent = screen
		for i = 0, 4 do
			local w = ({ 0.7, 0.5, 0.62, 0.38, 0.55 })[i + 1]
			bar(screen, 0.1, 0.16 + i * 0.15, w, 0.06, if i == 2 then P.Gold else P.NavySoft)
		end
		bar(screen, 0.1, 0.16 + 5 * 0.15, 0.06, 0.08, P.Gold)
	elseif kind == "statement" then
		local paper = bar(parent, 0.14, 0.06, 0.72, 0.88, P.Ivory)
		Kit.corner(UDim.new(0, 3)).Parent = paper
		Kit.text({
			Text = "“",
			FontFace = Theme.Fonts.Display,
			TextSize = 46,
			TextColor3 = P.Brass,
			Position = UDim2.fromScale(0.08, -0.02),
			Size = UDim2.fromScale(0.5, 0.4),
			Parent = paper,
		})
		for i = 0, 3 do
			bar(paper, 0.14, 0.42 + i * 0.12, if i == 3 then 0.45 else 0.72, 0.04, P.Stone)
		end
	elseif kind == "combined" then
		local back = bar(parent, 0.1, 0.06, 0.56, 0.74, P.Cream)
		back.Rotation = -8
		Kit.corner(UDim.new(0, 3)).Parent = back
		local front = bar(parent, 0.34, 0.2, 0.56, 0.74, P.Ivory)
		front.Rotation = 6
		Kit.corner(UDim.new(0, 3)).Parent = front
		for i = 0, 2 do
			bar(front, 0.14, 0.2 + i * 0.16, 0.7, 0.05, P.Stone)
		end
		local link = bar(parent, 0.38, 0.36, 0.24, 0.24, P.Brass)
		link.SizeConstraint = Enum.SizeConstraint.RelativeYY
		Kit.corner(UDim.new(1, 0)).Parent = link
		Kit.text({
			Text = "+",
			FontFace = Theme.Fonts.BodyBold,
			TextSize = 20,
			TextColor3 = P.NavyDeep,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = link,
		})
	else -- document
		local paper = bar(parent, 0.16, 0.06, 0.68, 0.88, P.Ivory)
		Kit.corner(UDim.new(0, 3)).Parent = paper
		bar(paper, 0.14, 0.1, 0.5, 0.07, P.Navy)
		for i = 0, 3 do
			bar(paper, 0.14, 0.26 + i * 0.1, 0.72, 0.035, P.Stone)
		end
		bar(paper, 0.14, 0.78, 0.36, 0.025, P.Espresso)
		local seal = bar(paper, 0.62, 0.66, 0.24, 0.2, P.Burgundy)
		seal.SizeConstraint = Enum.SizeConstraint.RelativeXX
		Kit.corner(UDim.new(1, 0)).Parent = seal
	end
end

----------------------------------------------------------------- card
local CARD_SIZE = Vector2.new(168, 196)

local function makeCard(def: Def, parent: Instance, order: number): (TextButton, Frame)
	local card = Kit.new("TextButton", {
		Name = def.id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = P.Navy,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.corner().Parent = card
	local stroke = Kit.stroke(C.AccentDeep, 1, 0.55)
	stroke.Parent = card
	local artBox = Kit.new("Frame", {
		BackgroundColor3 = P.NavyDeep,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 108),
		Parent = card,
	})
	Kit.corner(Theme.RadiusSmall).Parent = artBox
	Evidence.art(def.kind, artBox)
	Kit.text({
		Text = KIND_LABEL[def.kind] or "EVIDENCE",
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny - 1,
		TextColor3 = C.Accent,
		Position = UDim2.fromOffset(12, 124),
		Size = UDim2.new(1, -24, 0, 14),
		Parent = card,
	})
	Kit.text({
		Text = def.name,
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Small,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(12, 140),
		Size = UDim2.new(1, -24, 0, 44),
		Parent = card,
	})
	local scale = Kit.new("UIScale", { Parent = card })
	card.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.08, { Scale = 0.97 })
	end)
	card.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	card.MouseLeave:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	return card, artBox
end

local function setSelected(card: TextButton, selected: boolean)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if selected then C.Accent else C.AccentDeep
		stroke.Thickness = if selected then 3 else 1
		stroke.Transparency = if selected then 0 else 0.55
	end
	card.BackgroundColor3 = if selected then P.NavySoft else P.Navy
end

local function badge(card: Instance, text: string, color: Color3): Frame
	local b = Kit.new("Frame", {
		Name = "Badge",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(28, 28),
		ZIndex = 5,
		Parent = card,
	})
	Kit.corner(UDim.new(1, 0)).Parent = b
	Kit.text({
		Text = text,
		FontFace = Theme.Fonts.BodyBold,
		TextSize = Theme.Text.Small,
		TextColor3 = P.NavyDeep,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 6,
		Parent = b,
	})
	return b
end

-- Small "i" button to read an exhibit without selecting it.
local function infoButton(card: Instance, onClick: () -> ())
	local b = Kit.new("TextButton", {
		Name = "Info",
		Text = "i",
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Small,
		TextColor3 = P.NavyDeep,
		AutoButtonColor = true,
		BackgroundColor3 = P.Ivory,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(30, 30),
		ZIndex = 5,
		Parent = card,
	})
	Kit.corner(UDim.new(1, 0)).Parent = b
	b.Activated:Connect(onClick)
end

----------------------------------------------------------------- modal frame
local function modalShell(
	title: string,
	subtitle: string?,
	parent: Instance?
): (Frame, Frame, Frame, TextButton)
	local layer = Kit.new("Frame", {
		Name = "EvidenceModal",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent or Root.modal,
	})
	local scrim = Kit.scrim(layer, 1)
	Kit.tween(scrim, 0.25, { BackgroundTransparency = 0.35 })
	local card = Kit.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.new(1, -60, 1, -70),
		Parent = layer,
	})
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(920, 520), Parent = card })
	Kit.padding(18, 22).Parent = card
	Kit.tween(card, 0.25, { Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Quart)

	Kit.text({
		Text = title,
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Heading,
		Size = UDim2.new(1, -10, 0, 30),
		Parent = card,
	})
	Kit.text({
		Text = subtitle or "",
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, -10, 0, 22),
		Parent = card,
	})
	local grid = Kit.new("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64 - 66),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.AccentDeep,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = card,
	})
	Kit.padding(6).Parent = grid
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		CellPadding = UDim2.fromOffset(14, 14),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local footer = Kit.new("Frame", {
		Name = "Footer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 56),
		Parent = card,
	})
	Kit.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent =
		footer
	return layer, grid, footer, scrim
end

----------------------------------------------------------------- inspector
--[[
	Show one exhibit in full. `actions` adds extra buttons (e.g. "Present").
	Yields until closed; returns the chosen action id or "close".
]]
function Evidence.inspect(def: Def, actions: { { id: string, text: string } }?): string
	sounds.page()
	return Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "Inspector",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.popup,
		})
		local scrim = Kit.scrim(layer, 1)
		Kit.tween(scrim, 0.2, { BackgroundTransparency = 0.3 })
		local card = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 18),
			Size = UDim2.new(1, -60, 1, -60),
			Parent = layer,
		})
		Kit.new("UISizeConstraint", { MaxSize = Vector2.new(860, 480), Parent = card })
		Kit.padding(20, 24).Parent = card
		Kit.tween(card, 0.25, { Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Quart)

		-- left: the illustration on a paper-toned plate
		local plate = Kit.new("Frame", {
			BackgroundColor3 = P.NavyDeep,
			BorderSizePixel = 0,
			Size = UDim2.new(0.36, 0, 1, -66),
			Parent = card,
		})
		Kit.corner().Parent = plate
		Kit.stroke(C.AccentDeep, 1, 0.6).Parent = plate
		local artArea = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.86, 0.7),
			Parent = plate,
		})
		Evidence.art(def.kind, artArea)

		-- right: words
		local right = Kit.new("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0.36, 22, 0, 0),
			Size = UDim2.new(0.64, -22, 1, -66),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = C.AccentDeep,
			Parent = card,
		})
		Kit.list(Enum.FillDirection.Vertical, 8).Parent = right
		Kit.text({
			Text = KIND_LABEL[def.kind] or "EVIDENCE",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.Accent,
			Size = UDim2.new(1, -8, 0, 16),
			LayoutOrder = 1,
			Parent = right,
		})
		Kit.text({
			Text = def.name,
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Title - 4,
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = right,
		})
		Kit.text({
			Text = def.summary,
			FontFace = Theme.Fonts.SerifItalic,
			TextSize = Theme.Text.Small,
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			Parent = right,
		})
		for i, line in def.details do
			local row = Kit.new("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 10 + i,
				Parent = right,
			})
			Kit.new("Frame", {
				BackgroundColor3 = C.AccentDeep,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(2, 9),
				Size = UDim2.fromOffset(6, 6),
				Parent = row,
			})
			Kit.text({
				Text = line,
				FontFace = Theme.Fonts.Body,
				TextSize = Theme.Text.Small + 1,
				Position = UDim2.fromOffset(18, 0),
				Size = UDim2.new(1, -18, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = row,
			})
		end
		if def.keyDetail then
			local key = Kit.new("Frame", {
				BackgroundColor3 = P.Brass,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 50,
				Parent = right,
			})
			Kit.corner(Theme.RadiusSmall).Parent = key
			Kit.stroke(C.Accent, 1, 0.3).Parent = key
			Kit.padding(10, 14).Parent = key
			Kit.list(Enum.FillDirection.Vertical, 4).Parent = key
			Kit.text({
				Text = "KEY DETAIL",
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Tiny,
				TextColor3 = C.Accent,
				Size = UDim2.new(1, 0, 0, 14),
				LayoutOrder = 1,
				Parent = key,
			})
			Kit.text({
				Text = def.keyDetail,
				FontFace = Theme.Fonts.BodyBold,
				TextSize = Theme.Text.Small + 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 2,
				Parent = key,
			})
		end

		local footer = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 54),
			Parent = card,
		})
		Kit.list(
			Enum.FillDirection.Horizontal,
			12,
			Enum.HorizontalAlignment.Right,
			Enum.VerticalAlignment.Center
		).Parent =
			footer

		local function close(result: string)
			Kit.tween(scrim, 0.15, { BackgroundTransparency = 1 })
			local t =
				Kit.tween(card, 0.15, { Position = UDim2.new(0.5, 0, 0.5, 18), BackgroundTransparency = 1 })
			t.Completed:Connect(function()
				layer:Destroy()
				resolve(result)
			end)
		end
		Kit.button({
			text = "Close",
			style = "secondary",
			size = UDim2.fromOffset(150, Theme.TouchHeight),
			layoutOrder = 1,
			parent = footer,
			onClick = function()
				close("close")
			end,
		})
		local extra: { { id: string, text: string } } = actions or {}
		for i, action in extra do
			Kit.button({
				text = action.text,
				style = "primary",
				size = UDim2.fromOffset(190, Theme.TouchHeight),
				layoutOrder = 1 + i,
				parent = footer,
				onClick = function()
					close(action.id)
				end,
			})
		end
		return nil
	end)
end

----------------------------------------------------------------- review
-- Show items; the player must open each one before continuing.
function Evidence.review(defs: { Def }, prompt: string?)
	return Kit.await(function(resolve)
		local layer, grid, footer = modalShell("Evidence Review", prompt or "Tap each item to inspect it.")
		local opened: { [string]: boolean } = {}
		local count = 0
		local continueButton: TextButton
		local progress = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Small,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromOffset(200, Theme.TouchHeight),
			LayoutOrder = 0,
			Parent = footer,
		})
		local function refresh()
			progress.Text = ("%d of %d inspected"):format(count, #defs)
			Kit.setEnabled(continueButton, count >= #defs)
		end
		continueButton = Kit.button({
			text = "Continue",
			style = "primary",
			size = UDim2.fromOffset(180, Theme.TouchHeight),
			layoutOrder = 1,
			parent = footer,
			onClick = function()
				if count >= #defs then
					sounds.confirm()
					layer:Destroy()
					resolve()
				end
			end,
		})
		for i, def in defs do
			local card = makeCard(def, grid, i)
			local hint = badge(card, "?", P.Ivory)
			card.Activated:Connect(function()
				Evidence.inspect(def)
				if not opened[def.id] then
					opened[def.id] = true
					count += 1
					hint:Destroy()
					badge(card, "✓", P.Success)
					refresh()
				end
			end)
		end
		refresh()
		return nil
	end)
end

----------------------------------------------------------------- picker
export type PickOptions = {
	title: string,
	prompt: string?,
	count: number, -- 1 to present, 2 to combine
	confirmText: string,
	cancellable: boolean?,
}

-- Returns a list of chosen ids, or nil if cancelled.
function Evidence.pick(inventory: { Def }, opts: PickOptions): { string }?
	return Kit.await(function(resolve)
		local layer, grid, footer = modalShell(opts.title, opts.prompt)
		local selected: { string } = {}
		local cards: { [string]: TextButton } = {}
		local confirm: TextButton

		local function refresh()
			for id, card in cards do
				local index = table.find(selected, id)
				setSelected(card, index ~= nil)
				local existing = card:FindFirstChild("Badge")
				if existing then
					existing:Destroy()
				end
				if index and opts.count > 1 then
					badge(card, tostring(index), P.Gold)
				end
			end
			Kit.setEnabled(confirm, #selected == opts.count)
		end

		if opts.cancellable then
			Kit.button({
				text = "Back",
				style = "secondary",
				size = UDim2.fromOffset(140, Theme.TouchHeight),
				layoutOrder = 1,
				parent = footer,
				onClick = function()
					layer:Destroy()
					resolve(nil)
				end,
			})
		end
		confirm = Kit.button({
			text = opts.confirmText,
			style = "primary",
			size = UDim2.fromOffset(200, Theme.TouchHeight),
			layoutOrder = 2,
			parent = footer,
			onClick = function()
				if #selected == opts.count then
					layer:Destroy()
					resolve(table.clone(selected))
				end
			end,
		})

		for i, def in inventory do
			local card = makeCard(def, grid, i)
			cards[def.id] = card
			infoButton(card, function()
				Evidence.inspect(def)
			end)
			card.Activated:Connect(function()
				sounds.page()
				local index = table.find(selected, def.id)
				if index then
					table.remove(selected, index)
				elseif opts.count == 1 then
					selected = { def.id }
				elseif #selected < opts.count then
					table.insert(selected, def.id)
				else
					table.remove(selected, 1)
					table.insert(selected, def.id)
				end
				refresh()
			end)
		end
		refresh()
		return nil
	end)
end

----------------------------------------------------------------- order (Case 3)
-- Tap exhibits in sequence. Returns ordered ids.
function Evidence.order(items: { Def }, prompt: string): { string }
	return Kit.await(function(resolve)
		local layer, grid, footer = modalShell("Present in Order", prompt)
		local sequence: { string } = {}
		local cards: { [string]: TextButton } = {}
		local submit: TextButton

		local strip = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Small,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0, 360, 0, Theme.TouchHeight),
			LayoutOrder = 0,
			Parent = footer,
		})

		local function refresh()
			for id, card in cards do
				local index = table.find(sequence, id)
				setSelected(card, index ~= nil)
				local existing = card:FindFirstChild("Badge")
				if existing then
					existing:Destroy()
				end
				if index then
					badge(card, tostring(index), P.Gold)
				end
			end
			strip.Text = ("%d of %d placed — tap a card again to remove it"):format(#sequence, #items)
			Kit.setEnabled(submit, #sequence == #items)
		end

		Kit.button({
			text = "Reset",
			style = "secondary",
			size = UDim2.fromOffset(120, Theme.TouchHeight),
			layoutOrder = 1,
			parent = footer,
			onClick = function()
				table.clear(sequence)
				refresh()
			end,
		})
		submit = Kit.button({
			text = "Present",
			style = "primary",
			size = UDim2.fromOffset(170, Theme.TouchHeight),
			layoutOrder = 2,
			parent = footer,
			onClick = function()
				if #sequence == #items then
					layer:Destroy()
					resolve(table.clone(sequence))
				end
			end,
		})

		for i, def in items do
			local card = makeCard(def, grid, i)
			cards[def.id] = card
			infoButton(card, function()
				Evidence.inspect(def)
			end)
			card.Activated:Connect(function()
				sounds.page()
				local index = table.find(sequence, def.id)
				if index then
					-- remove this card and everything placed after it
					for j = #sequence, index, -1 do
						table.remove(sequence, j)
					end
				else
					table.insert(sequence, def.id)
				end
				refresh()
			end)
		end
		refresh()
		return nil
	end)
end

----------------------------------------------------------------- case file
-- Read-only browser of everything the player holds. Opens above the current step.
function Evidence.caseFile(inventory: { Def })
	return Kit.await(function(resolve)
		local layer, grid, footer = modalShell(
			"Case File",
			if #inventory == 0 then "No evidence yet." else "Tap an item to read it.",
			Root.popup
		)
		Kit.button({
			text = "Close",
			style = "secondary",
			size = UDim2.fromOffset(160, Theme.TouchHeight),
			parent = footer,
			onClick = function()
				layer:Destroy()
				resolve()
			end,
		})
		for i, def in inventory do
			local card = makeCard(def, grid, i)
			card.Activated:Connect(function()
				Evidence.inspect(def)
			end)
		end
		return nil
	end)
end

return Evidence
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Feedback</string>
              <string name="Source"><![CDATA[--[[
	Feedback — every "you did something" moment: toasts, the objection stamp,
	new-evidence cards and the verdict banner.
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Feedback = {}

local C = Theme.Colors
local toastQueue = 0

export type ToastKind = "success" | "danger" | "info" | "warning"

function Feedback.toast(text: string, kind: ToastKind?, duration: number?)
	local accent = C.Accent
	if kind == "success" then
		accent = C.Success
	elseif kind == "danger" then
		accent = C.Danger
	elseif kind == "warning" then
		accent = Color3.fromRGB(214, 160, 90)
	end
	toastQueue += 1
	local offset = 72 + ((toastQueue - 1) % 3) * 58
	local toast = Kit.panel({
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, offset - 12),
		Size = UDim2.new(0, 0, 0, 46),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Parent = Root.toast,
	})
	local stroke = toast:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Color = accent
	stroke.Transparency = 1
	Kit.padding(0, 18, 0, 18).Parent = toast
	local bar = Kit.new("Frame", {
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 0, 22),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundTransparency = 1,
		Parent = toast,
	})
	Kit.corner(UDim.new(0, 2)).Parent = bar
	local label = Kit.text({
		Text = text,
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Small + 1,
		TextTransparency = 1,
		TextWrapped = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Position = UDim2.new(0, 14, 0, 0),
		Parent = toast,
	})
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(720, 46), Parent = toast })
	Kit.tween(
		toast,
		0.25,
		{ Position = UDim2.new(0.5, 0, 0, offset), BackgroundTransparency = Theme.PanelTransparency }
	)
	Kit.tween(stroke, 0.25, { Transparency = 0.3 })
	Kit.tween(bar, 0.25, { BackgroundTransparency = 0 })
	Kit.tween(label, 0.25, { TextTransparency = 0 })
	task.delay(duration or 2.4, function()
		Kit.tween(toast, 0.3, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, offset - 8) })
		Kit.tween(stroke, 0.3, { Transparency = 1 })
		Kit.tween(bar, 0.3, { BackgroundTransparency = 1 })
		local t = Kit.tween(label, 0.3, { TextTransparency = 1 })
		t.Completed:Wait()
		toast:Destroy()
		toastQueue = math.max(0, toastQueue - 1)
	end)
end

-- Big brass stamp across the screen. Yields ~1.3s.
function Feedback.objection(word: string?, sub: string?)
	local layer = Kit.new("Frame", {
		Name = "Objection",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Parent = Root.overlay,
	})
	local flash = Kit.new("Frame", {
		BackgroundColor3 = C.Paper,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Parent = layer,
	})
	local band = Kit.new("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1.4, 0, 0, 0),
		Rotation = -4,
		ZIndex = 41,
		Parent = layer,
	})
	for _, y in { 0, 1 } do
		Kit.new("Frame", {
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0, 3),
			ZIndex = 42,
			Parent = band,
		})
	end
	local word_ = Kit.text({
		Text = word or "OBJECTION!",
		FontFace = Theme.Fonts.Display,
		TextSize = 84,
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, if sub then -12 else 0),
		Size = UDim2.new(1, 0, 0, 100),
		Rotation = -4,
		ZIndex = 43,
		Parent = layer,
	})
	Kit.new("UIStroke", { Color = C.Scrim, Thickness = 3, Parent = word_ })
	local scale = Kit.new("UIScale", { Scale = 2.2, Parent = word_ })
	local subLabel = sub
		and Kit.text({
			Text = sub,
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Body,
			TextColor3 = C.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 52),
			Size = UDim2.new(1, 0, 0, 30),
			Rotation = -4,
			TextTransparency = 1,
			ZIndex = 43,
			Parent = layer,
		})

	Kit.tween(flash, 0.35, { BackgroundTransparency = 1 })
	Kit.tween(band, 0.22, { Size = UDim2.new(1.4, 0, 0, 170) }, Enum.EasingStyle.Back)
	Kit.tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	if subLabel then
		Kit.tween(subLabel, 0.3, { TextTransparency = 0 })
	end
	task.wait(1.15)
	Kit.tween(band, 0.25, { BackgroundTransparency = 1 })
	Kit.tween(word_, 0.25, { TextTransparency = 1 })
	if subLabel then
		Kit.tween(subLabel, 0.25, { TextTransparency = 1 })
	end
	for _, d in band:GetChildren() do
		if d:IsA("Frame") then
			Kit.tween(d, 0.25, { BackgroundTransparency = 1 })
		end
	end
	local stroke = word_:FindFirstChildOfClass("UIStroke")
	if stroke then
		Kit.tween(stroke, 0.25, { Transparency = 1 })
	end
	task.wait(0.27)
	layer:Destroy()
end

-- "Added to case file" card sliding in from the right. Non-blocking.
function Feedback.evidenceGained(name: string, label: string?)
	local card = Kit.panel({
		Name = "Gained",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 300, 0, 72),
		Size = UDim2.new(0, 280, 0, 64),
		Parent = Root.toast,
	})
	Kit.padding(10, 14).Parent = card
	Kit.text({
		Text = label or "ADDED TO CASE FILE",
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.Accent,
		Size = UDim2.new(1, 0, 0, 16),
		Parent = card,
	})
	Kit.text({
		Text = name,
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Body,
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	Kit.tween(card, 0.35, { Position = UDim2.new(1, -16, 0, 72) }, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		local t = Kit.tween(
			card,
			0.3,
			{ Position = UDim2.new(1, 300, 0, 72) },
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		)
		t.Completed:Wait()
		card:Destroy()
	end)
end

-- Full-screen verdict. Yields until the player taps.
function Feedback.verdict(title: string, subtitle: string?, onShow: (() -> ())?)
	return Kit.await(function(resolve)
		local layer = Kit.new("TextButton", {
			Name = "Verdict",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Scrim,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 30,
			Parent = Root.overlay,
		})
		local eyebrow = Kit.text({
			Text = "THE COURT RULES",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Small,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, -78),
			TextTransparency = 1,
			ZIndex = 31,
			Parent = layer,
		})
		local rules = {}
		for _, y in { -52, 62 } do
			table.insert(
				rules,
				Kit.new("Frame", {
					BackgroundColor3 = C.Accent,
					BorderSizePixel = 0,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0.5, y),
					Size = UDim2.new(0, 0, 0, 1),
					ZIndex = 31,
					Parent = layer,
				})
			)
		end
		local big = Kit.text({
			Text = title,
			FontFace = Theme.Fonts.Display,
			TextSize = 52,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(1, -60, 0, 70),
			TextTransparency = 1,
			ZIndex = 31,
			Parent = layer,
		})
		local small = Kit.text({
			Text = subtitle or "",
			FontFace = Theme.Fonts.SerifItalic,
			TextSize = Theme.Text.Body,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 40),
			Size = UDim2.new(1, -60, 0, 30),
			TextTransparency = 1,
			ZIndex = 31,
			Parent = layer,
		})
		local hint = Kit.text({
			Text = "TAP TO CONTINUE",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -30),
			TextTransparency = 1,
			ZIndex = 31,
			Parent = layer,
		})

		Kit.tween(layer, 0.5, { BackgroundTransparency = 0.2 })
		if onShow then
			task.delay(0.35, onShow)
		end
		task.delay(0.3, function()
			Kit.tween(eyebrow, 0.4, { TextTransparency = 0 })
			for _, r in rules do
				Kit.tween(r, 0.7, { Size = UDim2.new(0, 420, 0, 1) }, Enum.EasingStyle.Quart)
			end
			local s = Kit.new("UIScale", { Scale = 1.25, Parent = big })
			Kit.tween(s, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			Kit.tween(big, 0.4, { TextTransparency = 0 })
			task.wait(0.35)
			Kit.tween(small, 0.4, { TextTransparency = 0 })
			task.wait(0.6)
			Kit.tween(hint, 0.4, { TextTransparency = 0.2 })
		end)

		local ready = false
		task.delay(1.2, function()
			ready = true
		end)
		layer.Activated:Connect(function()
			if not ready then
				return
			end
			ready = false
			local t = Kit.tween(layer, 0.35, { BackgroundTransparency = 1 })
			for _, label in { eyebrow, big, small, hint } do
				Kit.tween(label, 0.3, { TextTransparency = 1 })
			end
			for _, r in rules do
				Kit.tween(r, 0.3, { BackgroundTransparency = 1 })
			end
			t.Completed:Connect(function()
				layer:Destroy()
				resolve()
			end)
		end)
		return nil
	end)
end

return Feedback
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud — the in-case heads-up display: case title + current objective (top
	centre) and the Case File / Pause buttons (top right).
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Hud = {}

local C = Theme.Colors

local frame: Frame? = nil
local objectiveLabel: TextLabel? = nil
local fileButton: TextButton? = nil
local objectivePanel: Frame? = nil

export type Callbacks = { onCaseFile: () -> (), onPause: () -> () }

function Hud.show(caseTitle: string, callbacks: Callbacks)
	Hud.hide()
	local root = Kit.new("Frame", {
		Name = "Hud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = Root.hud,
	})
	frame = root

	local panel = Kit.panel({
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -70),
		Size = UDim2.fromOffset(0, 54),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = root,
	})
	objectivePanel = panel
	Kit.new(
		"UISizeConstraint",
		{ MinSize = Vector2.new(300, 54), MaxSize = Vector2.new(560, 54), Parent = panel }
	)
	Kit.padding(7, 20).Parent = panel
	Kit.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center).Parent = panel
	Kit.text({
		Text = string.upper(caseTitle),
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 15),
		LayoutOrder = 1,
		Parent = panel,
	})
	objectiveLabel = Kit.text({
		Text = "",
		FontFace = Theme.Fonts.BodyBold,
		TextSize = Theme.Text.Small + 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		LayoutOrder = 2,
		Parent = panel,
	})
	Kit.tween(panel, 0.4, { Position = UDim2.new(0.5, 0, 0, 12) }, Enum.EasingStyle.Quart)

	local buttons = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(260, 50),
		Parent = root,
	})
	Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right).Parent = buttons
	fileButton = Kit.button({
		text = "Case File",
		style = "secondary",
		textSize = Theme.Text.Small,
		size = UDim2.fromOffset(150, 50),
		layoutOrder = 1,
		parent = buttons,
		onClick = callbacks.onCaseFile,
	})
	Kit.button({
		text = "II",
		style = "secondary",
		font = Theme.Fonts.BodyBold,
		textSize = Theme.Text.Small,
		size = UDim2.fromOffset(50, 50),
		layoutOrder = 2,
		parent = buttons,
		onClick = callbacks.onPause,
	})
end

function Hud.setObjective(text: string)
	local label = objectiveLabel
	local panel = objectivePanel
	if not label or not panel then
		return
	end
	if label.Text == text then
		return
	end
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	label.TextTransparency = 1
	label.Text = text
	Kit.tween(label, 0.35, { TextTransparency = 0 })
	if stroke then
		stroke.Color = C.Accent
		stroke.Transparency = 0
		Kit.tween(stroke, 1.2, { Transparency = 0.55, Color = C.AccentDeep })
	end
end

function Hud.setEvidenceCount(n: number)
	if fileButton then
		fileButton.Text = if n > 0 then ("Case File  ·  %d"):format(n) else "Case File"
	end
end

function Hud.setVisible(visible: boolean)
	if frame then
		frame.Visible = visible
	end
end

function Hud.hide()
	if frame then
		frame:Destroy()
	end
	frame, objectiveLabel, fileButton, objectivePanel = nil, nil, nil, nil
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Interview</string>
              <string name="Source"><![CDATA[--[[
	Interview — pick topics to ask about. Each topic plays a short exchange.
	All topics must be heard before moving on (they hold the clues).
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Interview = {}

local C = Theme.Colors

function Interview.run(step, playLines: ({ any }) -> (), onMenu: (() -> ())?)
	local asked: { [number]: boolean } = {}
	local total = #step.topics
	while true do
		if onMenu then
			onMenu()
		end
		local choice = Kit.await(function(resolve)
			local layer = Kit.new("Frame", {
				Name = "Interview",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = Root.modal,
			})
			local card = Kit.panel({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 20, 0.5, 20),
				Size = UDim2.fromOffset(360, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = layer,
			})
			Kit.padding(18, 20).Parent = card
			Kit.list(Enum.FillDirection.Vertical, 10).Parent = card
			Kit.text({
				Text = string.upper(step.prompt or "Ask about…"),
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Tiny + 1,
				TextColor3 = C.Accent,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = 0,
				Parent = card,
			})
			local count = 0
			for i, topic in step.topics do
				local done = asked[i] == true
				if done then
					count += 1
				end
				local b = Kit.button({
					text = (if done then "✓  " else "") .. topic.label,
					style = if done then "ghost" else "paper",
					align = Enum.TextXAlignment.Left,
					size = UDim2.new(1, 0, 0, Theme.TouchHeight - 4),
					layoutOrder = i,
					parent = card,
					onClick = function()
						layer:Destroy()
						resolve(i)
					end,
				})
				Kit.padding(0, 16).Parent = b
			end
			local finished = count >= total
			local cont = Kit.button({
				text = if finished then "Continue" else ("%d of %d topics"):format(count, total),
				style = "primary",
				size = UDim2.new(1, 0, 0, Theme.TouchHeight),
				layoutOrder = 100,
				parent = card,
				onClick = function()
					if finished then
						layer:Destroy()
						resolve(0)
					end
				end,
			})
			Kit.setEnabled(cont, finished)
			Kit.tween(card, 0.3, { Position = UDim2.new(1, -20, 0.5, 0) }, Enum.EasingStyle.Quart)
			return nil
		end)
		if choice == 0 then
			return
		end
		playLines(step.topics[choice].lines)
		asked[choice] = true
	end
end

return Interview
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Kit — tiny helpers for building UI in code: instance creation, tweens,
	buttons with press feedback, and a safe "await" for yielding UI flows.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Kit = {}

local C = Theme.Colors

-- Create an instance: Kit.new("Frame", { Size = ..., Parent = ... }, { children })
function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(radius: UDim?): UICorner
	return Kit.new("UICorner", { CornerRadius = radius or Theme.Radius })
end

function Kit.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or C.AccentDeep,
		Thickness = thickness or 1,
		Transparency = transparency or 0.45,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.padding(top: number, right: number?, bottom: number?, left: number?): UIPadding
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
	})
end

function Kit.list(
	direction: Enum.FillDirection?,
	padding: number?,
	halign: Enum.HorizontalAlignment?,
	valign: Enum.VerticalAlignment?
): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.tween(
	inst: Instance,
	time: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	dir: Enum.EasingDirection?
): Tween
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- A text label with sensible defaults.
function Kit.text(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Theme.Fonts.Body,
		TextColor3 = C.Text,
		TextSize = Theme.Text.Body,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for k, v in props do
		defaults[k] = v
	end
	return Kit.new("TextLabel", defaults)
end

-- Panel: dark navy card with a fine brass edge.
function Kit.panel(props: { [string]: any }): Frame
	local defaults = {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		BorderSizePixel = 0,
	}
	for k, v in props do
		defaults[k] = v
	end
	local frame = Kit.new("Frame", defaults)
	Kit.corner().Parent = frame
	Kit.stroke(C.AccentDeep, 1, 0.55).Parent = frame
	return frame
end

-- Full-screen click-blocker behind modals.
function Kit.scrim(parent: Instance, transparency: number?): TextButton
	return Kit.new("TextButton", {
		Name = "Scrim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Scrim,
		BackgroundTransparency = transparency or 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
end

local clickSound: (() -> ())? = nil
function Kit.setClickSound(fn: () -> ())
	clickSound = fn
end

export type ButtonStyle = "primary" | "secondary" | "ghost" | "paper"

--[[
	Kit.button({ text, style, size, position, anchor, onClick, textSize, layoutOrder })
	Touch-friendly, with a gentle press animation.
]]
function Kit.button(opts: { [string]: any }): TextButton
	local style: ButtonStyle = opts.style or "primary"
	local bg, fg, strokeColor, strokeT = C.AccentDeep, C.Panel, C.Accent, 0.2
	if style == "secondary" then
		bg, fg, strokeColor, strokeT = C.PanelSoft, C.Text, C.AccentDeep, 0.35
	elseif style == "ghost" then
		bg, fg, strokeColor, strokeT = C.Panel, C.TextDim, C.AccentDeep, 0.6
	elseif style == "paper" then
		bg, fg, strokeColor, strokeT = C.Paper, C.Ink, C.AccentDeep, 0.5
	end
	local button = Kit.new("TextButton", {
		Name = opts.name or "Button",
		Text = opts.text or "",
		FontFace = opts.font or Theme.Fonts.Label,
		TextSize = opts.textSize or Theme.Text.Body,
		TextColor3 = fg,
		TextWrapped = true,
		AutoButtonColor = false,
		BackgroundColor3 = bg,
		BackgroundTransparency = if style == "ghost" then 0.35 else 0,
		BorderSizePixel = 0,
		Size = opts.size or UDim2.new(0, 220, 0, Theme.TouchHeight),
		Position = opts.position or UDim2.new(),
		AnchorPoint = opts.anchor or Vector2.zero,
		LayoutOrder = opts.layoutOrder or 0,
		TextXAlignment = opts.align or Enum.TextXAlignment.Center,
		Parent = opts.parent,
	})
	Kit.corner(Theme.RadiusSmall).Parent = button
	Kit.stroke(strokeColor, 1, strokeT).Parent = button
	local scale = Kit.new("UIScale", { Parent = button })

	local enabled = true
	button:SetAttribute("Enabled", true)
	button.MouseButton1Down:Connect(function()
		if enabled then
			Kit.tween(scale, 0.08, { Scale = 0.96 })
		end
	end)
	local function release()
		Kit.tween(scale, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	button.Activated:Connect(function()
		if not enabled then
			return
		end
		if clickSound then
			clickSound()
		end
		if opts.onClick then
			opts.onClick()
		end
	end)
	button:GetAttributeChangedSignal("Enabled"):Connect(function()
		enabled = button:GetAttribute("Enabled") == true
		button.BackgroundTransparency = if enabled then (if style == "ghost" then 0.35 else 0) else 0.6
		button.TextTransparency = if enabled then 0 else 0.5
	end)
	return button
end

function Kit.setEnabled(button: GuiButton, enabled: boolean)
	button:SetAttribute("Enabled", enabled)
end

--[[
	Kit.await(setup) — yield the current thread until `resolve(...)` is called.
	`setup(resolve)` builds the UI and may return a cleanup function.
	Safe if the waiting thread is cancelled (e.g. quitting a case mid-step).
]]
function Kit.await(setup: ((...any) -> ()) -> (() -> ())?): ...any
	local thread = coroutine.running()
	local done = false
	local cleanup: (() -> ())? = nil
	local function resolve(...: any)
		if done then
			return
		end
		done = true
		if cleanup then
			cleanup()
			cleanup = nil
		end
		local args = table.pack(...)
		task.defer(function()
			if coroutine.status(thread) == "suspended" then
				task.spawn(thread, table.unpack(args, 1, args.n))
			end
		end)
	end
	cleanup = setup(resolve)
	if done and cleanup then
		cleanup()
		cleanup = nil
	end
	return coroutine.yield()
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">LobbyHud</string>
              <string name="Source"><![CDATA[--[[
	LobbyHud — the small overlay while walking around Valence Legal.
	Returns "cases" (open the case files) or "menu" (back to the title screen).
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local LobbyHud = {}

local C = Theme.Colors

function LobbyHud.run(profile, onPrompt: (() -> ()) -> RBXScriptConnection?): string
	return Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "LobbyHud",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.hud,
		})
		local function finish(result: string)
			layer:Destroy()
			resolve(result)
		end

		local buttons = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 12),
			Size = UDim2.fromOffset(340, 50),
			Parent = layer,
		})
		Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right).Parent = buttons
		Kit.button({
			text = "Case Files",
			style = "primary",
			textSize = Theme.Text.Small,
			size = UDim2.fromOffset(160, 50),
			layoutOrder = 1,
			parent = buttons,
			onClick = function()
				finish("cases")
			end,
		})
		Kit.button({
			text = "Menu",
			style = "secondary",
			textSize = Theme.Text.Small,
			size = UDim2.fromOffset(110, 50),
			layoutOrder = 2,
			parent = buttons,
			onClick = function()
				finish("menu")
			end,
		})

		local badge = Kit.panel({
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.new(0, 14, 0, 12),
			Size = UDim2.fromOffset(0, 50),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = layer,
		})
		Kit.padding(6, 16).Parent = badge
		Kit.text({
			Text = string.upper(profile.title),
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.Accent,
			TextWrapped = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 16),
			Parent = badge,
		})
		Kit.text({
			Text = ("%d promotion points"):format(profile.points),
			FontFace = Theme.Fonts.BodyBold,
			TextSize = Theme.Text.Small,
			TextWrapped = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.fromOffset(0, 18),
			Size = UDim2.fromOffset(0, 20),
			Parent = badge,
		})

		local hint = Kit.text({
			Text = "Walk to the ACTIVE MATTERS board and tap it, or use Case Files.",
			FontFace = Theme.Fonts.Body,
			TextSize = Theme.Text.Small,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -18),
			Size = UDim2.new(1, -40, 0, 22),
			Parent = layer,
		})
		task.delay(7, function()
			if hint.Parent then
				Kit.tween(hint, 0.6, { TextTransparency = 1 })
			end
		end)

		local conn = onPrompt(function()
			finish("cases")
		end)
		return function()
			if conn then
				conn:Disconnect()
			end
		end
	end)
end

return LobbyHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">MainMenu</string>
              <string name="Source"><![CDATA[--[[
	MainMenu — the title screen and case selection.
	MainMenu.run(profile) yields until the player picks an unlocked case; returns its id.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CaseCatalog = require(Shared.CaseCatalog)

local MainMenu = {}

local C = Theme.Colors
local P = Theme.Palette

local function backdrop(): Frame
	local frame = Kit.new("Frame", {
		Name = "MenuBackdrop",
		BackgroundColor3 = P.NavyDeep,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = Root.backdropGui,
	})
	Kit.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.45, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = frame,
	})
	return frame
end

local function howToPlay(parent: Instance)
	Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = parent,
		})
		Kit.scrim(layer, 0.4)
		local card = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(560, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = layer,
		})
		Kit.padding(22, 26).Parent = card
		Kit.list(Enum.FillDirection.Vertical, 12).Parent = card
		Kit.text({
			Text = "How to play",
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Heading,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 1,
			Parent = card,
		})
		local tips = {
			{ "Tap", "anywhere to move dialogue along. Tap again to skip the typing." },
			{ "Read", "every exhibit — the key detail is highlighted for you." },
			{
				"Spot",
				"the lie: during testimony, flip through statements and Present the evidence that contradicts one.",
			},
			{ "Relax", "— wrong answers just cost points. You never have to restart a case." },
		}
		for i, tip in tips do
			Kit.text({
				Text = ('<font color="#CDAC70"><b>%s</b></font> %s'):format(tip[1], tip[2]),
				RichText = true,
				FontFace = Theme.Fonts.Body,
				TextSize = Theme.Text.Small + 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 1 + i,
				Parent = card,
			})
		end
		Kit.button({
			text = "Got it",
			style = "primary",
			size = UDim2.new(1, 0, 0, Theme.TouchHeight),
			layoutOrder = 20,
			parent = card,
			onClick = function()
				layer:Destroy()
				resolve()
			end,
		})
		return nil
	end)
end

local function caseCard(parent: Instance, caseId: string, state, order: number, onPlay: () -> ()): Frame
	local info = CaseCatalog.get(caseId)
	local unlocked = state and state.unlocked
	local best = state and state.best
	local card = Kit.panel({
		Name = caseId,
		Size = UDim2.fromOffset(264, 330),
		LayoutOrder = order,
		BackgroundColor3 = if unlocked then P.Navy else P.NavyDeep,
		Parent = parent,
	})
	Kit.padding(18).Parent = card
	local scale = Kit.new("UIScale", { Scale = 0.9, Parent = card })
	task.delay(0.08 * order, function()
		Kit.tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	Kit.text({
		Text = ("CASE %02d"):format(info.number),
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny + 1,
		TextColor3 = if unlocked then C.Accent else C.TextDim,
		Size = UDim2.new(1, -50, 0, 18),
		Parent = card,
	})
	Kit.text({
		Text = info.title,
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Heading + 2,
		TextColor3 = if unlocked then C.Text else C.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 62),
		Parent = card,
	})
	Kit.new("Frame", {
		BackgroundColor3 = C.AccentDeep,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.fromOffset(48, 2),
		Parent = card,
	})
	Kit.text({
		Text = if unlocked then info.blurb else "Win the previous case to unlock this matter.",
		FontFace = Theme.Fonts.Body,
		TextSize = Theme.Text.Small,
		TextColor3 = C.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(0, 104),
		Size = UDim2.new(1, 0, 0, 80),
		Parent = card,
	})
	Kit.text({
		Text = if unlocked then ("Client: %s  ·  %s"):format(info.client, info.minutes) else "",
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.TextDim,
		Position = UDim2.fromOffset(0, 190),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = card,
	})
	if best then
		local medal = Kit.new("Frame", {
			BackgroundColor3 = P.NavyDeep,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, -4),
			Size = UDim2.fromOffset(42, 42),
			Parent = card,
		})
		Kit.corner(UDim.new(1, 0)).Parent = medal
		Kit.new("UIStroke", { Color = C.Accent, Thickness = 2, Parent = medal })
		Kit.text({
			Text = best.grade,
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Heading,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = medal,
		})
	elseif not unlocked then
		Kit.text({
			Text = "LOCKED",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(80, 18),
			Parent = card,
		})
	end
	local play = Kit.button({
		text = if not unlocked then "Locked" elseif best then "Replay" else "Begin",
		style = if best then "secondary" else "primary",
		size = UDim2.new(1, 0, 0, Theme.TouchHeight),
		anchor = Vector2.new(0, 1),
		position = UDim2.fromScale(0, 1),
		parent = card,
		onClick = function()
			if unlocked then
				onPlay()
			end
		end,
	})
	Kit.setEnabled(play, unlocked == true)
	return card
end

export type Hooks = {
	onShow: () -> (),
	musicEnabled: (() -> boolean)?,
	onToggleMusic: (() -> boolean)?,
	startOnSelect: boolean?,
}

function MainMenu.run(profile, hooks: Hooks): string
	hooks.onShow()
	local back = backdrop()
	local result = Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "MainMenu",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.menu,
		})

		----------------------------------------------------------------- title page
		local title = Kit.new("Frame", {
			Name = "Title",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(56, 0),
			Size = UDim2.new(0, 460, 1, 0),
			Parent = layer,
		})
		Kit.list(
			Enum.FillDirection.Vertical,
			10,
			Enum.HorizontalAlignment.Left,
			Enum.VerticalAlignment.Center
		).Parent =
			title
		Kit.text({
			Text = "VALENCE LEGAL PRESENTS",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny + 1,
			TextColor3 = C.Accent,
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = 1,
			Parent = title,
		})
		local heading = Kit.text({
			Text = "First Chair",
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Hero,
			Size = UDim2.new(1, 0, 0, 78),
			LayoutOrder = 2,
			TextTransparency = 1,
			Parent = title,
		})
		Kit.tween(heading, 0.9, { TextTransparency = 0 })
		local rule = Kit.new("Frame", {
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, 2),
			LayoutOrder = 3,
			Parent = title,
		})
		Kit.tween(rule, 0.9, { Size = UDim2.fromOffset(120, 2) }, Enum.EasingStyle.Quart)
		Kit.text({
			Text = "A courtroom drama in three cases. Find the lie. Win the room.",
			FontFace = Theme.Fonts.SerifItalic,
			TextSize = Theme.Text.Body - 1,
			TextColor3 = C.TextDim,
			Size = UDim2.new(1, 0, 0, 48),
			LayoutOrder = 4,
			Parent = title,
		})

		-- career card
		local career = Kit.panel({
			Size = UDim2.new(1, -60, 0, 74),
			LayoutOrder = 5,
			Parent = title,
		})
		Kit.padding(12, 16).Parent = career
		Kit.text({
			Text = "YOUR CAREER",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.Accent,
			Size = UDim2.new(1, 0, 0, 14),
			Parent = career,
		})
		Kit.text({
			Text = ("%s  ·  %d pts"):format(profile.title, profile.points),
			FontFace = Theme.Fonts.BodyBold,
			TextSize = Theme.Text.Body - 1,
			Position = UDim2.fromOffset(0, 16),
			Size = UDim2.new(1, 0, 0, 24),
			Parent = career,
		})
		local track = Kit.new("Frame", {
			BackgroundColor3 = P.NavySoft,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 44),
			Size = UDim2.new(1, 0, 0, 5),
			Parent = career,
		})
		Kit.corner(UDim.new(1, 0)).Parent = track
		local progress = if profile.nextPoints
			then math.clamp(profile.points / profile.nextPoints, 0, 1)
			else 1
		local fill = Kit.new("Frame", {
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(0, 1),
			Parent = track,
		})
		Kit.corner(UDim.new(1, 0)).Parent = fill
		Kit.tween(fill, 1.2, { Size = UDim2.fromScale(progress, 1) }, Enum.EasingStyle.Quart)

		local hasProgress = false
		for _, state in profile.cases do
			if state.best then
				hasProgress = true
			end
		end

		local buttons = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, Theme.TouchHeight),
			LayoutOrder = 6,
			Parent = title,
		})
		Kit.list(Enum.FillDirection.Horizontal, 12).Parent = buttons

		----------------------------------------------------------------- case select page
		local select = Kit.new("Frame", {
			Name = "CaseSelect",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			Parent = layer,
		})
		Kit.text({
			Text = "Choose a matter",
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Title,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 34),
			Size = UDim2.fromOffset(600, 40),
			Parent = select,
		})
		local cards = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 10),
			Size = UDim2.new(1, -40, 0, 340),
			Parent = select,
		})
		Kit.list(
			Enum.FillDirection.Horizontal,
			18,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		).Parent =
			cards
		Kit.button({
			text = "‹  Back",
			style = "ghost",
			size = UDim2.fromOffset(130, 48),
			position = UDim2.fromOffset(24, 24),
			parent = select,
			onClick = function()
				select.Visible = false
				title.Visible = true
				back.Visible = true
			end,
		})

		local function openSelect()
			title.Visible = false
			back.Visible = false
			select.Visible = true
			cards:ClearAllChildren()
			Kit.list(
				Enum.FillDirection.Horizontal,
				18,
				Enum.HorizontalAlignment.Center,
				Enum.VerticalAlignment.Center
			).Parent =
				cards
			for i, caseId in CaseCatalog.order do
				caseCard(cards, caseId, profile.cases[caseId], i, function()
					layer:Destroy()
					resolve(caseId)
				end)
			end
		end

		Kit.button({
			text = if hasProgress then "Continue" else "Start Game",
			style = "primary",
			size = UDim2.fromOffset(190, Theme.TouchHeight),
			layoutOrder = 1,
			parent = buttons,
			onClick = openSelect,
		})
		Kit.button({
			text = "Explore the Office",
			style = "secondary",
			size = UDim2.fromOffset(210, Theme.TouchHeight),
			layoutOrder = 2,
			parent = buttons,
			onClick = function()
				layer:Destroy()
				resolve("__lobby")
			end,
		})
		local row2 = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 44),
			LayoutOrder = 7,
			Parent = title,
		})
		Kit.list(Enum.FillDirection.Horizontal, 12).Parent = row2
		Kit.button({
			text = "How to Play",
			style = "ghost",
			textSize = Theme.Text.Small,
			size = UDim2.fromOffset(150, 44),
			layoutOrder = 1,
			parent = row2,
			onClick = function()
				howToPlay(layer)
			end,
		})
		if hooks.onToggleMusic then
			local musicButton: TextButton
			local function label(on: boolean)
				return if on then "Music: On" else "Music: Off"
			end
			musicButton = Kit.button({
				text = label(hooks.musicEnabled and hooks.musicEnabled() or true),
				style = "ghost",
				textSize = Theme.Text.Small,
				size = UDim2.fromOffset(150, 44),
				layoutOrder = 2,
				parent = row2,
				onClick = function()
					musicButton.Text = label((hooks.onToggleMusic :: () -> boolean)())
				end,
			})
		end
		if profile.streak and profile.streak >= 2 then
			Kit.text({
				Text = ("%d-day streak  ·  win a case today to keep it"):format(profile.streak),
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Tiny + 1,
				TextColor3 = C.Accent,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = 8,
				Parent = title,
			})
		end

		if profile.saving == false then
			Kit.text({
				Text = "Saving is unavailable right now — progress lasts until you leave.",
				FontFace = Theme.Fonts.Body,
				TextSize = Theme.Text.Tiny,
				TextColor3 = C.TextDim,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = 9,
				Parent = title,
			})
		end
		-- Chapter Two teaser under the case cards
		Kit.text({
			Text = "CHAPTER TWO  ·  THE SILENT PARTNER  ·  IN DEVELOPMENT",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -22),
			Size = UDim2.new(1, -40, 0, 18),
			Parent = select,
		})
		if hooks.startOnSelect then
			openSelect()
		end
		return nil
	end)
	back:Destroy()
	return result
end

return MainMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">PauseMenu</string>
              <string name="Source"><![CDATA[--[[
	PauseMenu — Resume / Restart case / Main menu. Returns the choice.
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local PauseMenu = {}

local C = Theme.Colors
local open = false

function PauseMenu.show(caseTitle: string, music: { enabled: () -> boolean, toggle: () -> boolean }?): string?
	if open then
		return nil
	end
	open = true
	local result = Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "Pause",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.popup,
		})
		Kit.scrim(layer, 0.35)
		local card = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(360, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = layer,
		})
		Kit.padding(22).Parent = card
		Kit.list(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = card
		Kit.text({
			Text = "PAUSED",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny + 1,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = 1,
			Parent = card,
		})
		Kit.text({
			Text = caseTitle,
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Heading,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 2,
			Parent = card,
		})
		local function option(text: string, id: string, style: string, order: number)
			Kit.button({
				text = text,
				style = style,
				size = UDim2.new(1, 0, 0, Theme.TouchHeight),
				layoutOrder = order,
				parent = card,
				onClick = function()
					layer:Destroy()
					resolve(id)
				end,
			})
		end
		option("Resume", "resume", "primary", 10)
		option("Restart Case", "restart", "secondary", 11)
		option("Main Menu", "menu", "ghost", 12)
		if music then
			local b: TextButton
			b = Kit.button({
				text = if music.enabled() then "Music: On" else "Music: Off",
				style = "ghost",
				size = UDim2.new(1, 0, 0, Theme.TouchHeight - 8),
				layoutOrder = 13,
				parent = card,
				onClick = function()
					b.Text = if music.toggle() then "Music: On" else "Music: Off"
				end,
			})
		end
		return nil
	end)
	open = false
	return result
end

return PauseMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[--[[
	Results — the "Case Closed" screen: grade medallion, animated score,
	promotion points, rank-ups and the next case unlocking.
	Returns "menu" | "replay" | "next".
]]

local RunService = game:GetService("RunService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local CaseCatalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").CaseCatalog)

local Results = {}

local C = Theme.Colors
local P = Theme.Palette

local GRADE_LINE = {
	S = "Flawless. Mara almost smiled.",
	A = "Excellent work, counsel.",
	B = "A solid win. Sharpen the edges.",
	C = "A win is a win. Barely.",
}

local function countUp(label: TextLabel, to: number, max: number, duration: number)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if not label.Parent then
			conn:Disconnect()
			return
		end
		local t = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = 1 - (1 - t) ^ 3
		label.Text = ("%d / %d"):format(math.floor(to * eased + 0.5), max)
		if t >= 1 then
			conn:Disconnect()
		end
	end)
end

local function stat(parent: Instance, title: string, value: string, order: number)
	local box = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(130, 52),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.text({
		Text = value,
		FontFace = Theme.Fonts.Display,
		TextSize = Theme.Text.Heading,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = box,
	})
	Kit.text({
		Text = title,
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Tiny,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = box,
	})
end

function Results.show(results, caseTitle: string, sounds: { gavel: () -> (), unlock: () -> () }): string
	return Kit.await(function(resolve)
		local layer = Kit.new("Frame", {
			Name = "Results",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 25,
			Parent = Root.overlay,
		})
		local scrim = Kit.scrim(layer, 1)
		scrim.ZIndex = 25
		Kit.tween(scrim, 0.4, { BackgroundTransparency = 0.25 })

		local card = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 30),
			Size = UDim2.fromOffset(640, 470),
			ZIndex = 26,
			Parent = layer,
		})
		Kit.padding(20, 28).Parent = card
		Kit.tween(card, 0.45, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Quart)

		local function t(props)
			props.ZIndex = 27
			props.Parent = props.Parent or card
			return Kit.text(props)
		end

		t({
			Text = "CASE CLOSED",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Small,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 18),
		})
		t({
			Text = caseTitle,
			FontFace = Theme.Fonts.Display,
			TextSize = Theme.Text.Title,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, 0, 0, 38),
		})

		-- grade medallion
		local medal = Kit.new("Frame", {
			BackgroundColor3 = P.NavyDeep,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 72),
			Size = UDim2.fromOffset(112, 112),
			ZIndex = 27,
			Parent = card,
		})
		Kit.corner(UDim.new(1, 0)).Parent = medal
		Kit.new("UIStroke", { Color = C.Accent, Thickness = 3, Parent = medal })
		local gradeLabel = Kit.text({
			Text = results.grade,
			FontFace = Theme.Fonts.Display,
			TextSize = 60,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 28,
			Parent = medal,
		})
		local medalScale = Kit.new("UIScale", { Scale = 0, Parent = medal })
		task.delay(0.35, function()
			sounds.gavel()
			Kit.tween(medalScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
		gradeLabel.Name = "Grade"

		t({
			Text = GRADE_LINE[results.grade] or "",
			FontFace = Theme.Fonts.SerifItalic,
			TextSize = Theme.Text.Small + 1,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 192),
			Size = UDim2.new(1, 0, 0, 22),
		})

		local score = t({
			Text = ("0 / %d"):format(results.maxScore),
			FontFace = Theme.Fonts.Display,
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 220),
			Size = UDim2.new(1, 0, 0, 40),
		})
		task.delay(0.5, function()
			countUp(score, results.score, results.maxScore, 1.2)
		end)

		local stats = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 266),
			Size = UDim2.new(1, 0, 0, 52),
			ZIndex = 27,
			Parent = card,
		})
		Kit.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = stats
		stat(stats, "ACCURACY", ("%d%%"):format(results.percent), 1)
		stat(stats, "MISTAKES", tostring(results.mistakes), 2)
		stat(stats, "FIRST-TRY", ("%d/%d"):format(results.perfectSteps, results.scoredSteps), 3)
		local profile = results.profile
		stat(stats, "PROMOTION PTS", ("+%d"):format(results.pointsEarned or 0), 4)
		for _, d in stats:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 27
			end
		end

		-- career line
		local career = if profile
			then ("%s  ·  %d promotion points"):format(profile.title, profile.points)
			else ""
		if results.rankUp then
			career = "PROMOTED — " .. results.rankUp
		end
		t({
			Text = career,
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Small,
			TextColor3 = if results.rankUp then C.Accent else C.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 326),
			Size = UDim2.new(1, 0, 0, 20),
		})
		if results.dailyBonus then
			t({
				Text = ("Daily bonus  +%d pts   ·   %d-day streak"):format(
					results.dailyBonus,
					results.streak or 1
				),
				FontFace = Theme.Fonts.Label,
				TextSize = Theme.Text.Tiny + 1,
				TextColor3 = C.Success,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(0, 346),
				Size = UDim2.new(1, 0, 0, 16),
			})
		end
		if results.saved == false then
			t({
				Text = "Progress couldn't be saved this session.",
				FontFace = Theme.Fonts.Body,
				TextSize = Theme.Text.Tiny,
				TextColor3 = C.Danger,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(0, 364),
				Size = UDim2.new(1, 0, 0, 16),
			})
		end

		-- buttons
		local footer = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, Theme.TouchHeight),
			ZIndex = 27,
			Parent = card,
		})
		Kit.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = footer
		local function choose(id: string)
			Kit.tween(scrim, 0.25, { BackgroundTransparency = 1 })
			local tw =
				Kit.tween(card, 0.25, { Position = UDim2.new(0.5, 0, 0.5, 30), BackgroundTransparency = 1 })
			tw.Completed:Connect(function()
				layer:Destroy()
				resolve(id)
			end)
		end
		local buttons = {
			Kit.button({
				text = "Replay",
				style = "secondary",
				size = UDim2.fromOffset(150, Theme.TouchHeight),
				layoutOrder = 1,
				parent = footer,
				onClick = function()
					choose("replay")
				end,
			}),
			Kit.button({
				text = "Main Menu",
				style = "secondary",
				size = UDim2.fromOffset(170, Theme.TouchHeight),
				layoutOrder = 2,
				parent = footer,
				onClick = function()
					choose("menu")
				end,
			}),
		}
		local index = CaseCatalog.indexOf(results.caseId)
		local nextId = index and CaseCatalog.order[index + 1]
		if nextId and profile and profile.cases[nextId] and profile.cases[nextId].unlocked then
			table.insert(
				buttons,
				Kit.button({
					text = "Next Case  ›",
					style = "primary",
					size = UDim2.fromOffset(190, Theme.TouchHeight),
					layoutOrder = 3,
					parent = footer,
					onClick = function()
						choose("next")
					end,
				})
			)
		end
		for _, b in buttons do
			b.ZIndex = 28
		end

		-- unlock ribbon
		if results.unlocked then
			local info = CaseCatalog.get(results.unlocked)
			local ribbon = Kit.new("Frame", {
				BackgroundColor3 = P.Brass,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0, -10),
				Size = UDim2.fromOffset(0, 46),
				ClipsDescendants = true,
				ZIndex = 29,
				Parent = card,
			})
			Kit.corner(Theme.RadiusSmall).Parent = ribbon
			Kit.text({
				Text = ("CASE %d UNLOCKED  ·  %s"):format(info.number, string.upper(info.title)),
				FontFace = Theme.Fonts.BodyBold,
				TextSize = Theme.Text.Small,
				TextColor3 = P.NavyDeep,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 30,
				Parent = ribbon,
			})
			task.delay(1.8, function()
				sounds.unlock()
				Kit.tween(ribbon, 0.6, { Size = UDim2.fromOffset(460, 46) }, Enum.EasingStyle.Back)
			end)
		end
		return nil
	end)
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--[[
	Root — the three ScreenGuis and the scaled 960×560 canvas everything sits on.

	  Backdrop (order 1)  full-bleed menu backdrop
	  Main     (order 5)  dialogue, HUD, modals, toasts (inside device safe area)
	  Overlay  (order 20) fades, objection, verdict, results

	Each GUI holds a "Canvas" frame sized in reference pixels and scaled with a
	UIScale, so layouts look the same on a phone, an iPad and a monitor.
]]

local Players = game:GetService("Players")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Root = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local canvases: { Frame } = {}
Root.scale = 1

local function makeGui(name: string, order: number, insets: Enum.ScreenInsets): (ScreenGui, Frame)
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local gui = Kit.new("ScreenGui", {
		Name = name,
		DisplayOrder = order,
		ResetOnSpawn = false,
		ScreenInsets = insets, -- (replaces the older IgnoreGuiInset flag)
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local canvas = Kit.new("Frame", {
		Name = "Canvas",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.zero,
		Position = UDim2.new(),
		Parent = gui,
	})
	Kit.new("UIScale", { Parent = canvas })
	table.insert(canvases, canvas)
	return gui, canvas
end

local function layer(parent: Instance, name: string, z: number): Frame
	return Kit.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z,
		Parent = parent,
	})
end

local function rescale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local ref = Theme.Reference
	local s = math.clamp(math.min(viewport.X / ref.X, viewport.Y / ref.Y), 0.5, 1.7)
	Root.scale = s
	for _, canvas in canvases do
		canvas.Size = UDim2.fromScale(1 / s, 1 / s)
		local uiScale = canvas:FindFirstChildOfClass("UIScale")
		if uiScale then
			uiScale.Scale = s
		end
	end
end

function Root.init()
	local backdropGui, backdrop = makeGui("FirstChair_Backdrop", 1, Enum.ScreenInsets.None)
	local mainGui, main = makeGui("FirstChair_Main", 5, Enum.ScreenInsets.DeviceSafeInsets)
	local overlayGui, overlay = makeGui("FirstChair_Overlay", 20, Enum.ScreenInsets.None)

	Root.backdropGui, Root.mainGui, Root.overlayGui = backdropGui, mainGui, overlayGui
	Root.backdrop = backdrop
	Root.menu = layer(main, "Menu", 1)
	-- Dialogue's tap-anywhere catcher sits *below* the HUD so Case File / Pause stay tappable.
	Root.dialogue = layer(main, "Dialogue", 2)
	Root.hud = layer(main, "Hud", 3)
	Root.modal = layer(main, "Modal", 4)
	Root.popup = layer(main, "Popup", 5)
	Root.toast = layer(main, "Toast", 6)
	Root.overlay = overlay

	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		rescale()
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end)
end

-- Remove everything a case put on screen (used when quitting or restarting).
function Root.clearCaseUi()
	for _, frame in { Root.dialogue, Root.modal, Root.popup } do
		frame:ClearAllChildren()
	end
end

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Testimony</string>
              <string name="Source"><![CDATA[--[[
	Testimony — cross-examination. Statements appear one at a time; the player
	can flip between them, PRESS for detail, or PRESENT evidence against one.

	Testimony.run(step, hooks) -> { statement, evidence }
	hooks.press(statementIndex)   plays the press conversation (yields)
	hooks.present(statementIndex) opens the evidence picker; returns id or nil
	hooks.onShow(statementIndex)  e.g. frame the witness
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Testimony = {}

local C = Theme.Colors

export type Hooks = {
	press: (number) -> (),
	present: (number) -> string?,
	onShow: ((number) -> ())?,
	start: number?,
}

function Testimony.run(step, hooks: Hooks): ({ statement: number, evidence: string }, number)
	return Kit.await(function(resolve)
		local statements = step.statements
		local index = math.clamp(hooks.start or 1, 1, #statements)
		local busy = false

		local layer = Kit.new("Frame", {
			Name = "Testimony",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = Root.modal,
		})

		local panel = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 40),
			Size = UDim2.new(1, -48, 0, 214),
			Parent = layer,
		})
		Kit.new("UISizeConstraint", { MaxSize = Vector2.new(900, 214), Parent = panel })
		Kit.padding(14, 22).Parent = panel

		local header = Kit.text({
			Text = string.upper(step.title or "Testimony"),
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny + 1,
			TextColor3 = C.Accent,
			Size = UDim2.new(1, -120, 0, 18),
			Parent = panel,
		})
		local counter = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.Label,
			TextSize = Theme.Text.Tiny + 1,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 120, 0, 18),
			Parent = panel,
		})
		header.Name = "Header"

		-- statement line with arrows either side
		local row = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 96),
			Parent = panel,
		})
		local quote = Kit.text({
			Text = "",
			FontFace = Theme.Fonts.Serif,
			TextSize = Theme.Text.Body + 2,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(64, 0),
			Size = UDim2.new(1, -128, 1, 0),
			Parent = row,
		})
		local dots = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 124),
			Size = UDim2.fromOffset(200, 8),
			Parent = panel,
		})
		Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center).Parent = dots
		local dotFrames = {}
		for i = 1, #statements do
			local d = Kit.new("Frame", {
				BackgroundColor3 = C.TextDim,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(8, 8),
				LayoutOrder = i,
				Parent = dots,
			})
			Kit.corner(UDim.new(1, 0)).Parent = d
			dotFrames[i] = d
		end

		local function show(i: number, direction: number?)
			index = i
			counter.Text = ("STATEMENT %d / %d"):format(i, #statements)
			quote.Text = "“" .. statements[i].text .. "”"
			for j, d in dotFrames do
				d.BackgroundColor3 = if j == i then C.Accent else C.TextDim
				d.BackgroundTransparency = if j == i then 0 else 0.5
			end
			quote.TextTransparency = 1
			quote.Position = UDim2.fromOffset(64 + (direction or 0) * 24, 0)
			Kit.tween(quote, 0.22, { TextTransparency = 0, Position = UDim2.fromOffset(64, 0) })
			if hooks.onShow then
				task.spawn(hooks.onShow, i)
			end
		end

		local function arrow(text: string, anchorX: number, delta: number)
			Kit.button({
				text = text,
				style = "secondary",
				textSize = 26,
				size = UDim2.fromOffset(54, 72),
				anchor = Vector2.new(anchorX, 0.5),
				position = UDim2.new(anchorX, 0, 0.5, 0),
				parent = row,
				onClick = function()
					if busy then
						return
					end
					local nextIndex = ((index - 1 + delta) % #statements) + 1
					show(nextIndex, delta)
				end,
			})
		end
		arrow("‹", 0, -1)
		arrow("›", 1, 1)

		local actions = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.new(1, 0, 0, Theme.TouchHeight),
			Parent = panel,
		})
		Kit.list(
			Enum.FillDirection.Horizontal,
			14,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		).Parent =
			actions

		local function hide(hidden: boolean)
			layer.Visible = not hidden
		end

		Kit.button({
			text = "Press",
			style = "secondary",
			size = UDim2.fromOffset(200, Theme.TouchHeight),
			layoutOrder = 1,
			parent = actions,
			onClick = function()
				if busy then
					return
				end
				busy = true
				hide(true)
				hooks.press(index)
				hide(false)
				busy = false
				show(index)
			end,
		})
		Kit.button({
			text = "Present Evidence",
			style = "primary",
			size = UDim2.fromOffset(240, Theme.TouchHeight),
			layoutOrder = 2,
			parent = actions,
			onClick = function()
				if busy then
					return
				end
				busy = true
				hide(true)
				local evidence = hooks.present(index)
				hide(false)
				busy = false
				if evidence then
					layer:Destroy()
					resolve({ statement = index, evidence = evidence }, index)
				end
			end,
		})

		Kit.tween(panel, 0.3, { Position = UDim2.new(0.5, 0, 1, -16) }, Enum.EasingStyle.Quart)
		show(index)
		return nil
	end)
end

return Testimony
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme — typography, colours and sizes for the interface.
	Reference canvas is 960 × 560; Root scales it to fit any phone, tablet or monitor.
]]

local Palette = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Palette)

local Theme = {}

Theme.Palette = Palette

Theme.Fonts = {
	Display = Font.new("rbxasset://fonts/families/Merriweather.json", Enum.FontWeight.Bold),
	Serif = Font.new("rbxasset://fonts/families/Merriweather.json", Enum.FontWeight.Regular),
	SerifItalic = Font.new(
		"rbxasset://fonts/families/Merriweather.json",
		Enum.FontWeight.Regular,
		Enum.FontStyle.Italic
	),
	Body = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Medium),
	BodyBold = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold),
	Label = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold),
	Mono = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular),
}

Theme.Colors = {
	Panel = Palette.NavyDeep,
	PanelSoft = Palette.Navy,
	Paper = Palette.Ivory,
	PaperDim = Palette.Cream,
	Ink = Palette.Espresso,
	InkSoft = Color3.fromRGB(96, 80, 68),
	Text = Palette.Ivory,
	TextDim = Color3.fromRGB(196, 188, 172),
	Accent = Palette.Gold,
	AccentDeep = Palette.Brass,
	Success = Palette.Success,
	Danger = Palette.Danger,
	Scrim = Color3.fromRGB(6, 9, 15),
}

Theme.Text = {
	Hero = 64,
	Title = 30,
	Heading = 22,
	Body = 19,
	Small = 15,
	Tiny = 12,
}

Theme.Radius = UDim.new(0, 10)
Theme.RadiusSmall = UDim.new(0, 6)
Theme.PanelTransparency = 0.06
Theme.TouchHeight = 54 -- minimum button height on the reference canvas

Theme.Reference = Vector2.new(960, 560)

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Transition</string>
              <string name="Source"><![CDATA[--[[
	Transition — quick fades and the elegant location title card.
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)

local Transition = {}

local C = Theme.Colors
local fade: Frame? = nil

local function fader(): Frame
	if fade and fade.Parent then
		return fade
	end
	-- Full-bleed: parented to the overlay GUI itself, outside the scaled canvas.
	fade = Kit.new("Frame", {
		Name = "Fade",
		BackgroundColor3 = C.Scrim,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = Root.overlayGui,
	})
	return fade :: Frame
end

function Transition.fadeOut(time: number?)
	local f = fader()
	f.Visible = true
	local t = Kit.tween(f, time or 0.3, { BackgroundTransparency = 0 })
	t.Completed:Wait()
end

function Transition.fadeIn(time: number?)
	local f = fader()
	local t = Kit.tween(f, time or 0.4, { BackgroundTransparency = 1 })
	t.Completed:Wait()
	f.Visible = false
end

-- "VALENCE LEGAL · NORTHBRIDGE" / "Monday · 9:02 AM" — non-blocking.
function Transition.locationCard(place: string, time: string?)
	local card = Kit.new("Frame", {
		Name = "LocationCard",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 36, 1, -210),
		Size = UDim2.new(0, 520, 0, 70),
		Parent = Root.popup,
	})
	local rule = Kit.new("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 0, 2),
		Position = UDim2.new(0, 0, 0, 34),
		Parent = card,
	})
	local title = Kit.text({
		Text = place,
		FontFace = Theme.Fonts.Label,
		TextSize = Theme.Text.Small,
		TextColor3 = C.Accent,
		TextTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = card,
	})
	local sub = Kit.text({
		Text = time or "",
		FontFace = Theme.Fonts.SerifItalic,
		TextSize = Theme.Text.Heading,
		TextColor3 = C.Text,
		TextTransparency = 1,
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = card,
	})
	for _, label in { title, sub } do
		local stroke =
			Kit.new("UIStroke", { Color = C.Scrim, Thickness = 1, Transparency = 0.5, Parent = label })
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
	Kit.tween(rule, 0.6, { Size = UDim2.new(0, 260, 0, 2) })
	Kit.tween(title, 0.5, { TextTransparency = 0 })
	task.delay(0.15, function()
		Kit.tween(sub, 0.5, { TextTransparency = 0 })
	end)
	task.delay(2.6, function()
		if not card.Parent then
			return
		end
		Kit.tween(rule, 0.5, { BackgroundTransparency = 1 })
		Kit.tween(title, 0.5, { TextTransparency = 1 })
		local t = Kit.tween(sub, 0.5, { TextTransparency = 1 })
		t.Completed:Wait()
		card:Destroy()
	end)
end

return Transition
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
