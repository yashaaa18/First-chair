  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	FIRST CHAIR — server entry point.
	Builds the world, starts saving + case services, and loads players' progress.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)
Net.init()

local World = require(script.World)
local Cast = require(script.World.Cast)
local DataService = require(script.DataService)
local CaseService = require(script.CaseService)
local LobbyService = require(script.LobbyService)

World.build()
Cast.build()
DataService.start()
CaseService.start()
LobbyService.start()

local function onPlayerAdded(player: Player)
	DataService.load(player)
	LobbyService.setupPlayer(player, CaseService.summary(player))
	if not DataService.isSaving(player) then
		local notice = Net.event("Notice")
		notice:FireClient(player, {
			kind = "warning",
			text = "Progress can't be saved right now — you can still play.",
		})
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CaseLogic</string>
          <string name="Source"><![CDATA[--[[
	CaseLogic — pure, engine-free rules for running a case.

	Everything that decides "was that right?", "what's the score?" and "what does
	the player own?" lives here, on the server. It has no Roblox dependencies so the
	test suite can run it with plain Luau (see tests/).

	The client only ever receives a *sanitized* copy of a case (no answers).
]]

local CaseLogic = {}

CaseLogic.SCORED = {
	choice = true,
	present = true,
	testimony = true,
	combine = true,
	order = true,
}

CaseLogic.STEP_TYPES = {
	scene = true,
	dialogue = true,
	interview = true,
	evidence_review = true,
	gain = true,
	choice = true,
	present = true,
	testimony = true,
	combine = true,
	order = true,
	verdict = true,
	complete = true,
}

-- Fields that must never reach the client.
local SECRET_KEYS = {
	correct = true,
	answer = true,
	answers = true,
	feedback = true,
	hints = true,
	wrongFeedback = true,
	positionFeedback = true,
	result = true,
}

-- Step points by attempt number (kept in sync with shared/Ranks.luau).
local STEP_POINTS = { 100, 60, 35 }
local STEP_FLOOR = 20

local function pointsForTries(tries: number): number
	return STEP_POINTS[tries] or STEP_FLOOR
end

local function gradeFor(percent: number): string
	if percent >= 95 then
		return "S"
	elseif percent >= 80 then
		return "A"
	elseif percent >= 60 then
		return "B"
	end
	return "C"
end

CaseLogic.pointsForTries = pointsForTries
CaseLogic.gradeFor = gradeFor

local function deepCopy(value: any, strip: boolean): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		if not (strip and SECRET_KEYS[k]) then
			out[k] = deepCopy(v, strip)
		end
	end
	return out
end

-- Public evidence definition (what the player can read about an item).
function CaseLogic.publicEvidence(case, id: string)
	local def = case.evidence[id]
	if not def then
		return nil
	end
	local copy = deepCopy(def, true)
	copy.id = id
	copy.hidden = nil
	return copy
end

-- Strip answer keys and hidden evidence so the case can be sent to a client.
function CaseLogic.sanitize(case)
	local out = {
		id = case.id,
		title = case.title,
		number = case.number,
		evidence = {},
		steps = {},
	}
	for id, def in case.evidence do
		if not def.hidden then
			out.evidence[id] = CaseLogic.publicEvidence(case, id)
		end
	end
	for i, step in case.steps do
		local copy = deepCopy(step, true)
		if step.type == "choice" then
			-- options keep their text only
			copy.options = {}
			for j, option in step.options do
				copy.options[j] = { text = option.text }
			end
		end
		out.steps[i] = copy
	end
	return out
end

function CaseLogic.newSession(case)
	return {
		caseId = case.id,
		step = 1,
		tries = {}, -- [stepId] = attempts used (including the correct one)
		cleared = {}, -- [stepId] = true
		inventory = {}, -- [evidenceId] = true
		finished = false,
	}
end

local function owns(session, id: any): boolean
	return type(id) == "string" and session.inventory[id] == true
end

local function matchesHint(hints, predicate): any
	if type(hints) ~= "table" then
		return nil
	end
	for _, hint in hints do
		if predicate(hint) then
			return hint
		end
	end
	return nil
end

-- Returns status ("correct" | "wrong" | "invalid"), feedback, noPenalty
function CaseLogic.check(case, session, step, answer): (string, string?, boolean?)
	local kind = step.type

	if kind == "choice" then
		if type(answer) ~= "number" or answer % 1 ~= 0 then
			return "invalid"
		end
		local option = step.options[answer]
		if not option then
			return "invalid"
		end
		if option.correct then
			return "correct", option.feedback
		end
		return "wrong", option.feedback or step.wrongFeedback, option.noPenalty
	elseif kind == "present" then
		if not owns(session, answer) then
			return "invalid"
		end
		local accepted = step.answer
		if accepted == answer or (type(accepted) == "table" and table.find(accepted, answer)) then
			return "correct"
		end
		local specific = type(step.feedback) == "table" and step.feedback[answer] or nil
		return "wrong", specific or step.wrongFeedback
	elseif kind == "testimony" then
		if type(answer) ~= "table" then
			return "invalid"
		end
		local statement, evidence = answer.statement, answer.evidence
		if type(statement) ~= "number" or not step.statements[statement] or not owns(session, evidence) then
			return "invalid"
		end
		for _, pair in step.answers do
			if pair.statement == statement and pair.evidence == evidence then
				return "correct"
			end
		end
		local hint = matchesHint(step.hints, function(h)
			return (h.statement == nil or h.statement == statement)
				and (h.evidence == nil or h.evidence == evidence)
		end)
		if hint then
			return "wrong", hint.feedback, hint.noPenalty
		end
		return "wrong", step.wrongFeedback
	elseif kind == "combine" then
		if type(answer) ~= "table" or #answer ~= 2 then
			return "invalid"
		end
		local a, b = answer[1], answer[2]
		if a == b or not owns(session, a) or not owns(session, b) then
			return "invalid"
		end
		local want = step.answer
		if (want[1] == a and want[2] == b) or (want[1] == b and want[2] == a) then
			return "correct"
		end
		local hint = matchesHint(step.hints, function(h)
			return table.find(h.pair, a) ~= nil and table.find(h.pair, b) ~= nil
		end)
		if hint then
			return "wrong", hint.feedback, hint.noPenalty
		end
		return "wrong", step.wrongFeedback
	elseif kind == "order" then
		if type(answer) ~= "table" or #answer ~= #step.answer then
			return "invalid"
		end
		local seen = {}
		for _, id in answer do
			if type(id) ~= "string" or seen[id] or not table.find(step.items, id) then
				return "invalid"
			end
			seen[id] = true
		end
		local firstWrong = nil
		for i, id in step.answer do
			if answer[i] ~= id then
				firstWrong = i
				break
			end
		end
		if not firstWrong then
			return "correct"
		end
		local specific = step.positionFeedback and step.positionFeedback[firstWrong]
		return "wrong", specific or step.wrongFeedback
	end

	return "invalid"
end

-- Items a step hands to the player when it is cleared.
function CaseLogic.grantsFor(step): { string }
	if step.type == "evidence_review" or step.type == "gain" then
		return step.items
	elseif step.type == "combine" then
		return { step.result }
	end
	return {}
end

function CaseLogic.computeResults(case, session)
	local maxScore, score, mistakes, perfect, scoredSteps = 0, 0, 0, 0, 0
	for _, step in case.steps do
		if CaseLogic.SCORED[step.type] then
			scoredSteps += 1
			maxScore += STEP_POINTS[1]
			local tries = session.tries[step.id] or 1
			score += pointsForTries(tries)
			mistakes += math.max(0, tries - 1)
			if tries == 1 then
				perfect += 1
			end
		end
	end
	local percent = if maxScore > 0 then math.floor(score / maxScore * 100 + 0.5) else 100
	return {
		caseId = case.id,
		score = score,
		maxScore = maxScore,
		percent = percent,
		grade = gradeFor(percent),
		mistakes = mistakes,
		perfectSteps = perfect,
		scoredSteps = scoredSteps,
	}
end

--[[
	Submit an answer (or an acknowledgement for unscored steps).
	Returns a result table safe to send to the client.
]]
function CaseLogic.submit(case, session, stepIndex: any, answer: any)
	if session.finished then
		return { ok = false, reason = "finished" }
	end
	if type(stepIndex) ~= "number" or stepIndex ~= session.step then
		return { ok = false, reason = "out_of_sync", step = session.step }
	end
	local step = case.steps[stepIndex]
	if not step then
		return { ok = false, reason = "no_step" }
	end

	if CaseLogic.SCORED[step.type] then
		local status, feedback, noPenalty = CaseLogic.check(case, session, step, answer)
		if status == "invalid" then
			return { ok = false, reason = "invalid" }
		end
		if status == "wrong" then
			if not noPenalty then
				session.tries[step.id] = (session.tries[step.id] or 1) + 1
			end
			return {
				ok = true,
				correct = false,
				feedback = feedback or "That doesn't hold up. Try another angle.",
				coach = step.coach or "mara",
				noPenalty = noPenalty == true,
			}
		end
		session.tries[step.id] = session.tries[step.id] or 1
		session.cleared[step.id] = true
	end

	local granted = {}
	for _, id in CaseLogic.grantsFor(step) do
		if not session.inventory[id] then
			session.inventory[id] = true
			table.insert(granted, CaseLogic.publicEvidence(case, id))
		end
	end

	session.step = stepIndex + 1
	local result = {
		ok = true,
		correct = true,
		next = session.step,
		granted = granted,
	}

	if CaseLogic.SCORED[step.type] then
		result.tries = session.tries[step.id]
		if step.type == "choice" then
			local option = step.options[answer]
			result.feedback = option and option.feedback
		end
	end

	if step.type == "complete" or session.step > #case.steps then
		session.finished = true
		result.finished = true
		result.results = CaseLogic.computeResults(case, session)
	end
	return result
end

-- Static validation of authored case data. Returns a list of problems.
function CaseLogic.validate(case): { string }
	local problems = {}
	local function problem(msg: string)
		table.insert(problems, (case.id or "?") .. ": " .. msg)
	end
	if type(case.evidence) ~= "table" or type(case.steps) ~= "table" then
		problem("missing evidence or steps")
		return problems
	end
	local ids = {}
	local owned = {}
	local last = case.steps[#case.steps]
	if not last or last.type ~= "complete" then
		problem("last step must be 'complete'")
	end
	for i, step in case.steps do
		local where = ("step %d (%s)"):format(i, tostring(step.id))
		if type(step.id) ~= "string" then
			problem(where .. " has no id")
		elseif ids[step.id] then
			problem(where .. " duplicate id")
		end
		ids[step.id or i] = true
		if not CaseLogic.STEP_TYPES[step.type] then
			problem(where .. " unknown type " .. tostring(step.type))
		end
		local function needsOwned(id, label)
			if not case.evidence[id] then
				problem(where .. " " .. label .. " references unknown evidence " .. tostring(id))
			elseif not owned[id] then
				problem(where .. " " .. label .. " uses evidence not yet owned: " .. tostring(id))
			end
		end
		if step.type == "choice" then
			local correct = 0
			for _, o in step.options do
				if o.correct then
					correct += 1
				end
				if type(o.text) ~= "string" then
					problem(where .. " option without text")
				end
				if
					not o.correct
					and type(o.feedback) ~= "string"
					and type(step.wrongFeedback) ~= "string"
				then
					problem(where .. " wrong option without feedback")
				end
			end
			if correct ~= 1 then
				problem(where .. " must have exactly one correct option")
			end
		elseif step.type == "present" then
			local list = type(step.answer) == "table" and step.answer or { step.answer }
			for _, id in list do
				needsOwned(id, "answer")
			end
		elseif step.type == "testimony" then
			if #step.answers == 0 then
				problem(where .. " has no answers")
			end
			for _, pair in step.answers do
				if not step.statements[pair.statement] then
					problem(where .. " answer references missing statement")
				end
				needsOwned(pair.evidence, "answer")
			end
		elseif step.type == "combine" then
			needsOwned(step.answer[1], "combine")
			needsOwned(step.answer[2], "combine")
			if not case.evidence[step.result] then
				problem(where .. " result is unknown evidence")
			end
		elseif step.type == "order" then
			if #step.answer ~= #step.items then
				problem(where .. " answer/items length mismatch")
			end
			for _, id in step.items do
				needsOwned(id, "order item")
			end
		elseif step.type == "evidence_review" or step.type == "gain" then
			for _, id in step.items do
				if not case.evidence[id] then
					problem(where .. " grants unknown evidence " .. tostring(id))
				end
			end
		elseif step.type == "dialogue" then
			if type(step.lines) ~= "table" or #step.lines == 0 then
				problem(where .. " has no lines")
			end
		end
		for _, id in CaseLogic.grantsFor(step) do
			owned[id] = true
		end
	end
	return problems
end

return CaseLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CaseService</string>
          <string name="Source"><![CDATA[--[[
	CaseService — the authority on cases.

	* Holds each player's live case session (step, tries, evidence owned).
	* Validates every answer on the server (CaseLogic) — the client is never trusted
	  with answers, scores, unlocks or saved progress.
	* Records best results and derives unlocks/promotion points from them.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Ranks = require(Shared.Ranks)
local CaseCatalog = require(Shared.CaseCatalog)

local CaseLogic = require(script.Parent.CaseLogic)
local DataService = require(script.Parent.DataService)
local LobbyService = require(script.Parent.LobbyService)

local CASES = {
	case1 = require(script.Parent.Cases.Case1),
	case2 = require(script.Parent.Cases.Case2),
	case3 = require(script.Parent.Cases.Case3),
}

local CaseService = {}

local sessions: { [Player]: any } = {}
local sanitizedCache: { [string]: any } = {}
local lastCall: { [Player]: { at: number, count: number } } = {}

local RATE_WINDOW = 1
local RATE_MAX = 10

local function rateLimited(player: Player): boolean
	local now = os.clock()
	local entry = lastCall[player]
	if not entry or now - entry.at > RATE_WINDOW then
		lastCall[player] = { at = now, count = 1 }
		return false
	end
	entry.count += 1
	return entry.count > RATE_MAX
end

local function isUnlocked(data, caseId: string): boolean
	local index = CaseCatalog.indexOf(caseId)
	if not index then
		return false
	end
	if index == 1 then
		return true
	end
	local previous = CaseCatalog.order[index - 1]
	return data.best[previous] ~= nil
end

local function totalPoints(data): number
	local total = 0
	for _, caseId in CaseCatalog.order do
		local best = data.best[caseId]
		if best then
			total += Ranks.GradePoints[best.grade] or 0
		end
	end
	return total + (data.bonus or 0)
end

local function summary(player: Player)
	local profile = DataService.get(player)
	local data = profile and profile.data or { best = {}, seen = {}, bonus = 0, streak = 0, wins = 0 }
	local cases = {}
	for _, caseId in CaseCatalog.order do
		cases[caseId] = {
			unlocked = isUnlocked(data, caseId),
			best = data.best[caseId],
		}
	end
	local points = totalPoints(data)
	local nextTitle, nextPoints = Ranks.nextTitle(points)
	return {
		saving = DataService.isSaving(player),
		points = points,
		title = Ranks.titleFor(points),
		nextTitle = nextTitle,
		nextPoints = nextPoints,
		streak = data.streak or 0,
		wins = data.wins or 0,
		cases = cases,
	}
end

CaseService.summary = summary

local function sanitized(caseId: string)
	local cached = sanitizedCache[caseId]
	if not cached then
		cached = CaseLogic.sanitize(CASES[caseId])
		sanitizedCache[caseId] = cached
	end
	return cached
end

local function onGetProfile(player: Player)
	DataService.waitFor(player)
	return summary(player)
end

local function onStartCase(player: Player, caseId: any)
	if rateLimited(player) then
		return { ok = false, reason = "busy" }
	end
	if type(caseId) ~= "string" or not CASES[caseId] then
		return { ok = false, reason = "unknown_case" }
	end
	local profile = DataService.waitFor(player)
	if not profile then
		return { ok = false, reason = "no_profile" }
	end
	if not isUnlocked(profile.data, caseId) then
		return { ok = false, reason = "locked" }
	end

	sessions[player] = CaseLogic.newSession(CASES[caseId])
	profile.data.plays += 1

	local seen = {}
	local prefix = caseId .. ":"
	for key in profile.data.seen do
		if string.sub(key, 1, #prefix) == prefix then
			table.insert(seen, string.sub(key, #prefix + 1))
		end
	end

	return {
		ok = true,
		case = sanitized(caseId),
		seen = seen,
		completedBefore = profile.data.best[caseId] ~= nil,
	}
end

local SEEN_TYPES = { dialogue = true, interview = true }

local function onSubmit(player: Player, caseId: any, stepIndex: any, answer: any)
	if rateLimited(player) then
		return { ok = false, reason = "busy" }
	end
	local session = sessions[player]
	if not session or session.caseId ~= caseId then
		return { ok = false, reason = "no_session" }
	end
	local case = CASES[session.caseId]
	local step = case.steps[stepIndex]

	local result = CaseLogic.submit(case, session, stepIndex, answer)
	if not result.ok then
		return result
	end

	local profile = DataService.get(player)
	if profile and step and result.correct and SEEN_TYPES[step.type] then
		local key = case.id .. ":" .. step.id
		if not profile.data.seen[key] then
			profile.data.seen[key] = true
			profile.dirty = true
		end
	end

	if result.finished then
		sessions[player] = nil
		local outcome = result.results
		local before = profile and summary(player) or nil
		local improved = false
		if profile then
			local best = profile.data.best[case.id]
			if not best or outcome.score > best.score then
				profile.data.best[case.id] = {
					score = outcome.score,
					maxScore = outcome.maxScore,
					grade = outcome.grade,
					percent = outcome.percent,
				}
				improved = true
				profile.dirty = true
			end
			-- Daily bonus: the first case won each day adds promotion points and extends the streak.
			local today = math.floor(os.time() / 86400)
			if profile.data.lastDaily ~= today then
				profile.data.streak = if profile.data.lastDaily == today - 1
					then profile.data.streak + 1
					else 1
				profile.data.lastDaily = today
				profile.data.bonus += Config.DailyBonusPoints
				outcome.dailyBonus = Config.DailyBonusPoints
			end
			profile.data.wins += 1
			profile.dirty = true
			outcome.streak = profile.data.streak
			task.spawn(DataService.save, player)
		end
		local after = summary(player)
		outcome.improved = improved
		outcome.pointsEarned = after.points - (before and before.points or 0)
		outcome.profile = after
		outcome.saved = after.saving

		-- Newly unlocked case, if any.
		local index = CaseCatalog.indexOf(case.id)
		local nextId = index and CaseCatalog.order[index + 1]
		if nextId and before and not before.cases[nextId].unlocked and after.cases[nextId].unlocked then
			outcome.unlocked = nextId
		end
		outcome.rankUp = before ~= nil and before.title ~= after.title and after.title or nil
		local okSocial, socialErr = pcall(LobbyService.onCaseWon, player, case.id, outcome, after)
		if not okSocial then
			warn("[FirstChair] Post-case social update failed:", socialErr)
		end
	end

	return result
end

local function onAbandon(player: Player)
	sessions[player] = nil
	return true
end

function CaseService.start()
	Net.fn("GetProfile").OnServerInvoke = onGetProfile
	Net.fn("StartCase").OnServerInvoke = onStartCase
	Net.fn("Submit").OnServerInvoke = onSubmit
	Net.fn("AbandonCase").OnServerInvoke = onAbandon

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		lastCall[player] = nil
	end)

	-- Catch authoring mistakes at server start (shows in the Output window).
	for id, case in CASES do
		for _, problem in CaseLogic.validate(case) do
			warn("[FirstChair] Case data problem in " .. id .. ": " .. problem)
		end
	end
end

return CaseService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Cases</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Case1</string>
            <string name="Source"><![CDATA[--[[
	CASE 1 — THE SIGNED LIE
	Server-only: contains answer keys. The client receives a sanitized copy.

	Line format: { speaker, text }   speaker = character id | "player" | "narrator"
]]

return {
	id = "case1",
	number = 1,
	title = "The Signed Lie",

	evidence = {
		contract = {
			name = "The Disputed Contract",
			kind = "document",
			summary = "Brightwell's five-year exclusive coffee supply agreement.",
			details = {
				"Signed: “J. Park”",
				"Dated: March 14 · 6:00 PM · at Park & Pour",
				"Penalty for breach: $180,000",
				"Clause 9: on breach, the café lease passes to Brightwell's “nominee”.",
			},
			keyDetail = "Losing wouldn't just cost June money — it would cost her the café.",
		},
		footage = {
			name = "Café Security Footage",
			kind = "photo",
			summary = "Park & Pour front camera · Thursday, March 14.",
			details = {
				"5:10 PM — June locks the till and leaves.",
				"5:30 PM — Staff flip the sign to CLOSED. (Thursdays close early.)",
				"6:00 PM — The café is empty. Lights dimmed.",
				"8:02 PM — June returns for her laptop.",
			},
			keyDetail = "At 6:00 PM June was gone — and the café was closed and empty.",
		},
		metadata = {
			name = "Contract File Data",
			kind = "data",
			summary = "The hidden properties of Brightwell's contract PDF.",
			details = {
				"File: Brightwell_Exclusive_Supply.pdf",
				"Date printed on page: March 14, 6:00 PM",
				"File created: March 19, 11:47 PM",
				"Created by: BW-ADMIN",
			},
			keyDetail = "The file was created five days AFTER it was supposedly signed.",
		},
		statement = {
			name = "Nadia Price's Statement",
			kind = "statement",
			summary = "Written statement from Brightwell's sales lead.",
			details = {
				"“I met Ms. Park at her café on March 14.”",
				"“At six o'clock she signed the agreement at the counter.”",
				"“The café was busy. She was serving customers as she signed.”",
			},
			keyDetail = "Nadia claims the café was busy at 6:00 PM.",
		},
	},

	steps = {
		{
			id = "arrive",
			type = "scene",
			location = "office",
			shot = "office_entrance",
			cast = { office_theo = "theo" },
			player = "office_entry",
			title = "Monday · 9:02 AM",
			objective = "Check in at reception",
		},
		{
			id = "welcome",
			type = "dialogue",
			lines = {
				{ "theo", "Good morning. You must be the new associate." },
				{
					"theo",
					"Welcome to Valence Legal. Forty years, nine hundred cases, and a coffee machine that costs more than your car.",
				},
				{ "player", "Good to know where the money goes." },
				{
					"theo",
					"Mara Quinn is expecting you in Conference Room B. Her words: “now-ish.” Her tone: “now.”",
				},
			},
		},
		{
			id = "meeting",
			type = "scene",
			location = "office",
			shot = "office_meeting_wide",
			cast = { office_meeting_head = "mara", office_meeting_guest = "june" },
			player = "office_meeting_player",
			title = "Conference Room B",
			objective = "Meet your mentor",
		},
		{
			id = "mara_intro",
			type = "dialogue",
			lines = {
				{
					"mara",
					"You're the one who aced the bar and still showed up early. Promising. Or nervous.",
				},
				{ "player", "Both, probably." },
				{ "mara", "Honest. Don't make a habit of it in court." },
				{ "mara", "First day, first case. Try not to embarrass us." },
				{
					"mara",
					"This is June Park. She runs Park & Pour on Harbor Street. Best espresso in Northbridge — and, apparently, a lawsuit.",
				},
				{ "june", "A hundred and eighty thousand dollars. For a contract I've never seen." },
			},
		},
		{
			id = "case_file",
			type = "gain",
			items = { "contract" },
		},
		{
			id = "brief",
			type = "dialogue",
			lines = {
				{
					"mara",
					"Brightwell Provisions — her old bean supplier — says June signed a five-year exclusive deal on March fourteenth. Six PM, at her café.",
				},
				{ "mara", "Then she bought beans elsewhere. Breach. Penalty. Very tidy." },
				{ "mara", "Too tidy. Talk to her. Find out what actually happened that night." },
			},
		},
		{
			id = "interview_june",
			type = "interview",
			with = "june",
			prompt = "Ask June about…",
			objective = "Speak with your client",
			topics = {
				{
					label = "That evening",
					lines = {
						{
							"june",
							"March fourteenth was a Thursday. We close early on Thursdays — five-thirty.",
						},
						{
							"june",
							"I left at ten past five. My sister opened a restaurant across town. I was there until eight.",
						},
					},
				},
				{
					label = "The signature",
					lines = {
						{ "june", "It looks like mine. That's what scares me." },
						{
							"june",
							"I signed one invoice for Brightwell last year. My signature's been sitting on their desk ever since.",
						},
					},
				},
				{
					label = "Brightwell",
					lines = {
						{
							"june",
							"We worked together for two years. Then their prices jumped forty percent, so I switched roasters.",
						},
						{ "june", "Two weeks later, this contract appears. Signed. By me. Apparently." },
					},
				},
				{
					label = "Clause 9",
					lines = {
						{
							"june",
							"If I lose, I don't just pay. My café lease goes to someone Brightwell “nominates.”",
						},
						{ "player", "Who wants a café lease that badly?" },
						{ "june", "That's what I keep asking." },
					},
				},
			},
		},
		{
			id = "evidence_brief",
			type = "dialogue",
			objective = "Inspect all the evidence",
			lines = {
				{
					"mara",
					"Good. Now the evidence. Three items. Read them properly — details are where cases are won.",
				},
			},
		},
		{
			id = "review",
			type = "evidence_review",
			prompt = "Tap each item to inspect it.",
			items = { "footage", "metadata", "statement" },
		},
		{
			id = "contradiction",
			type = "choice",
			speaker = "mara",
			objective = "Find the key contradiction",
			prompt = "So. What's really wrong with Brightwell's story?",
			options = {
				{
					text = "The contract file was created five days after it was “signed.”",
					correct = true,
					feedback = "Exactly. You can't sign a document that doesn't exist yet.",
				},
				{
					text = "June's signature looks slightly different.",
					feedback = "It looks identical. That's the problem — someone had a very good copy.",
				},
				{
					text = "Brightwell raised their prices.",
					feedback = "Rude, but not illegal. Focus on what proves the contract is fake.",
				},
				{
					text = "The café cameras are low quality.",
					feedback = "The footage is fine. It's actually on our side.",
				},
			},
		},
		{
			id = "plan",
			type = "dialogue",
			lines = {
				{ "mara", "A contract born on March nineteenth, wearing a March fourteenth date. Lovely." },
				{
					"mara",
					"Brightwell's lawyer is Adrian Voss. Expensive suits, cheap tricks. He'll lead with his witness.",
				},
				{ "mara", "So: break the witness, then break the document. In that order." },
				{ "june", "Is that… good?" },
				{ "mara", "It's a plan. Good comes later." },
			},
		},
		{
			id = "court",
			type = "scene",
			location = "court",
			shot = "court_wide",
			cast = {
				court_judge = "rowan",
				court_plaintiff_counsel = "voss",
				court_plaintiff_party = "kerrigan",
				court_defense_second = "mara",
				court_defense_client = "june",
			},
			player = "court_defense_player",
			title = "Tuesday · 10:00 AM",
			objective = "Court is in session",
		},
		{
			id = "court_open",
			type = "dialogue",
			lines = {
				{ "rowan", "Brightwell Provisions versus Park. Let's keep this efficient. Mr. Voss?" },
				{
					"voss",
					"Your Honor, this is simple. Ms. Park signed an exclusive agreement, then ignored it. We have the contract. We have an eyewitness.",
				},
				{ "voss", "The defense has… a new associate. Welcome. I'll try to speak slowly." },
				{ "mara", "(He does this. Smile. Let him underestimate you.)" },
				{ "rowan", "Call your witness, Mr. Voss." },
			},
		},
		{
			id = "witness",
			type = "scene",
			location = "court",
			shot = "court_well",
			cast = {
				court_judge = "rowan",
				court_witness = "nadia",
				court_plaintiff_counsel = "voss",
				court_plaintiff_party = "kerrigan",
				court_defense_second = "mara",
				court_defense_client = "june",
			},
			player = "court_defense_player",
			objective = "Hear the witness",
		},
		{
			id = "nadia_intro",
			type = "dialogue",
			lines = {
				{
					"voss",
					"Ms. Price, you lead sales at Brightwell. Tell the court what you saw on March fourteenth.",
				},
				{ "nadia", "Gladly. I was there. I watched her sign it." },
				{
					"rowan",
					"Defense, your cross-examination. Press a statement for more detail, or present evidence when something doesn't add up.",
				},
			},
		},
		{
			id = "cross",
			type = "testimony",
			witness = "nadia",
			title = "Testimony — Nadia Price",
			objective = "Find the statement your evidence contradicts",
			statements = {
				{
					text = "I met Ms. Park at Park & Pour on Thursday, March fourteenth.",
					press = {
						{ "player", "What time did you arrive?" },
						{ "nadia", "Just before six. I came straight from the office." },
					},
				},
				{
					text = "She signed the agreement at six o'clock sharp. I watched her do it.",
					press = {
						{ "player", "You're certain about the time?" },
						{ "nadia", "Completely. I checked my watch. Six on the dot." },
					},
				},
				{
					text = "The café was busy — she signed at the counter between customers.",
					press = {
						{ "player", "Busy how?" },
						{ "nadia", "Packed. A queue to the door. She was making lattes while she signed." },
						{ "mara", "(Lattes. At a café that closes at five-thirty on Thursdays.)" },
					},
				},
				{
					text = "I brought the printed contract with me that evening.",
					press = {
						{ "player", "Printed from where?" },
						{ "nadia", "Our office system. Standard paperwork." },
						{ "mara", "(Remember that. “Our office system.”)" },
					},
				},
			},
			answers = {
				{ statement = 3, evidence = "footage" },
				{ statement = 2, evidence = "footage" },
			},
			hints = {
				{
					statement = 4,
					evidence = "metadata",
					noPenalty = true,
					feedback = "Sharp — that's the big one. Save it for Voss. First, break her eyewitness story.",
				},
				{
					evidence = "contract",
					feedback = "Showing her own side's contract won't rattle her. Show her something that contradicts what she saw.",
				},
				{
					statement = 1,
					feedback = "That part's harmless. Look for a claim the café cameras flatly destroy.",
				},
			},
			wrongFeedback = "That doesn't contradict her. Which statement clashes with what the cameras recorded?",
		},
		{
			id = "cross_win",
			type = "dialogue",
			lines = {
				{
					"player",
					"Ms. Price, the café's own cameras show the doors locked at five-thirty. At six o'clock the café was empty.",
				},
				{ "player", "And my client left at ten past five. She didn't come back until eight." },
				{ "nadia", "I… it may have been a different evening." },
				{ "rowan", "A different evening from the one printed on the contract, Ms. Price?" },
				{
					"voss",
					"Your Honor, my witness confused a detail. It changes nothing. The contract bears Ms. Park's signature. The document speaks for itself.",
				},
			},
		},
		{
			id = "present_doc",
			type = "present",
			speaker = "rowan",
			objective = "Present your strongest evidence",
			prompt = "Voss says the document “speaks for itself.” What proves it can't be trusted?",
			answer = "metadata",
			feedback = {
				footage = "The footage already broke the witness. Voss is hiding behind the document now — attack the document.",
				statement = "Her statement is in pieces. Go after the contract itself.",
				contract = "That's his evidence. You want the thing that exposes it.",
			},
			wrongFeedback = "That doesn't touch the contract. What proves the document itself is wrong?",
		},
		{
			id = "present_win",
			type = "dialogue",
			lines = {
				{
					"player",
					"Then let it speak. Brightwell's own contract file was created on March nineteenth, at 11:47 PM.",
				},
				{
					"player",
					"Five days after Ms. Park supposedly signed it. Nobody signs a document that doesn't exist yet.",
				},
				{ "rowan", "Mr. Voss?" },
				{ "voss", "…Computers make errors, Your Honor." },
				{ "rowan", "So do witnesses, it seems. Defense — your closing." },
			},
		},
		{
			id = "closing_1",
			type = "choice",
			speaker = "rowan",
			objective = "Deliver your closing argument",
			prompt = "Open your closing. What's the heart of your case?",
			options = {
				{
					text = "This contract could not have existed when it was “signed.”",
					correct = true,
					feedback = "Clean. Devastating. Keep going.",
				},
				{
					text = "Ms. Park is an honest small-business owner.",
					feedback = "True, and irrelevant. Juries like character. Judges like facts.",
				},
				{
					text = "Brightwell's prices were unfair.",
					feedback = "Unfair prices aren't a defense. Stick to the impossible contract.",
				},
			},
		},
		{
			id = "closing_2",
			type = "choice",
			speaker = "voss",
			prompt = "Voss cuts in: “Metadata can glitch!” How do you answer?",
			options = {
				{
					text = "Then explain why your eyewitness is wrong too. Two separate facts, one conclusion.",
					correct = true,
					feedback = "Independent evidence pointing the same way. That's how you close a door.",
				},
				{
					text = "Computers never make mistakes.",
					feedback = "They do, and the judge knows it. Never overclaim.",
				},
				{
					text = "Ask the judge for a short recess.",
					feedback = "Retreating now gives him room. Answer the point.",
				},
			},
		},
		{
			id = "closing_3",
			type = "choice",
			speaker = "rowan",
			prompt = "What do you ask the court to do?",
			options = {
				{
					text = "Dismiss the claim. The contract is unreliable.",
					correct = true,
					feedback = "That's the ask. Simple and complete.",
				},
				{
					text = "Reduce the penalty to something fair.",
					feedback = "That admits the contract is real. Don't concede what you just disproved.",
				},
				{
					text = "Have everyone at Brightwell arrested.",
					feedback = "This is a civil court. Ambitious, though.",
				},
			},
		},
		{
			id = "ruling",
			type = "dialogue",
			lines = {
				{
					"rowan",
					"The court has heard enough. The contract's timeline is impossible, and the witness is contradicted by the café's own footage.",
				},
				{ "rowan", "Brightwell's claim is dismissed. Ms. Park — go and enjoy your café." },
			},
		},
		{
			id = "verdict",
			type = "verdict",
			title = "CLAIM DISMISSED",
			subtitle = "Brightwell Provisions v. Park — judgment for the defense",
		},
		{
			id = "debrief",
			type = "scene",
			location = "office",
			shot = "office_meeting_wide",
			cast = { office_meeting_head = "mara", office_meeting_guest = "june" },
			player = "office_meeting_player",
			title = "Tuesday · 6:40 PM",
			objective = "Debrief with Mara",
		},
		{
			id = "epilogue",
			type = "dialogue",
			lines = {
				{ "june", "I don't know how to thank you. Free coffee. Forever. Within reason." },
				{ "player", "Define “reason.”" },
				{ "june", "Two a day." },
				{ "mara", "Not bad for a first day. You didn't embarrass us." },
				{
					"mara",
					"One thing bothers me. Brightwell can't afford Adrian Voss for a café dispute. So I checked who paid his retainer.",
				},
				{ "player", "And?" },
				{ "mara", "A company called Crestline Group. No website. No office. Just money." },
				{
					"mara",
					"And Clause 9 would have handed June's lease to a “nominee.” Guess whose name was pencilled in.",
				},
				{ "player", "Crestline." },
				{ "mara", "Go home. Sleep. Something tells me we'll be seeing them again." },
			},
		},
		{
			id = "complete",
			type = "complete",
		},
	},
}
]]></string>
          </Properties>
